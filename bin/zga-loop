#!/usr/bin/env bash
# zga-loop - Run zloop in GitHub Actions with commit-push cycles
#
# Usage:
#   bin/zga-loop [max-iterations]
#
# This wrapper handles the GA-specific concerns:
# - Pulls latest before each iteration
# - Pushes after successful commits
# - Handles conflicts gracefully
#
# Requires: ANTHROPIC_API_KEY in environment
#
# Environment:
#   ZLOOP_BUDGET=300    Seconds of work an iteration is told it has, via
#                       bin/zprompt (same paragraph bin/zloop sends)
#   ZLOOP_INTERVAL=2    Seconds between iterations (rate-limit breathing room)
#   ZLOOP_TIMEOUT=      Hard kill per iteration (default: 2x the budget), the
#                       same guillotine bin/zloop applies. Before this the
#                       only bound was the workflow's timeout-minutes, which
#                       kills the whole job, not the iteration.
#   ZLOOP_MAX_TIMEOUTS=3  Consecutive hard kills that abort the run (exit 3;
#                       0 = never). See bin/zloop --help (Time).
#   ZLOOP_MAX_SEAL_FAILURES=3  Consecutive bin/zblind seal failures that abort
#                       the run (exit 4; 0 = never). A run that seals nothing
#                       has no provenance record, which a per-iteration
#                       "continuing" warning hides. A seal skipped for a
#                       missing ZOCIETY_BLIND_KEY exits 0 and never counts.
#   ZLOOP_STOP=action   Stop modes passed to bin/zloop-complete (no --stop flag
#                       here; set it in the workflow env). See bin/zloop --help.
#   ZSTOP_*             Per-mode knobs; see bin/zstop-<mode> --help
#   ZOCIETY_BLIND_KEY   Passphrase for bin/zblind (workflow secret). After
#                       every iteration the commits it made are sealed with
#                       the model as runner "github-actions", and every
#                       [heap-death] among them is revealed. Unset: only the
#                       plaintext refs/notes/agent marker is written.
#
# Orientation: bin/zprompt is regenerated before every iteration (same as
# bin/zloop), not once per run. Its context block is the state after the
# previous iteration's commits and its push; a prompt built once hands a late
# iteration a stale world and the agent pays to re-derive it.

set -euo pipefail

MAX_ITERATIONS="${1:-30}"
MODEL="${2:-claude-haiku-4-5-20251001}"
STOP_MODES="${ZLOOP_STOP:-action}"
BUDGET_SECS="${ZLOOP_BUDGET:-300}"
INTERVAL_SECS="${ZLOOP_INTERVAL:-2}"
TIMEOUT_SECS="${ZLOOP_TIMEOUT:-}"
MAX_TIMEOUTS="${ZLOOP_MAX_TIMEOUTS:-3}"
MAX_SEAL_FAILURES="${ZLOOP_MAX_SEAL_FAILURES:-3}"
ITERATION=0
TIMEOUTS=0
SEAL_FAILURES=0
for v in BUDGET_SECS INTERVAL_SECS MAX_TIMEOUTS MAX_SEAL_FAILURES; do
    [[ "${!v}" =~ ^[0-9]+$ ]] || { echo "zga-loop: $v expects a non-negative integer, got '${!v}'" >&2; exit 2; }
done
# Same rule as bin/zloop: the guillotine must sit above the budget, else every
# iteration dies mid-work. An inherited value at or below it is corrected with
# a note rather than failing the job.
if [[ -n "$TIMEOUT_SECS" ]]; then
    [[ "$TIMEOUT_SECS" =~ ^[0-9]+$ ]] || { echo "zga-loop: ZLOOP_TIMEOUT expects a non-negative integer, got '$TIMEOUT_SECS'" >&2; exit 2; }
    if [[ "$TIMEOUT_SECS" -le "$BUDGET_SECS" ]]; then
        echo "ZLOOP_TIMEOUT=${TIMEOUT_SECS}s is not above the ${BUDGET_SECS}s budget; using $((BUDGET_SECS * 2))s (ZLOOP_TIMEOUT is the hard kill, ZLOOP_BUDGET the working time)"
        TIMEOUT_SECS=$((BUDGET_SECS * 2))
    fi
else
    TIMEOUT_SECS=$((BUDGET_SECS * 2))
fi
TIMEOUT_CMD=()
if command -v timeout &>/dev/null; then
    TIMEOUT_CMD=(timeout "$TIMEOUT_SECS")
else
    echo "Warning: no timeout(1) on PATH; iterations run unbounded"
fi
# Shared with bin/zloop (see bin/zprompt): the agent is told its budget here
# too. CI iterations that do not know their time limit fail the same way local
# ones did -- killed mid-work by the job timeout with nothing committed.
# Checked once here so a broken bin/zprompt fails the job immediately; the
# prompt the agent receives is regenerated per iteration (see Orientation).
bin/zprompt --budget "$BUDGET_SECS" >/dev/null

echo "=== Zociety GA Loop ==="
echo "Max iterations: $MAX_ITERATIONS"
echo "Model: $MODEL"
echo "Budget per iteration: ${BUDGET_SECS}s (told to the agent)"
echo "Interval between iterations: ${INTERVAL_SECS}s"
echo "Hard kill: ${TIMEOUT_SECS}s"
echo "Stop modes: $STOP_MODES"
echo ""

# Ensure we have latest
git pull --rebase || git pull --ff-only || true

# Same as bin/zloop: captured once, rewritten into zloop.state every iteration.
# Taken after the pull so start..HEAD holds only this run's commits; otherwise
# heap-deaths the pull brought in would count toward ZSTOP_BUDGET.
START_SHA=$(git rev-parse HEAD)
echo "Start: $START_SHA"

while true; do
    ITERATION=$((ITERATION + 1))

    # Write state for zheap-death to read
    mkdir -p .zociety .claude
    cat > .zociety/zloop.state << EOF
iteration: $ITERATION
max: $MAX_ITERATIONS
start: $START_SHA
mode: $STOP_MODES
EOF
    cp .zociety/zloop.state .claude/zloop.state 2>/dev/null || true

    # Check completion BEFORE each iteration. Dispatcher exit codes as in
    # bin/zloop: 0 stop, 2 abort (bad mode or predicate error), else continue.
    stop_status=0
    bin/zloop-complete "$STOP_MODES" || stop_status=$?
    if [[ $stop_status -eq 0 ]]; then
        echo ""
        echo "=== Loop Complete ==="
        echo "Iterations: $ITERATION"
        bin/zstate | jq '{action, phase, genesis}'
        rm -f .zociety/zloop.state .claude/zloop.state

        # Final push
        git push origin HEAD || echo "Warning: final push failed"
        exit 0
    elif [[ $stop_status -eq 2 ]]; then
        echo ""
        echo "=== Loop Aborted ==="
        echo "zloop-complete exited 2 (modes: $STOP_MODES); see message above"
        rm -f .zociety/zloop.state .claude/zloop.state
        exit 2
    fi

    # Check iteration limit
    if [[ $ITERATION -gt $MAX_ITERATIONS ]]; then
        echo ""
        echo "=== Max Iterations Reached ==="
        echo "Stopped after $MAX_ITERATIONS iterations"
        bin/zstate | jq '{action, phase, genesis}'

        # Push whatever we have (with retry)
        if ! git push origin HEAD 2>/dev/null; then
            echo "Push failed, trying pull-rebase-push..."
            if ! { git pull --rebase && git push origin HEAD; }; then
                echo "Warning: final push failed after rebase"
                exit 1
            fi
        fi
        exit 0  # Success if we made progress, even without completing
    fi

    echo ""
    echo "=== Iteration $ITERATION/$MAX_ITERATIONS ==="
    bin/zstate | jq -c '{action, phase}'
    echo ""

    # Orientation for this turn, regenerated now so the context block reflects
    # the previous iteration's commits. See Orientation in the header.
    PROMPT=$(bin/zprompt --budget "$BUDGET_SECS")

    # Construct agent arguments
    AGENT_ARGS=()
    if [[ -n "${ZOCIETY_AGENT_CLIENT:-}" ]]; then
      AGENT_ARGS+=("--client" "$ZOCIETY_AGENT_CLIENT")
    fi
    if [[ -n "$MODEL" ]]; then
      AGENT_ARGS+=("--model" "$MODEL")
    fi
    AGENT_ARGS+=("$PROMPT")

    # Run one agent iteration under the hard kill. As in bin/zloop, a kill
    # (124) is a warning with a streak, not a normal turn, and MAX_TIMEOUTS in
    # a row abort the run: an iteration that never finishes cannot contribute.
    PREV_HEAD=$(git rev-parse HEAD)
    exit_code=0
    ${TIMEOUT_CMD[@]+"${TIMEOUT_CMD[@]}"} bin/zagent "${AGENT_ARGS[@]}" 2>&1 || exit_code=$?
    if [[ $exit_code -eq 0 ]]; then
        TIMEOUTS=0
        # Push after successful iteration (if there are changes)
        if ! git diff --quiet HEAD 2>/dev/null; then
            echo ""
            echo "Pushing changes..."
            if ! git push origin HEAD; then
                echo "Push failed, trying pull-rebase-push..."
                if ! { git pull --rebase && git push origin HEAD; }; then
                    echo "Warning: push failed, continuing..."
                fi
            fi
        fi
    elif [[ $exit_code -eq 124 ]]; then
        TIMEOUTS=$((TIMEOUTS + 1))
        echo "WARNING: iteration $ITERATION hard-killed at ${TIMEOUT_SECS}s ($TIMEOUTS consecutive); uncommitted work is lost"
        if [[ $MAX_TIMEOUTS -gt 0 && $TIMEOUTS -ge $MAX_TIMEOUTS ]]; then
            echo ""
            echo "=== Loop Aborted ==="
            echo "$TIMEOUTS consecutive hard kills at ${TIMEOUT_SECS}s with a ${BUDGET_SECS}s budget; raise ZLOOP_BUDGET or shrink the work per turn"
            rm -f .zociety/zloop.state .claude/zloop.state
            git push origin HEAD || echo "Warning: final push failed"
            exit 3
        fi
    else
        echo "Warning: Agent iteration failed (exit $exit_code), continuing..."
    fi

    # Blind model record (same as bin/zloop, runner github-actions): seal the
    # commits this iteration made, reveal for every heap-death among them.
    # Runs after the push above; bin/zblind pushes the notes refs itself.
    CUR_HEAD=$(git rev-parse HEAD)
    # As in bin/zloop: a skipped seal (no ZOCIETY_BLIND_KEY) exits 0 and is not
    # a failure; MAX_SEAL_FAILURES real failures in a row abort the run, since
    # a job that seals nothing leaves the cycle with no provenance to reveal.
    if bin/zblind seal "$PREV_HEAD" "$CUR_HEAD" "$MODEL" "${ZOCIETY_AGENT_CLIENT:-claude}" github-actions; then
        SEAL_FAILURES=0
    else
        SEAL_FAILURES=$((SEAL_FAILURES + 1))
        echo "WARNING: zblind seal failed for ${PREV_HEAD:0:7}..${CUR_HEAD:0:7} ($SEAL_FAILURES consecutive); those commits carry no provenance note"
        if [[ $MAX_SEAL_FAILURES -gt 0 && $SEAL_FAILURES -ge $MAX_SEAL_FAILURES ]]; then
            echo ""
            echo "=== Loop Aborted ==="
            echo "$SEAL_FAILURES consecutive zblind seal failures; the run has no provenance record at all. Fix bin/zblind or set ZLOOP_MAX_SEAL_FAILURES=0 to accept an unsealed run"
            rm -f .zociety/zloop.state .claude/zloop.state
            git push origin HEAD || echo "Warning: final push failed"
            exit 4
        fi
    fi
    for death_sha in $(git rev-list --grep='^\[heap-death\]' "${PREV_HEAD}..${CUR_HEAD}"); do
        bin/zblind reveal "$death_sha" \
            || echo "Warning: zblind reveal failed for ${death_sha:0:7}, continuing..."
    done

    # Small delay to avoid rate limits (cadence, as bin/zloop --interval)
    sleep "$INTERVAL_SECS"
done
