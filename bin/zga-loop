#!/usr/bin/env bash
# zga-loop - Run zloop in GitHub Actions with commit-push cycles
#
# Usage:
#   bin/zga-loop [max-iterations]
#
# This wrapper handles the GA-specific concerns:
# - Pulls latest before each iteration
# - Pushes after successful commits
# - Handles conflicts gracefully
#
# Requires: ANTHROPIC_API_KEY in environment
#
# Environment:
#   ZLOOP_STOP=action   Stop modes passed to bin/zloop-complete (no --stop flag
#                       here; set it in the workflow env). See bin/zloop --help.
#   ZSTOP_*             Per-mode knobs; see bin/zstop-<mode> --help

set -euo pipefail

MAX_ITERATIONS="${1:-30}"
MODEL="${2:-claude-haiku-4-5-20251001}"
STOP_MODES="${ZLOOP_STOP:-action}"
ITERATION=0
PROMPT="Read PROMPT.md and follow its instructions."

echo "=== Zociety GA Loop ==="
echo "Max iterations: $MAX_ITERATIONS"
echo "Model: $MODEL"
echo "Stop modes: $STOP_MODES"
echo ""

# Ensure we have latest
git pull --rebase || git pull --ff-only || true

# Same as bin/zloop: captured once, rewritten into zloop.state every iteration.
# Taken after the pull so start..HEAD holds only this run's commits; otherwise
# heap-deaths the pull brought in would count toward ZSTOP_BUDGET.
START_SHA=$(git rev-parse HEAD)
echo "Start: $START_SHA"

while true; do
    ITERATION=$((ITERATION + 1))

    # Write state for zheap-death to read
    mkdir -p .zociety .claude
    cat > .zociety/zloop.state << EOF
iteration: $ITERATION
max: $MAX_ITERATIONS
start: $START_SHA
mode: $STOP_MODES
runner: github-actions
EOF
    cp .zociety/zloop.state .claude/zloop.state 2>/dev/null || true

    # Check completion BEFORE each iteration. Dispatcher exit codes as in
    # bin/zloop: 0 stop, 2 abort (bad mode or predicate error), else continue.
    stop_status=0
    bin/zloop-complete "$STOP_MODES" || stop_status=$?
    if [[ $stop_status -eq 0 ]]; then
        echo ""
        echo "=== Loop Complete ==="
        echo "Iterations: $ITERATION"
        bin/zstate | jq '{action, phase, genesis}'
        rm -f .zociety/zloop.state .claude/zloop.state

        # Final push
        git push origin HEAD || echo "Warning: final push failed"
        exit 0
    elif [[ $stop_status -eq 2 ]]; then
        echo ""
        echo "=== Loop Aborted ==="
        echo "zloop-complete exited 2 (modes: $STOP_MODES); see message above"
        rm -f .zociety/zloop.state .claude/zloop.state
        exit 2
    fi

    # Check iteration limit
    if [[ $ITERATION -gt $MAX_ITERATIONS ]]; then
        echo ""
        echo "=== Max Iterations Reached ==="
        echo "Stopped after $MAX_ITERATIONS iterations"
        bin/zstate | jq '{action, phase, genesis}'

        # Push whatever we have (with retry)
        if ! git push origin HEAD 2>/dev/null; then
            echo "Push failed, trying pull-rebase-push..."
            git pull --rebase && git push origin HEAD || {
                echo "Warning: final push failed after rebase"
                exit 1
            }
        fi
        exit 0  # Success if we made progress, even without completing
    fi

    echo ""
    echo "=== Iteration $ITERATION/$MAX_ITERATIONS ==="
    bin/zstate | jq -c '{action, phase}'
    echo ""

    # Construct agent arguments
    AGENT_ARGS=()
    if [[ -n "${ZOCIETY_AGENT_CLIENT:-}" ]]; then
      AGENT_ARGS+=("--client" "$ZOCIETY_AGENT_CLIENT")
    fi
    if [[ -n "$MODEL" ]]; then
      AGENT_ARGS+=("--model" "$MODEL")
    fi
    AGENT_ARGS+=("$PROMPT")

    # Run one agent iteration
    if bin/zagent "${AGENT_ARGS[@]}" 2>&1; then
        # Push after successful iteration (if there are changes)
        if ! git diff --quiet HEAD 2>/dev/null; then
            echo ""
            echo "Pushing changes..."
            git push origin HEAD || {
                echo "Push failed, trying pull-rebase-push..."
                git pull --rebase && git push origin HEAD
            } || echo "Warning: push failed, continuing..."
        fi
    else
        echo "Warning: Agent iteration failed, continuing..."
    fi

    # Small delay to avoid rate limits
    sleep 2
done
