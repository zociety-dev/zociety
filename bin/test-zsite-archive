#!/bin/bash
# test-zsite-archive: Prove the site archive (docs/archive.html and
# docs/archive/<tag>.html) is a pure function of the rev* tags
#
# Usage:
#   bin/test-zsite-archive [--keep]
#   bin/test-zsite-archive -h | --help
#
# Options:
#   --keep    Leave the throwaway copy behind (path printed) for inspection
#
# Copies this repo (working tree and .git) under mktemp and runs
# bin/zsite-generate there with the provenance demo switched off
# (NFPROV_BLAME_JSON_FILE pointed at a missing file), so nothing here
# touches the real docs/ and no event is committed. Cases:
#   1. every rev* tag whose tree holds stuff/*.md gets one page, listed on
#      archive.html, and no other tag does
#   2. the newest such tag's page holds one artifact per stuff/*.md in the
#      tag, each with the file's first h1 as its title
#   3. deleting stuff/ from the working tree changes no archive byte
#   4. running the generator twice changes no archive byte
#   5. deleting the newest tag removes its page and its index entry
#   6. a synthetic repo with 120 rev* tags (four stuff/*.md each, one of
#      them empty, one without an h1) generates within SCALE_BUDGET_SECONDS
#      and gets every page, artifact, title and escape right: the generator
#      gathers the archive in a fixed number of git calls, and this case
#      catches a slide back to per-tag or per-artifact subprocesses

set -e

REPO="$(cd "$(dirname "$0")/.." && pwd)"
KEEP=0

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --keep) KEEP=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

PASS=0
FAIL=0
ok()   { PASS=$((PASS + 1)); echo "  ✓ $*"; }
fail() { FAIL=$((FAIL + 1)); echo "  ✗ $*" >&2; }
check() { # check <description> <command...>
  local desc="$1"; shift
  if "$@" >/dev/null 2>&1; then ok "$desc"; else fail "$desc"; fi
}

TMP=$(mktemp -d "${TMPDIR:-/tmp}/zsite-archive.XXXXXX")
cleanup() {
  if [[ $KEEP -eq 1 ]]; then
    echo "kept: $TMP"
  else
    rm -rf "$TMP"
  fi
}
trap cleanup EXIT

echo "Copying repo to $TMP/repo..."
cp -R "$REPO" "$TMP/repo"
cd "$TMP/repo"

# The generator is silent about the archive only when nothing changes; keep
# its own chatter out of the way and fail loudly on a non-zero exit.
generate() {
  NFPROV_BLAME_JSON_FILE="$TMP/no-such-blame.json" bin/zsite-generate >"$TMP/generate.log" 2>&1 \
    || { echo "bin/zsite-generate failed:" >&2; tail -20 "$TMP/generate.log" >&2; exit 1; }
}

# Tags with top-level stuff/*.md, version order; the newest is the subject
# of the content checks.
tags_with_stuff() {
  local t
  for t in $(git tag | grep '^rev' | sort -V); do
    if git ls-tree --name-only "$t" stuff/ 2>/dev/null | grep -q '\.md$'; then
      echo "$t"
    fi
  done
}
EXPECTED_TAGS=$(tags_with_stuff)
EXPECTED_COUNT=$(printf '%s\n' "$EXPECTED_TAGS" | grep -c . || true)
NEWEST=$(printf '%s\n' "$EXPECTED_TAGS" | tail -1)
if [[ "$EXPECTED_COUNT" -eq 0 ]]; then
  echo "no rev* tag holds stuff/*.md; nothing to test" >&2
  exit 2
fi

echo "Case 1: one page per tag with stuff ($EXPECTED_COUNT tags)"
generate
check "archive.html exists" test -f docs/archive.html
PAGES=$(ls docs/archive 2>/dev/null | sed 's/\.html$//' | sort -V)
check "page set equals tag set" test "$PAGES" = "$EXPECTED_TAGS"
LISTED=$(grep -o 'href="archive/[^"]*\.html"' docs/archive.html | sed 's#.*/##; s/\.html"//' | sort -u | sort -V)
check "index lists exactly those tags" test "$LISTED" = "$EXPECTED_TAGS"

echo "Case 2: $NEWEST page content"
PAGE="docs/archive/$NEWEST.html"
NFILES=$(git ls-tree --name-only "$NEWEST" stuff/ | grep -c '\.md$')
NARTIFACTS=$(grep -c 'class="artifact"' "$PAGE" || true)
check "one artifact per stuff/*.md ($NFILES)" test "$NARTIFACTS" -eq "$NFILES"
while IFS= read -r f; do
  base=$(basename "$f" .md)
  title=$(git show "$NEWEST:$f" | grep -m1 '^# ' | sed 's/^# //')
  [[ -z "$title" ]] && title="$base.md"
  check "artifact-$base is anchored" grep -q "id=\"artifact-$base\"" "$PAGE"
  check "artifact-$base titled '$title'" grep -qF ">$title</a>" "$PAGE"
done < <(git ls-tree --name-only "$NEWEST" stuff/ | grep '\.md$')

echo "Case 3: working tree stuff/ is not consulted"
cp -R docs/archive "$TMP/archive.before"
cp docs/archive.html "$TMP/archive.html.before"
rm -rf stuff
generate
check "archive/ unchanged without stuff/" diff -r "$TMP/archive.before" docs/archive
check "archive.html unchanged without stuff/" diff "$TMP/archive.html.before" docs/archive.html

echo "Case 4: regeneration is byte-stable"
generate
check "archive/ unchanged on rerun" diff -r "$TMP/archive.before" docs/archive
check "archive.html unchanged on rerun" diff "$TMP/archive.html.before" docs/archive.html

echo "Case 5: a page exists exactly as long as its tag"
git tag -d "$NEWEST" >/dev/null
generate
check "page removed with tag" test ! -e "$PAGE"
check "index entry removed with tag" bash -c "! grep -q 'archive/$NEWEST.html' docs/archive.html"
check "other pages intact" test "$(ls docs/archive | wc -l | tr -d ' ')" -eq $((EXPECTED_COUNT - 1))

# Budget for Case 6. The batched generator takes about 10s for this repo on
# a 2024 laptop (about 1s of git, the rest one bin/zmd2html per artifact);
# the per-tag fan-out it replaced took about 60s. Override for slow hosts.
SCALE_TAGS=120
SCALE_BUDGET_SECONDS="${SCALE_BUDGET_SECONDS:-30}"

# synthetic_repo <dir> <ntags>: a repo whose only history is <ntags>
# annotated rev* tags, each on its own commit holding stuff/a.md (h1 with
# characters that need escaping), stuff/b.md (no h1), stuff/empty.md (0
# bytes) and stuff/Zeta-<n>.md, all distinct per tag. Built with one
# git fast-import so the fixture itself is not a fan-out. Nothing is
# checked out: bin/ and PROMPT.md are copied in untracked, which is all
# bin/zsite-generate reads from the working tree once stuff/ is absent.
synthetic_repo() {
  local dir="$1" n="$2" i a b z
  git init -q "$dir"
  cp -R "$TMP/repo/bin" "$dir/bin"
  cp "$TMP/repo/PROMPT.md" "$dir/PROMPT.md"
  for ((i = 1; i <= n; i++)); do
    a=$(printf '# Title %d & <b>\n\nbody %d' "$i" "$i")
    b=$(printf 'no heading in %d' "$i")
    z=$(printf '# Zeta %d' "$i")
    printf 'commit refs/heads/main\nmark :%d\ncommitter Zociety Test <test@zociety.dev> %d +0000\ndata 12\n[stuff] %04d\ndeleteall\n' \
      "$i" $((1700000000 + i * 86400)) "$i"
    printf 'M 100644 inline stuff/a.md\ndata %d\n%s\n' "${#a}" "$a"
    printf 'M 100644 inline stuff/b.md\ndata %d\n%s\n' "${#b}" "$b"
    printf 'M 100644 inline stuff/empty.md\ndata 0\n\n'
    printf 'M 100644 inline stuff/Zeta-%d.md\ndata %d\n%s\n\n' "$i" "${#z}" "$z"
    printf 'tag rev%d-attempt1-iterations1of1\nfrom :%d\ntagger Zociety Test <test@zociety.dev> %d +0000\ndata 8\nrev %04d\n' \
      "$i" "$i" $((1700000000 + i * 86400)) "$i"
  done | LC_ALL=C git -C "$dir" fast-import --quiet
}

echo "Case 6: $SCALE_TAGS synthetic tags generate within ${SCALE_BUDGET_SECONDS}s"
synthetic_repo "$TMP/synth" "$SCALE_TAGS"
cd "$TMP/synth"
check "fixture holds $SCALE_TAGS rev* tags" test "$(git for-each-ref 'refs/tags/rev*' | wc -l | tr -d ' ')" -eq "$SCALE_TAGS"
START=$SECONDS
generate
ELAPSED=$((SECONDS - START))
check "generated in ${ELAPSED}s (budget ${SCALE_BUDGET_SECONDS}s)" test "$ELAPSED" -le "$SCALE_BUDGET_SECONDS"
check "one page per synthetic tag" test "$(ls docs/archive | wc -l | tr -d ' ')" -eq "$SCALE_TAGS"
LAST="rev$SCALE_TAGS-attempt1-iterations1of1"
PAGE="docs/archive/$LAST.html"
check "newest synthetic page lists 4 artifacts" test "$(grep -c 'class="artifact"' "$PAGE")" -eq 4
check "empty artifact is present" grep -q 'id="artifact-empty"' "$PAGE"
check "h1 title is HTML-escaped" grep -qF ">Title $SCALE_TAGS &amp; &lt;b&gt;</a>" "$PAGE"
check "artifact without h1 falls back to its filename" grep -qF '>b.md</a> <code>b.md</code>' "$PAGE"
check "body comes from the tag, not the tree" grep -qF "body $SCALE_TAGS" "$PAGE"
check "index lists the newest tag first" test "$(grep -o 'href="archive/[^"]*\.html"' docs/archive.html | head -1)" = "href=\"archive/$LAST.html\""
cd "$TMP/repo"

echo
echo "passed $PASS, failed $FAIL"
[[ $FAIL -eq 0 ]]
