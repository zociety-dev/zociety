#!/bin/bash
# test-zsite-archive: Prove the site archive (docs/archive.html and
# docs/archive/<tag>.html) is a pure function of the rev* tags
#
# Usage:
#   bin/test-zsite-archive [--keep]
#   bin/test-zsite-archive -h | --help
#
# Options:
#   --keep    Leave the throwaway copy behind (path printed) for inspection
#
# Copies this repo (working tree and .git) under mktemp and runs
# bin/zsite-generate there with the provenance demo switched off
# (NFPROV_BLAME_JSON_FILE pointed at a missing file), so nothing here
# touches the real docs/ and no event is committed. Cases:
#   1. every rev* tag whose tree holds stuff/*.md gets one page, listed on
#      archive.html, and no other tag does
#   2. docs/rules.html lists every [pass] event with a JSON body reachable
#      from a rev* tag, each linked to its commit, on the card of the tag
#      that archived it: the newest tag's card holds exactly the [pass]
#      commits no older tag reaches, its question and its heap-death. A
#      rule leaves the page with the highest tag (case 6; a lower tag's
#      rules move to the next tag that reaches them) and a repo whose
#      tags hold no [pass] gets the page with no rule (case 7)
#   3. the newest such tag's page holds one artifact per stuff/*.md in the
#      tag, each with the file's first h1 as its title
#   4. deleting stuff/ from the working tree changes no archive byte
#   5. running the generator twice changes no archive byte
#   6. deleting the newest tag removes its page and its index entry
#   7. a synthetic repo with 120 rev* tags (four stuff/*.md each, one of
#      them empty, one without an h1) generates within SCALE_BUDGET_SECONDS
#      and gets every page, artifact, title and escape right: the generator
#      gathers the archive in a fixed number of git calls, and this case
#      catches a slide back to per-tag or per-artifact subprocesses
#   8. the front page and "This Cycle" describe the highest
#      rev{N}-attempt{M} tag, not main, a cycle branch (deleted on GitHub
#      when its PR merges) or the working tree; bin/zstate --ref reads a
#      given ref

set -e

REPO="$(cd "$(dirname "$0")/.." && pwd)"
KEEP=0

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --keep) KEEP=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

PASS=0
FAIL=0
ok()   { PASS=$((PASS + 1)); echo "  ✓ $*"; }
fail() { FAIL=$((FAIL + 1)); echo "  ✗ $*" >&2; }
check() { # check <description> <command...>
  local desc="$1"; shift
  if "$@" >/dev/null 2>&1; then ok "$desc"; else fail "$desc"; fi
}

TMP=$(mktemp -d "${TMPDIR:-/tmp}/zsite-archive.XXXXXX")
cleanup() {
  if [[ $KEEP -eq 1 ]]; then
    echo "kept: $TMP"
  else
    rm -rf "$TMP"
  fi
}
trap cleanup EXIT

echo "Copying repo to $TMP/repo..."
cp -R "$REPO" "$TMP/repo"
cd "$TMP/repo"

# The generator is silent about the archive only when nothing changes; keep
# its own chatter out of the way and fail loudly on a non-zero exit.
generate() {
  NFPROV_BLAME_JSON_FILE="$TMP/no-such-blame.json" bin/zsite-generate >"$TMP/generate.log" 2>&1 \
    || { echo "bin/zsite-generate failed:" >&2; tail -20 "$TMP/generate.log" >&2; exit 1; }
}

# Tags with top-level stuff/*.md, version order; the newest is the subject
# of the content checks.
tags_with_stuff() {
  local t
  for t in $(git tag | grep '^rev' | sort -V); do
    if git ls-tree --name-only "$t" stuff/ 2>/dev/null | grep -q '\.md$'; then
      echo "$t"
    fi
  done
}
EXPECTED_TAGS=$(tags_with_stuff)
EXPECTED_COUNT=$(printf '%s\n' "$EXPECTED_TAGS" | grep -c . || true)
NEWEST=$(printf '%s\n' "$EXPECTED_TAGS" | tail -1)
if [[ "$EXPECTED_COUNT" -eq 0 ]]; then
  echo "no rev* tag holds stuff/*.md; nothing to test" >&2
  exit 2
fi

echo "Case 1: one page per tag with stuff ($EXPECTED_COUNT tags)"
generate
check "archive.html exists" test -f docs/archive.html
PAGES=$(ls docs/archive 2>/dev/null | sed 's/\.html$//' | sort -V)
check "page set equals tag set" test "$PAGES" = "$EXPECTED_TAGS"
LISTED=$(grep -o 'href="archive/[^"]*\.html"' docs/archive.html | sed 's#.*/##; s/\.html"//' | sort -u | sort -V)
check "index lists exactly those tags" test "$LISTED" = "$EXPECTED_TAGS"

# pass_tags: one line per [pass] event the rules page lists: the tag git
# reached it from along first parents (its card). Gathered as the page
# gathers them, one git log over the tag set, a body read whole as JSON or
# else by its first {"z":1 line, so a [pass] subject with no event body
# (the file-based cycles) is not counted
pass_tags() {
  git log --first-parent --format='%S%x1f%b%x1e' --grep='^\[pass\]' --glob='refs/tags/rev*' \
    | jq -R -r -s '
      split("\u001e")[] | ltrimstr("\n") | select(length > 0) | split("\u001f")
      | select(((.[1] | fromjson?)
                // (.[1] | split("\n") | map(select(startswith("{\"z\":1")) | fromjson?) | first))
               | (type == "object") and (.z == 1) and (.event == "pass"))
      | .[0] | ltrimstr("refs/tags/")'
}
passes_on_tags() {
  pass_tags | grep -c . || true
}
# card <tag>: the tag's card on docs/rules.html, from its div to the next
card() {
  awk -v id="id=\"$1\"" 'index($0, "<div class=\"cycle\"") { on = index($0, id) > 0 } on' docs/rules.html
}
# own_commits <tag> <event>: the tag's first-parent commits carrying a
# z:1 <event> envelope that no rev* tag below it reaches, i.e. the cycle
# it archived, not the lineage below it nor one merged in from main;
# found without %S, so it is an independent check on the page's
# attribution, and it works for a tag a newer tag descends from
own_commits() {
  local tag="$1" event="$2" below
  below=$(git tag -l 'rev*' --merged "$tag" | grep -vxF "$tag")
  # shellcheck disable=SC2086  # the tag names are one per line, no spaces
  git log --first-parent --format='%H%x1f%b%x1e' --grep="^\[$event\]" "$tag" --not $below \
    | jq -R -r -s --arg ev "$event" '
      split("\u001e")[] | ltrimstr("\n") | select(length > 0) | split("\u001f")
      | select(((.[1] | fromjson?)
                // (.[1] | split("\n") | map(select(startswith("{\"z\":1")) | fromjson?) | first))
               | (type == "object") and (.z == 1) and (.event == $ev))
      | .[0]'
}
echo "Case 2: rules.html lists every [pass] reachable from the tags, under the tag that archived it"
check "rules.html exists" test -f docs/rules.html
PASS_TAGS=$(pass_tags)
NPASS=$(grep -c . <<< "$PASS_TAGS" || true)
check "one entry per [pass] event ($NPASS)" test "$(grep -c '<li value=' docs/rules.html)" -eq "$NPASS"
check "the headline count agrees" grep -q "<p>$NPASS rules," docs/rules.html
NCARDS=$(sort -u <<< "$PASS_TAGS" | grep -c . || true)
check "one card per tag that reached a [pass] ($NCARDS)" test "$(grep -c '<div class="cycle" id=' docs/rules.html)" -eq "$NCARDS"
NEWEST_PASSES=$(own_commits "$NEWEST" pass)
NEWEST_NPASS=$(grep -c . <<< "$NEWEST_PASSES" || true)
CARD=$(card "$NEWEST")
check "$NEWEST has a card" test -n "$CARD"
check "its card holds the tag's own [pass] commits and no other ($NEWEST_NPASS)" test "$(grep -c '<li value=' <<< "$CARD")" -eq "$NEWEST_NPASS"
while IFS= read -r sha; do
  [[ -n "$sha" ]] || continue
  check "rule ${sha:0:7} is linked on $NEWEST's card" grep -q "commit/$sha\"" <<< "$CARD"
done <<< "$NEWEST_PASSES"
check "its card links the tag's archive page" grep -q "href=\"archive/$NEWEST.html\"" <<< "$CARD"
if [[ -n "$(own_commits "$NEWEST" direction)" ]]; then
  check "its card carries the cycle's own question" grep -q 'class="question"' <<< "$CARD"
fi
NEWEST_DEATH=$(own_commits "$NEWEST" heap-death | head -1)
if [[ -n "$NEWEST_DEATH" ]]; then
  check "its card links the heap-death ${NEWEST_DEATH:0:7} with the learning" grep -q "commit/$NEWEST_DEATH\"" <<< "$CARD"
fi
check "front page links the rules page" grep -q 'href="rules.html"' docs/index.html

echo "Case 3: $NEWEST page content"
PAGE="docs/archive/$NEWEST.html"
NFILES=$(git ls-tree --name-only "$NEWEST" stuff/ | grep -c '\.md$')
NARTIFACTS=$(grep -c 'class="artifact"' "$PAGE" || true)
check "one artifact per stuff/*.md ($NFILES)" test "$NARTIFACTS" -eq "$NFILES"
while IFS= read -r f; do
  base=$(basename "$f" .md)
  title=$(git show "$NEWEST:$f" | grep -m1 '^# ' | sed 's/^# //')
  [[ -z "$title" ]] && title="$base.md"
  check "artifact-$base is anchored" grep -q "id=\"artifact-$base\"" "$PAGE"
  check "artifact-$base titled '$title'" grep -qF ">$title</a>" "$PAGE"
done < <(git ls-tree --name-only "$NEWEST" stuff/ | grep '\.md$')

echo "Case 4: working tree stuff/ is not consulted"
cp -R docs/archive "$TMP/archive.before"
cp docs/archive.html "$TMP/archive.html.before"
rm -rf stuff
generate
check "archive/ unchanged without stuff/" diff -r "$TMP/archive.before" docs/archive
check "archive.html unchanged without stuff/" diff "$TMP/archive.html.before" docs/archive.html

echo "Case 5: regeneration is byte-stable"
generate
check "archive/ unchanged on rerun" diff -r "$TMP/archive.before" docs/archive
check "archive.html unchanged on rerun" diff "$TMP/archive.html.before" docs/archive.html

echo "Case 6: a page exists exactly as long as its tag"
HIGHEST=$(git tag -l 'rev*' | sort -V | tail -1)
git tag -d "$NEWEST" >/dev/null
generate
check "page removed with tag" test ! -e "$PAGE"
check "index entry removed with tag" bash -c "! grep -q 'archive/$NEWEST.html' docs/archive.html"
check "other pages intact" test "$(ls docs/archive | wc -l | tr -d ' ')" -eq $((EXPECTED_COUNT - 1))
NPASS_LEFT=$(passes_on_tags)
check "rules.html follows the tag set ($NPASS_LEFT [pass] left)" test "$(grep -c '<li value=' docs/rules.html)" -eq "$NPASS_LEFT"
check "$NEWEST's card left with its tag" bash -c "! grep -q 'id=\"$NEWEST\"' docs/rules.html"
# A rule leaves the page only when no tag reaches it; with a higher rev*
# tag (one that archived no stuff), NEWEST's rules move to that tag's card
if [[ "$NEWEST" == "$HIGHEST" ]]; then
  while IFS= read -r sha; do
    [[ -n "$sha" ]] || continue
    check "rule ${sha:0:7} left the page with its tag" bash -c "! grep -q 'commit/$sha\"' docs/rules.html"
  done <<< "$NEWEST_PASSES"
else
  echo "  - $NEWEST is not the highest rev* tag; its rules move to the next card rather than leave"
fi

# Budget for Case 7. The batched generator takes about 10s for this repo on
# a 2024 laptop (about 1s of git, the rest one bin/zmd2html per artifact);
# the per-tag fan-out it replaced took about 60s. Override for slow hosts.
SCALE_TAGS=120
SCALE_BUDGET_SECONDS="${SCALE_BUDGET_SECONDS:-30}"

# synthetic_repo <dir> <ntags>: a repo whose only history is <ntags>
# annotated rev* tags, each on its own commit holding stuff/a.md (h1 with
# characters that need escaping), stuff/b.md (no h1), stuff/empty.md (0
# bytes) and stuff/Zeta-<n>.md, all distinct per tag. Built with one
# git fast-import so the fixture itself is not a fan-out. Nothing is
# checked out: bin/ and PROMPT.md are copied in untracked, which is all
# bin/zsite-generate reads from the working tree once stuff/ is absent.
synthetic_repo() {
  local dir="$1" n="$2" i a b z
  git init -q "$dir"
  cp -R "$TMP/repo/bin" "$dir/bin"
  cp "$TMP/repo/PROMPT.md" "$dir/PROMPT.md"
  for ((i = 1; i <= n; i++)); do
    a=$(printf '# Title %d & <b>\n\nbody %d' "$i" "$i")
    b=$(printf 'no heading in %d' "$i")
    z=$(printf '# Zeta %d' "$i")
    printf 'commit refs/heads/main\nmark :%d\ncommitter Zociety Test <test@zociety.dev> %d +0000\ndata 12\n[stuff] %04d\ndeleteall\n' \
      "$i" $((1700000000 + i * 86400)) "$i"
    printf 'M 100644 inline stuff/a.md\ndata %d\n%s\n' "${#a}" "$a"
    printf 'M 100644 inline stuff/b.md\ndata %d\n%s\n' "${#b}" "$b"
    printf 'M 100644 inline stuff/empty.md\ndata 0\n\n'
    printf 'M 100644 inline stuff/Zeta-%d.md\ndata %d\n%s\n\n' "$i" "${#z}" "$z"
    printf 'tag rev%d-attempt1-iterations1of1\nfrom :%d\ntagger Zociety Test <test@zociety.dev> %d +0000\ndata 8\nrev %04d\n' \
      "$i" "$i" $((1700000000 + i * 86400)) "$i"
  done | LC_ALL=C git -C "$dir" fast-import --quiet
}

echo "Case 7: $SCALE_TAGS synthetic tags generate within ${SCALE_BUDGET_SECONDS}s"
synthetic_repo "$TMP/synth" "$SCALE_TAGS"
cd "$TMP/synth"
check "fixture holds $SCALE_TAGS rev* tags" test "$(git for-each-ref 'refs/tags/rev*' | wc -l | tr -d ' ')" -eq "$SCALE_TAGS"
START=$SECONDS
generate
ELAPSED=$((SECONDS - START))
check "generated in ${ELAPSED}s (budget ${SCALE_BUDGET_SECONDS}s)" test "$ELAPSED" -le "$SCALE_BUDGET_SECONDS"
check "one page per synthetic tag" test "$(ls docs/archive | wc -l | tr -d ' ')" -eq "$SCALE_TAGS"
LAST="rev$SCALE_TAGS-attempt1-iterations1of1"
PAGE="docs/archive/$LAST.html"
check "newest synthetic page lists 4 artifacts" test "$(grep -c 'class="artifact"' "$PAGE")" -eq 4
check "empty artifact is present" grep -q 'id="artifact-empty"' "$PAGE"
check "h1 title is HTML-escaped" grep -qF ">Title $SCALE_TAGS &amp; &lt;b&gt;</a>" "$PAGE"
check "artifact without h1 falls back to its filename" grep -qF '>b.md</a> <code>b.md</code>' "$PAGE"
check "body comes from the tag, not the tree" grep -qF "body $SCALE_TAGS" "$PAGE"
check "index lists the newest tag first" test "$(grep -o 'href="archive/[^"]*\.html"' docs/archive.html | head -1)" = "href=\"archive/$LAST.html\""
check "rules.html generated with no [pass] on any tag" test -f docs/rules.html
check "and lists no rule" test "$(grep -c '<li value=' docs/rules.html || true)" -eq 0
cd "$TMP/repo"

# live_commit <ref> <mark> <cycle> <stuff-file> <title> [from]: one fast-import
# commit on <ref> holding a [join] event for <cycle> and stuff/<stuff-file>,
# branched from mark <from> with the parent's stuff/ removed, as a cycle
# branch starts after heap-death clears it
live_commit() {
  local ref="$1" mark="$2" cycle="$3" file="$4" title="$5" from="${6:-}" msg body
  msg=$(printf '[join] member-1: joins cycle %d\n\n{"z":1,"event":"join","cycle":%d,"seq":1,"agent":"member-1","ts":"2026-01-01T00:00:00Z","state":{"members":1,"rules":0,"stuff":0,"complete":false},"data":{"role":"tester","greeting":"hi"}}' "$cycle" "$cycle")
  body=$(printf '# %s\n\nbody of %s' "$title" "$file")
  printf 'commit %s\nmark :%d\ncommitter Zociety Test <test@zociety.dev> %d +0000\ndata %d\n%s\n' \
    "$ref" "$mark" $((1700000000 + mark * 86400)) "${#msg}" "$msg"
  [[ -z "$from" ]] || printf 'from :%d\nD stuff\n' "$from"
  printf 'M 100644 inline stuff/%s\ndata %d\n%s\n\n' "$file" "${#body}" "$body"
}

echo "Case 8: the current cycle is the highest rev* tag's, not a branch's or the checkout's"
mkdir -p "$TMP/live"
git init -q -b main "$TMP/live"
cp -R "$TMP/repo/bin" "$TMP/live/bin"
cp "$TMP/repo/PROMPT.md" "$TMP/live/PROMPT.md"
{
  live_commit refs/heads/main 1 5 main-only.md "Main artifact"
  live_commit refs/tags/rev2-attempt9-iterations1of1 2 6 older.md "Older artifact" 1
  # Version order: attempt10 is above attempt9 (sort -V reads the numbers).
  live_commit refs/tags/rev2-attempt10-iterations1of1 3 7 live.md "Live artifact" 1
  # A cycle branch above every tag, local and on origin: the running cycle,
  # which the site must not describe (CI never has it; GitHub deletes a
  # cycle branch when its PR merges).
  live_commit refs/heads/cycle/rev2-attempt11 4 8 branch.md "Branch artifact" 3
  live_commit refs/remotes/origin/cycle/rev2-attempt12 5 9 remote.md "Remote branch artifact" 3
} | LC_ALL=C git -C "$TMP/live" fast-import --quiet
cd "$TMP/live"
mkdir -p stuff
printf '# Working tree artifact\n' > stuff/untracked.md
check "zstate reads HEAD by default" test "$(bin/zstate | jq -r .cycle)" = 5
check "zstate --ref reads that ref" test "$(bin/zstate --ref refs/tags/rev2-attempt10-iterations1of1 | jq -r .cycle)" = 7
check "zstate --ref refuses a ref that is not a commit" bash -c '! bin/zstate --ref no-such-ref'
generate
check "front page shows the newest tag's cycle" grep -q '<div class="stat-value">7</div>' docs/index.html
check "front page names the cycle by its tag" grep -qF 'Current Genesis Progress <code>rev2-attempt10</code>' docs/index.html
check "front page counts cycles and revisions from the tags" \
  bash -c 'grep -qF "<div class=\"stat-value\">2</div>" docs/index.html && grep -qF "<div class=\"stat-value\">1</div>" docs/index.html'
check "This Cycle holds the newest tag's stuff" grep -qF 'Live artifact' docs/stuff.html
check "not main's, an older cycle's, a branch's or the working tree's" \
  bash -c '! grep -qE "Main artifact|Older artifact|Branch artifact|Remote branch artifact|Working tree artifact" docs/stuff.html'
cd "$TMP/repo"

echo
echo "passed $PASS, failed $FAIL"
[[ $FAIL -eq 0 ]]
