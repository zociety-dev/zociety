#!/bin/bash
# zcheck: Verify event sourcing system installation

set -e

echo "╔════════════════════════════════════════╗"
echo "║  Zociety Event System Check            ║"
echo "╚════════════════════════════════════════╝"
echo ""

ERRORS=0

check_script() {
  local script="$1"
  local desc="$2"

  if [[ -x "$script" ]]; then
    echo "✓ $desc"
  else
    echo "✗ $desc (missing or not executable)"
    ERRORS=$((ERRORS + 1))
  fi
}

echo "Checking core scripts..."
check_script "bin/zstate" "bin/zstate - Query current state"
check_script "bin/zagent" "bin/zagent - Extensible agent runner wrapper"
check_script "bin/zrender" "bin/zrender - Compact stream-json renderer"
check_script "bin/zevent" "bin/zevent - Create event commits"
check_script "bin/zjoin" "bin/zjoin - Join event wrapper"
check_script "bin/zvote" "bin/zvote - Vote event wrapper"
check_script "bin/zstuff" "bin/zstuff - Stuff event wrapper"
check_script "bin/zpass" "bin/zpass - Pass rule wrapper"
check_script "bin/zpromise" "bin/zpromise - Completion promise"
check_script "bin/zheap-death" "bin/zheap-death - Archive cycle"
echo ""

echo "Checking loop scripts..."
check_script "bin/zloop" "bin/zloop - Autonomous loop"
check_script "bin/zloop-complete" "bin/zloop-complete - Stop predicate dispatcher"
check_script "bin/zcycle-id" "bin/zcycle-id - Cycle identity (current/next)"
check_script "bin/zblind" "bin/zblind - Seal/reveal the per-turn model record"
check_script "bin/zstop-action" "bin/zstop-action - Stop when action is stop/promise"
check_script "bin/zstop-budget" "bin/zstop-budget - Stop after N heap-deaths"
check_script "bin/zstop-converge" "bin/zstop-converge - Stop when cycles stop changing"
check_script "bin/zstop-feedback" "bin/zstop-feedback - Stop when heap-death says done"
check_script "bin/zstop-file" "bin/zstop-file - Stop when .claude/STOP exists"
echo ""

echo "Checking utility scripts..."
check_script "bin/zvalidate" "bin/zvalidate - Validate commits"
check_script "bin/test-zevent-system" "bin/test-zevent-system - Test suite"
check_script "bin/test-zstop-modes" "bin/test-zstop-modes - Stop mode harness"
check_script "bin/test-zcycle-id" "bin/test-zcycle-id - Cycle identity harness"
check_script "bin/test-zblind" "bin/test-zblind - Blind model record harness"
check_script "bin/test-zga-loop" "bin/test-zga-loop - GitHub Actions runner harness"
check_script "bin/test-zshim" "bin/test-zshim - git shim routing harness"
check_script "bin/zgit" "bin/zgit - git inside the container"
check_script "bin/zcheck" "bin/zcheck - This script"
echo ""

echo "Checking documentation..."
[[ -f "PROMPT.md" ]] && echo "✓ PROMPT.md" || { echo "✗ PROMPT.md"; ERRORS=$((ERRORS + 1)); }
[[ -f "AGENTS.md" ]] && echo "✓ AGENTS.md" || { echo "✗ AGENTS.md"; ERRORS=$((ERRORS + 1)); }
echo ""

echo "Checking dependencies..."
command -v jq &>/dev/null && echo "✓ jq installed" || { echo "✗ jq not installed"; ERRORS=$((ERRORS + 1)); }
command -v git &>/dev/null && echo "✓ git installed" || { echo "✗ git not installed"; ERRORS=$((ERRORS + 1)); }
echo ""

echo "Testing bin/zstate..."
if bin/zstate &>/dev/null; then
  echo "✓ bin/zstate executes successfully"
  STATE=$(bin/zstate)
  CYCLE=$(echo "$STATE" | jq -r '.cycle // "error"')
  ACTION=$(echo "$STATE" | jq -r '.action // "error"')
  echo "  Current cycle: $CYCLE"
  echo "  Recommended action: $ACTION"
else
  echo "✗ bin/zstate failed to execute"
  ERRORS=$((ERRORS + 1))
fi
echo ""

if [[ $ERRORS -eq 0 ]]; then
  echo "╔════════════════════════════════════════╗"
  echo "║  ✓ All checks passed!                  ║"
  echo "╠════════════════════════════════════════╣"
  echo "║  System is ready to use.               ║"
  echo "║  Run: bin/zstate | jq .                ║"
  echo "║  Docs: AGENTS.md                       ║"
  echo "╚════════════════════════════════════════╝"
  exit 0
else
  echo "╔════════════════════════════════════════╗"
  echo "║  ✗ $ERRORS error(s) found                    ║"
  echo "╠════════════════════════════════════════╣"
  echo "║  Please fix issues above.              ║"
  echo "╚════════════════════════════════════════╝"
  exit 1
fi
