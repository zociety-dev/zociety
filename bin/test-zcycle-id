#!/bin/bash
# test-zcycle-id: Dry-run harness for cycle identity (bin/zcycle-id, the
# zheap-death successor checkout and the zloop preflight)
#
# Usage:
#   bin/test-zcycle-id [--keep]
#   bin/test-zcycle-id -h | --help
#
# Options:
#   --keep    Leave the throwaway directory behind (path printed) for inspection
#
# Builds throwaway git repos under mktemp with a copy of this repo's bin/ and
# a fake `claude` on PATH (one line, exit 0), as bin/test-zstop-modes does.
# Cases: bin/zcycle-id current/next from no tags, from a tag with PROMPT.md
# unchanged and changed, and on a cycle branch (the branch name wins);
# bin/zheap-death on a cycle branch ends on the successor branch with the
# [direction] event on it and the tag on the previous head; bin/zloop checks
# out cycle/rev{N}-attempt{M} at birth.

set -e

SRC_BIN="$(cd "$(dirname "$0")" && pwd)"
KEEP=0

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --keep)
      KEEP=1
      ;;
    *)
      echo "test-zcycle-id: unknown argument '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

TMP=$(mktemp -d "${TMPDIR:-/tmp}/zcycle-test.XXXXXX")
OUT="$TMP/out"
ERR="$TMP/err"
FAKEBIN="$TMP/fakebin"

cleanup() {
  if [[ $KEEP -eq 1 ]]; then
    echo "Kept: $TMP" >&2
  else
    rm -rf "$TMP"
  fi
}
trap cleanup EXIT

PASSED=0
FAILED=0
RC=0

#############################################
# Fixtures
#############################################

# Fake claude: one line on stdout, exit 0. The zloop cases run --quiet, so no
# stream-json is needed.
mkdir -p "$FAKEBIN" "$TMP/nohooks"
printf '#!/bin/bash\necho "fake claude ran"\n' > "$FAKEBIN/claude"
chmod +x "$FAKEBIN/claude"
export PATH="$FAKEBIN:$PATH"

# fresh_repo <name>: new throwaway repo with bin/ copied in, one genesis
# commit on main, cwd moved into it. See bin/test-zstop-modes fresh_repo.
fresh_repo() {
  REPO="$TMP/repo-$1"
  mkdir -p "$REPO/bin" "$REPO/.claude"
  cp -R "$SRC_BIN/." "$REPO/bin/"
  cd "$REPO"
  git init -q .
  git symbolic-ref HEAD refs/heads/main
  git config user.name tester
  git config user.email tester@example.com
  git config commit.gpgsign false
  git config core.hooksPath "$TMP/nohooks"
  echo "# fixture prompt" > PROMPT.md
  mkdir stuff
  echo "fixture inheritance artifact" > stuff/inherited.md
  printf '.claude/\n' > .gitignore
  git add .gitignore PROMPT.md stuff/inherited.md
  git commit -q -m "genesis fixture"
}

# event <type>: one synthetic event commit via bin/zevent, quietly
event() {
  ZOCIETY_TURN_ID="fixture-$1-$RANDOM" bin/zevent "$1" tester "synthetic $1" '{}' >/dev/null 2>&1
}

# change_prompt: commit a PROMPT.md edit (a rev bump for the tag derivation)
change_prompt() {
  echo "# changed" >> PROMPT.md
  git add PROMPT.md
  git commit -q -m "fixture prompt change"
}

#############################################
# Assertions
#############################################

run() {
  RC=0
  "$@" >"$OUT" 2>"$ERR" || RC=$?
}

pass() {
  echo "  ✓ $1"
  PASSED=$((PASSED + 1))
}

fail() {
  echo "  ✗ $1"
  FAILED=$((FAILED + 1))
}

assert_rc() {
  if [[ "$RC" -eq "$1" ]]; then
    pass "exit $RC"
  else
    fail "exit $RC (want $1)"
    sed 's/^/    stderr: /' "$ERR"
  fi
}

# assert_out <want>: stdout is exactly this one line
assert_out() {
  local got
  got=$(cat "$OUT")
  if [[ "$got" == "$1" ]]; then
    pass "stdout: $got"
  else
    fail "stdout: '$got' (want '$1')"
    sed 's/^/    stderr: /' "$ERR"
  fi
}

# assert_out_has <ere>: stdout has a line matching; print the first match
assert_out_has() {
  local line
  if line=$(grep -E -m1 -- "$1" "$OUT"); then
    pass "stdout: $line"
  else
    fail "stdout lacks /$1/"
    sed 's/^/    stdout: /' "$OUT"
  fi
}

assert_no_out() {
  if grep -E -q -- "$1" "$OUT"; then
    fail "stdout unexpectedly matches /$1/"
  else
    pass "stdout has no /$1/"
  fi
}

# assert_err <ere>: stderr has a line matching; print the first match
assert_err() {
  local line
  if line=$(grep -E -m1 -- "$1" "$ERR"); then
    pass "stderr: $line"
  else
    fail "stderr lacks /$1/"
    sed 's/^/    stderr: /' "$ERR"
  fi
}

assert_no_err() {
  if grep -E -q -- "$1" "$ERR"; then
    fail "stderr unexpectedly matches /$1/"
  else
    pass "stderr has no /$1/"
  fi
}

# assert_eq <label> <got> <want>
assert_eq() {
  if [[ "$2" == "$3" ]]; then
    pass "$1: $2"
  else
    fail "$1: $2 (want $3)"
  fi
}

# assert_branch_at <branch> <sha>: the branch exists and points at sha
assert_branch_at() {
  local got
  got=$(git rev-parse --verify -q "refs/heads/$1" || echo missing)
  if [[ "$got" == "$2" ]]; then
    pass "$1 at ${2:0:7}"
  else
    fail "$1 at ${got:0:7} (want ${2:0:7})"
  fi
}

# assert_tag_at <glob> <sha>: exactly one tag matches glob and points at sha
assert_tag_at() {
  local tags n got
  tags=$(git tag --list "$1")
  n=$(echo "$tags" | grep -c . || true)
  if [[ "$n" -ne 1 ]]; then
    fail "tags matching $1: $n (want 1)"
    return
  fi
  got=$(git rev-parse "$tags^{commit}")
  if [[ "$got" == "$2" ]]; then
    pass "tag $tags at ${2:0:7}"
  else
    fail "tag $tags at ${got:0:7} (want ${2:0:7})"
  fi
}

#############################################
# Cases: bin/zcycle-id
#############################################

echo "╔════════════════════════════════════════╗"
echo "║  Zociety Cycle Identity Harness        ║"
echo "╚════════════════════════════════════════╝"
echo "Throwaway: $TMP"
echo ""

echo "=== Case 1: no tags -> rev1-attempt1; next -> rev1-attempt2 ==="
fresh_repo notags
run bin/zcycle-id current
assert_rc 0
assert_out rev1-attempt1
run bin/zcycle-id next
assert_rc 0
assert_out rev1-attempt2
run bin/zcycle-id --branch current
assert_rc 0
assert_out cycle/rev1-attempt1
run bin/zcycle-id next --branch
assert_rc 0
assert_out cycle/rev1-attempt2
echo ""

echo "=== Case 2: tag + unchanged PROMPT.md -> attempt+1 ==="
fresh_repo tag-same
git tag rev3-attempt4-iterations5of60 -m "q"
event join
run bin/zcycle-id current
assert_rc 0
assert_out rev3-attempt5
run bin/zcycle-id next
assert_rc 0
assert_out rev3-attempt6
echo ""

echo "=== Case 3: tag + changed PROMPT.md -> rev+1 attempt1 ==="
fresh_repo tag-changed
git tag rev3-attempt4-iterations5of60 -m "q"
change_prompt
run bin/zcycle-id current
assert_rc 0
assert_out rev4-attempt1
run bin/zcycle-id next
assert_rc 0
assert_out rev4-attempt2
echo ""

echo "=== Case 3b: tags sort by version (rev1-attempt10 after rev1-attempt9) ==="
fresh_repo tag-order
git tag rev1-attempt9-iterations1of1 -m "q"
git tag rev1-attempt10-iterations1of1 -m "q"
run bin/zcycle-id current
assert_rc 0
assert_out rev1-attempt11
echo ""

echo "=== Case 4: on a cycle branch the branch name wins over the tag ==="
fresh_repo branch-wins
git tag rev3-attempt4-iterations5of60 -m "q"
change_prompt
git checkout -q -b cycle/rev7-attempt2
run bin/zcycle-id current
assert_rc 0
assert_out rev7-attempt2
run bin/zcycle-id --branch next
assert_rc 0
assert_out cycle/rev7-attempt3
git checkout -q main
run bin/zcycle-id current
assert_rc 0
assert_out rev4-attempt1
echo ""

echo "=== Case 5: usage errors ==="
fresh_repo usage
run bin/zcycle-id
assert_rc 1
run bin/zcycle-id later
assert_rc 1
assert_err "^zcycle-id: unknown argument 'later'$"
run bin/zcycle-id current next
assert_rc 1
assert_err "^zcycle-id: unexpected argument 'next'$"
git tag v1.0 -m "not a cycle tag"
run bin/zcycle-id current
assert_rc 1
assert_err "^zcycle-id: last tag 'v1.0' is not rev"
echo ""

#############################################
# Cases: bin/zheap-death
#############################################

echo "=== Case 6: heap-death on a cycle branch ends on the successor with [direction] on it ==="
fresh_repo hd-cycle
git checkout -q -b cycle/rev1-attempt1
event join
event stuff
run bin/zheap-death tester "first question" 3
assert_rc 1
assert_err '^zheap-death: successor direction requires --cite FILE or --challenge FILE'
BEFORE=$(git rev-parse HEAD)
run bin/zheap-death --cite inherited.md tester "first question" 3
assert_rc 1
assert_err '^zheap-death: --learning TEXT is required: one finding from this cycle'
run bin/zheap-death --cite inherited.md --learning "   " tester "first question" 3
assert_rc 1
assert_err '^zheap-death: --learning TEXT is required'
run bin/zheap-death --cite inherited.md --learning "$(printf 'x%.0s' $(seq 1 501))" tester "first question" 3
assert_rc 1
assert_err '^zheap-death: --learning is 501 characters; keep it to one finding of at most 500$'
assert_eq "refused before any write" "$(git rev-parse HEAD)" "$BEFORE"
assert_eq "no learnings branch yet" "$(git show-ref --verify --quiet refs/heads/learnings && echo yes || echo no)" no
run bin/zheap-death --cite inherited.md --learning "  Fixture rules only bind when zstate replays them.  " tester "first question" 3
assert_rc 0
assert_out_has '^On cycle branch: cycle/rev1-attempt1$'
assert_out_has '^Birthing successor branch: cycle/rev1-attempt2$'
HD=$(git log --format=%H --grep='^\[heap-death\]' -n 1)
assert_eq "current branch" "$(git branch --show-current)" cycle/rev1-attempt2
assert_eq "HEAD is [direction]" "$(git log -1 --format=%s | cut -c1-11)" "[direction]"
assert_eq "[direction] parent is the heap-death" "$(git rev-parse HEAD^)" "$HD"
assert_branch_at cycle/rev1-attempt1 "$HD"
assert_tag_at 'rev1-attempt1-iterations*' "$HD"
assert_eq "[direction] commits on cycle/rev1-attempt1" "$(git rev-list --count --grep='^\[direction\]' cycle/rev1-attempt1)" 0
assert_eq "[direction] commits on cycle/rev1-attempt2" "$(git rev-list --count --grep='^\[direction\]' cycle/rev1-attempt2)" 1
assert_eq "heap-death event branch" "$(git log -1 --format=%b "$HD" | jq -r '.data.branch')" cycle/rev1-attempt1
assert_eq "note on the heap-death" "$(git notes show "$HD" | head -1)" "cycle: rev1 attempt1"
assert_eq "learning in the event, trimmed" "$(git log -1 --format=%b "$HD" | jq -r '.data.learning')" "Fixture rules only bind when zstate replays them."
assert_eq "learning in the note" "$(git notes show "$HD" | grep -c '^learning: Fixture rules only bind when zstate replays them\.$')" 1
assert_eq "learning on the branch" "$(git show learnings:LEARNINGS.md | grep -A2 '^## rev1-attempt1$' | tail -1)" "Fixture rules only bind when zstate replays them."
assert_eq "every turn sees it" "$(bin/zprompt | grep -c '^Latest learning, cycle [0-9]*: Fixture rules only bind when zstate replays them\.$')" 1
assert_eq "action after heap-death" "$(bin/zstate | jq -r .action)" contribute
assert_eq "stuff/ cleared" "$(git ls-files stuff | wc -l | tr -d ' ')" 0
echo ""

echo "=== Case 6b: a second heap-death chains: attempt2 dies, attempt3 is born ==="
event join
mkdir -p stuff
echo "second fixture artifact" > stuff/inherited.md
run bin/zheap-death --cite stuff/inherited.md --learning "A second finding." tester "second question" 2
assert_rc 0
assert_eq "a stuff/ prefix is dropped" "$(git log -1 --format=%b | jq -c '.data.inheritance.cite')" '["inherited.md"]'
assert_eq "both learnings on the branch" "$(git show learnings:LEARNINGS.md | grep -c '^## rev1-attempt[12]$')" 2
event complete
prompt=$(bin/zprompt)
assert_eq "heap-death turn is asked for a learning" "$(printf '%s\n' "$prompt" | grep -c '^Run: bin/zheap-death --cite <stuff-file> --learning "<what this cycle found>"')" 1
assert_eq "and shown the earlier ones, newest first" "$(printf '%s\n' "$prompt" | grep -A2 '^Learnings from recent cycles (newest first):$' | tail -2 | cut -d: -f2- | tr '\n' '|')" " A second finding.| Fixture rules only bind when zstate replays them.|"
HD2=$(git log --format=%H --grep='^\[heap-death\]' -n 1)
assert_eq "current branch" "$(git branch --show-current)" cycle/rev1-attempt3
assert_branch_at cycle/rev1-attempt2 "$HD2"
assert_tag_at 'rev1-attempt2-iterations*' "$HD2"
assert_eq "heap-death event tag" "$(git log -1 --format=%b "$HD2" | jq -r '.data.tag' | cut -d- -f1,2)" rev1-attempt2
assert_eq "tags" "$(git tag | wc -l | tr -d ' ')" 2
echo ""

echo "=== Case 7: heap-death with the batch exhausted births the successor and writes its [direction] ==="
fresh_repo hd-exhausted
git checkout -q -b cycle/rev1-attempt1
event join
mkdir -p stuff
echo "last fixture artifact" > stuff/last.md
git add stuff && git commit -q -m "[stuff] tester: added stuff/last.md"
BEFORE=$(git rev-parse HEAD)
# The successor always exists, so the inheritance gate does not skip at batch 1.
run bin/zheap-death --learning "The last cycle still records what it found." tester "last question" 1
assert_rc 1
assert_err '^zheap-death: successor direction requires --cite FILE or --challenge FILE'
assert_eq "nothing written by the refused heap-death" "$(git rev-parse HEAD)" "$BEFORE"
run bin/zheap-death --cite last.md --learning "The last cycle still records what it found." tester "last question" 1
assert_rc 0
assert_no_err '^WARNING: batch_size'
HD=$(git log --format=%H --grep='^\[heap-death\]' -n 1)
assert_eq "current branch" "$(git branch --show-current)" cycle/rev1-attempt2
assert_eq "heap-death batch_remaining" "$(git log -1 --format=%b "$HD" | jq -c '.data.batch_remaining')" 0
assert_branch_at cycle/rev1-attempt1 "$HD"
assert_eq "[direction] commits" "$(git rev-list --count --grep='^\[direction\]' HEAD)" 1
assert_eq "HEAD is the direction" "$(git log -1 --format=%s | cut -d' ' -f1)" '[direction]'
assert_eq "direction parent is the heap-death" "$(git rev-parse HEAD^)" "$HD"
assert_eq "direction batch_remaining" "$(git log -1 --format=%b | jq -c '.data.batch_remaining')" 0
assert_eq "direction inheritance" "$(git log -1 --format=%b | jq -c '.data.inheritance.cite')" '["last.md"]'
assert_eq "stuff/ cleared by the direction commit" "$(git ls-files stuff | wc -l | tr -d ' ')" 0
assert_eq "successor tree is clean" "$(git status --porcelain | wc -l | tr -d ' ')" 0
assert_eq "action after heap-death" "$(bin/zstate | jq -r .action)" contribute
assert_eq "direction after heap-death" "$(bin/zstate | jq -r .direction)" "last question"
echo ""

echo "=== Case 8: heap-death after save-learning's round trip does not land on learnings ==="
fresh_repo hd-learning
git tag rev1-attempt1-iterations1of1 -m "q"
change_prompt
git checkout -q -b cycle/rev2-attempt1
event join
run bin/zheap-death --cite inherited.md --learning "Learned after a PROMPT.md change." tester "learned question" 3
assert_rc 0
assert_out_has '^Saving learning to learnings branch'
assert_eq "the learning, not PROMPT.md lines" "$(git show learnings:LEARNINGS.md | grep -A2 '^## rev2-attempt1$' | tail -1)" "Learned after a PROMPT.md change."
assert_eq "learnings branch exists" "$(git show-ref --verify --quiet refs/heads/learnings && echo yes)" yes
assert_eq "current branch" "$(git branch --show-current)" cycle/rev2-attempt2
HD=$(git log --format=%H --grep='^\[heap-death\]' -n 1)
assert_branch_at cycle/rev2-attempt1 "$HD"
assert_tag_at 'rev2-attempt1-iterations*' "$HD"
assert_eq "[direction] commits" "$(git rev-list --count --grep='^\[direction\]' HEAD)" 1
echo ""

echo "=== Case 9: heap-death rejects main with no override ==="
fresh_repo hd-main
event join
run bin/zheap-death tester "main question" 3
assert_rc 1
assert_err "^zheap-death: refusing to run on 'main'; run from cycle/"
echo ""

echo "=== Case 10: heap-death refuses a feature branch, accepts a cycle branch ==="
fresh_repo hd-guard
git checkout -q -b feat/scratch
run bin/zheap-death tester "leaked question"
assert_rc 1
assert_err "^zheap-death: refusing to run on 'feat/scratch'"
git checkout -q -b cycle/rev1-attempt1
run bin/zheap-death --cite inherited.md --learning "Allowed." tester "allowed question" 2
assert_rc 0
assert_eq "current branch" "$(git branch --show-current)" cycle/rev1-attempt2
echo ""

echo "=== Case 11: heap-death fails loud, before writing anything, when the successor branch already exists ==="
fresh_repo hd-successor-exists
git checkout -q -b cycle/rev1-attempt1
git branch cycle/rev1-attempt2
event join
BEFORE=$(git rev-parse HEAD)
run bin/zheap-death --cite inherited.md --learning "Blocked." tester "blocked question" 3
assert_rc 1
assert_err '^zheap-death: successor branch cycle/rev1-attempt2 already exists'
assert_eq "current branch" "$(git branch --show-current)" cycle/rev1-attempt1
assert_eq "HEAD unchanged" "$(git rev-parse HEAD)" "$BEFORE"
assert_eq "[heap-death] commits" "$(git rev-list --count --grep='^\[heap-death\]' HEAD)" 0
assert_eq "[direction] commits" "$(git rev-list --count --grep='^\[direction\]' HEAD)" 0
assert_eq "tags" "$(git tag | wc -l | tr -d ' ')" 0
assert_eq "staged changes" "$(git diff --cached --name-only | wc -l | tr -d ' ')" 0
echo ""

#############################################
# Cases: bin/zloop preflight
#############################################

echo "=== Case 12: zloop on main checks out cycle/rev{N}-attempt{M} at birth ==="
fresh_repo loop-main
git tag rev5-attempt2-iterations1of1 -m "q"
run bin/zloop --quiet --max 1
assert_rc 1
assert_err '^\[zloop\] Branch: cycle/rev5-attempt3 \(from main\)$'
assert_eq "current branch" "$(git branch --show-current)" cycle/rev5-attempt3
assert_eq "main untouched" "$(git rev-parse main)" "$(git rev-parse cycle/rev5-attempt3)"
echo ""

echo "=== Case 13: zloop already on a cycle branch stays there ==="
fresh_repo loop-cycle
git checkout -q -b cycle/rev9-attempt9
run bin/zloop --quiet --max 1
assert_rc 1
assert_no_err '^\[zloop\] Branch:'
assert_eq "current branch" "$(git branch --show-current)" cycle/rev9-attempt9
assert_eq "cycle/* branches" "$(git branch --list 'cycle/*' | wc -l | tr -d ' ')" 1
echo ""

echo "=== Case 14: the preflight always creates a cycle branch ==="
fresh_repo loop-opt-out
run bin/zloop --quiet --max 1
assert_rc 1
assert_err '^\[zloop\] Branch: cycle/rev1-attempt1 \(from main\)$'
assert_eq "current branch" "$(git branch --show-current)" cycle/rev1-attempt1
echo ""

echo "=== Case 15: zloop fails loud when the derived branch already exists ==="
fresh_repo loop-exists
git branch cycle/rev1-attempt1
run bin/zloop --quiet --max 1
assert_rc 2
assert_err '^zloop: cycle/rev1-attempt1 already exists; check it out to resume it \(or bin/zloop --resume "<reason>" if a run stopped on it\)$'
assert_eq "current branch" "$(git branch --show-current)" main
echo ""

#############################################
# Fixtures: an origin, a fake gh, a fake turn
#############################################

# Fake gh: pull requests against the bare origin, one state file per PR
# ("<head> <base> open|merged"). `pr merge` merges with a merge commit, as
# GitHub's merge button does; FAKE_GH_MERGE_FAIL=1 refuses it. Every call is
# logged to FAKE_GH_LOG.
mkdir -p "$TMP/fakegh"
cat > "$TMP/fakegh/gh" << 'EOF'
#!/bin/bash
echo "gh $*" >> "$FAKE_GH_LOG"
mkdir -p "$FAKE_GH_STATE"
sub="$1 $2"
shift 2
args=("$@")
head="" base=""
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    --head) head="${args[i+1]}" ;;
    --base) base="${args[i+1]}" ;;
  esac
done
case "$sub" in
  "pr list")
    for f in "$FAKE_GH_STATE"/*; do
      [[ -f "$f" ]] || continue
      read -r h b s < "$f"
      if [[ "$h" == "$head" && "$b" == "$base" && "$s" == open ]]; then basename "$f"; fi
    done
    exit 0 ;;
  "pr create")
    n=$(( $(find "$FAKE_GH_STATE" -type f | wc -l) + 1 ))
    echo "$head $base open" > "$FAKE_GH_STATE/$n"
    echo "https://example.invalid/pull/$n"
    exit 0 ;;
  "pr merge")
    [[ "${FAKE_GH_MERGE_FAIL:-0}" == 1 ]] && { echo "fake gh: merge refused" >&2; exit 1; }
    read -r h b s < "$FAKE_GH_STATE/${args[0]}"
    export GIT_DIR="$FAKE_GH_ORIGIN" GIT_AUTHOR_NAME=fakegh GIT_AUTHOR_EMAIL=gh@example.invalid \
      GIT_COMMITTER_NAME=fakegh GIT_COMMITTER_EMAIL=gh@example.invalid
    tree=$(git merge-tree --write-tree "refs/heads/$b" "refs/heads/$h") || exit 1
    c=$(git commit-tree --no-gpg-sign "$tree" -p "refs/heads/$b" -p "refs/heads/$h" -m "Merge pull request #${args[0]} from $h")
    git update-ref "refs/heads/$b" "$c"
    echo "$h $b merged" > "$FAKE_GH_STATE/${args[0]}"
    exit 0 ;;
  "workflow run") exit 0 ;;
esac
echo "fake gh: unsupported: $sub" >&2
exit 1
EOF
chmod +x "$TMP/fakegh/gh"

# Fake turn: claude that (FAKE_TURN_DEV=1) first lands a commit on origin's
# main from a second clone, as a dev PR merged mid-run would, then commits a
# [join] or a [heap-death] event (FAKE_TURN).
mkdir -p "$TMP/faketurn"
cat > "$TMP/faketurn/claude" << 'EOF'
#!/bin/bash
echo "fake claude ran"
if [[ "${FAKE_TURN_DEV:-0}" == 1 ]]; then
  (cd "$FAKE_DEV_CLONE" && echo "fix $RANDOM" >> dev.txt && git add dev.txt \
    && git commit -q -m "Fix a tool on main mid-run" && git push -q origin main) >/dev/null 2>&1
fi
case "${FAKE_TURN:-}" in
  join) bin/zevent join fake "synthetic join" '{}' >/dev/null 2>&1 ;;
  heap-death) bin/zevent heap-death fake "synthetic heap-death" '{"batch_remaining":2}' >/dev/null 2>&1 ;;
esac
exit 0
EOF
chmod +x "$TMP/faketurn/claude"

# origin_repo <name>: fresh_repo with bin/ committed, a bare origin holding
# main, and a second clone of it (DEV) to land commits on origin's main.
origin_repo() {
  fresh_repo "$1"
  ORIGIN="$TMP/origin-$1.git"
  DEV="$TMP/dev-$1"
  printf '.claude/\n.zociety/\n' > .gitignore
  git add -A
  git commit -q -m "fixture bin"
  git init -q --bare "$ORIGIN"
  git remote add origin "$ORIGIN"
  git push -q origin main
  git clone -q "$ORIGIN" "$DEV" 2>/dev/null
  git -C "$DEV" config user.name dev
  git -C "$DEV" config user.email dev@example.com
  git -C "$DEV" config commit.gpgsign false
  git -C "$DEV" config core.hooksPath "$TMP/nohooks"
  export FAKE_GH_ORIGIN="$ORIGIN" FAKE_GH_STATE="$TMP/ghstate-$1" FAKE_GH_LOG="$TMP/ghlog-$1"
  : > "$FAKE_GH_LOG"
}

# dev_commit <file> <text>: a commit on origin's main from DEV
dev_commit() {
  (cd "$DEV" && git pull -q origin main 2>/dev/null; echo "$2" >> "$1" && git add "$1" \
    && git commit -q -m "dev: $1" && git push -q origin main)
}

# no_agent_note <sha>: no bin/zblind seal covered it
assert_unsealed() {
  if git notes --ref=agent show "$1" >/dev/null 2>&1; then
    fail "${1:0:7} carries an agent note (sealed as a turn's commit)"
  else
    pass "${1:0:7} carries no agent note"
  fi
}

assert_sealed() {
  if git notes --ref=agent show "$1" 2>/dev/null | grep -q '^kind: ai$'; then
    pass "${1:0:7} sealed as a turn's commit"
  else
    fail "${1:0:7} carries no kind: ai note"
  fi
}

#############################################
# Cases: landing a cycle on main
#############################################

echo "=== Case 16: heap-death lands the cycle on main with a merge commit ==="
origin_repo hd-land
git checkout -q -b cycle/rev1-attempt1
event join
run env PATH="$TMP/fakegh:$PATH" ZPR_MERGE_WAIT=0 \
  bin/zheap-death --cite inherited.md --learning "Landed cycles keep main current." tester "landing question" 3
assert_rc 0
HD=$(git log --format=%H --grep='^\[heap-death\]' -n 1)
assert_out_has '^  cycle/rev1-attempt1 is on main$'
ORIGIN_MAIN=$(git --git-dir="$ORIGIN" rev-parse refs/heads/main)
assert_eq "origin's main is a merge" "$(git --git-dir="$ORIGIN" rev-list --count --min-parents=2 -n 1 "$ORIGIN_MAIN")" 1
assert_eq "its second parent is the heap-death" "$(git --git-dir="$ORIGIN" rev-parse "$ORIGIN_MAIN^2")" "$HD"
assert_eq "merged as a merge commit" "$(grep -c '^gh pr merge 1 --merge$' "$FAKE_GH_LOG")" 1
assert_eq "no rebuild request (the merge pushed main)" "$(grep -c '^gh workflow run' "$FAKE_GH_LOG")" 0
assert_eq "current branch" "$(git branch --show-current)" cycle/rev1-attempt2
assert_eq "one learning block" "$(git show learnings:LEARNINGS.md | grep -c '^## rev1-attempt1$')" 1
echo ""

echo "=== Case 17: a refused merge leaves the PR open and asks for the rebuild ==="
origin_repo hd-refused
git checkout -q -b cycle/rev1-attempt1
event join
BEFORE_MAIN=$(git --git-dir="$ORIGIN" rev-parse refs/heads/main)
run env PATH="$TMP/fakegh:$PATH" ZPR_MERGE_WAIT=0 FAKE_GH_MERGE_FAIL=1 \
  bin/zheap-death --cite inherited.md --learning "Refused." tester "refused question" 3
assert_rc 0
assert_out_has '^  cycle/rev1-attempt1 is not on main; its PR stays open$'
assert_eq "origin's main unchanged" "$(git --git-dir="$ORIGIN" rev-parse refs/heads/main)" "$BEFORE_MAIN"
assert_eq "three merge attempts" "$(grep -c '^gh pr merge 1 --merge$' "$FAKE_GH_LOG")" 3
assert_eq "rebuild requested" "$(grep -c '^gh workflow run pages.yml --ref main$' "$FAKE_GH_LOG")" 1
assert_eq "PR open" "$(cat "$FAKE_GH_STATE/1")" "cycle/rev1-attempt1 main open"
assert_eq "current branch" "$(git branch --show-current)" cycle/rev1-attempt2
echo ""

echo "=== Case 18: ZPR_MERGE=0 opens the PR only ==="
origin_repo hd-open-only
git checkout -q -b cycle/rev1-attempt1
event join
run env PATH="$TMP/fakegh:$PATH" ZPR_MERGE=0 \
  bin/zheap-death --cite inherited.md --learning "Opened only." tester "open question" 3
assert_rc 0
assert_eq "PR opened" "$(grep -c '^gh pr create --head cycle/rev1-attempt1 --base main' "$FAKE_GH_LOG")" 1
assert_eq "no merge" "$(grep -c '^gh pr merge' "$FAKE_GH_LOG")" 0
assert_out_has '^  cycle/rev1-attempt1 is not on main; its PR stays open$'
echo ""

echo "=== Case 19: a heap-death whose commit fails writes no learning ==="
fresh_repo hd-commit-fails
git checkout -q -b cycle/rev1-attempt1
event join
mkdir -p "$TMP/failhooks"
printf '#!/bin/sh\necho "fixture hook refuses" >&2\nexit 1\n' > "$TMP/failhooks/pre-commit"
chmod +x "$TMP/failhooks/pre-commit"
git config core.hooksPath "$TMP/failhooks"
BEFORE=$(git rev-parse HEAD)
run bin/zheap-death --cite inherited.md --learning "Written once." tester "retry question" 3
assert_rc 1
assert_eq "HEAD unchanged" "$(git rev-parse HEAD)" "$BEFORE"
assert_eq "no learnings branch" "$(git show-ref --verify --quiet refs/heads/learnings && echo yes || echo no)" no
git config core.hooksPath "$TMP/nohooks"
git reset -q
run bin/zheap-death --cite inherited.md --learning "Written once." tester "retry question" 3
assert_rc 0
assert_eq "the retry writes the block once" "$(git show learnings:LEARNINGS.md | grep -c '^## rev1-attempt1$')" 1
echo ""

#############################################
# Cases: the run merges main into the cycle branch
#############################################

echo "=== Case 20: zloop merges origin/main before the first turn, outside the turn's seal ==="
origin_repo sync-start
git checkout -q -b cycle/rev1-attempt1
event join
dev_commit dev.txt "a fix landed on main"
DEV_SHA=$(git --git-dir="$ORIGIN" rev-parse refs/heads/main)
run env -u ZOCIETY_BLIND_KEY PATH="$TMP/faketurn:$PATH" FAKE_TURN=join bin/zloop --quiet --max 1
assert_rc 1
assert_err '^\[zloop\] Merged origin/main into cycle/rev1-attempt1 before the first turn \(1 commit\(s\) from main\)$'
assert_eq "HEAD is the turn's [join]" "$(git log -1 --format=%s | cut -c1-6)" "[join]"
assert_eq "its parent is the merge" "$(git log -1 --format=%s HEAD^)" "Merge origin/main into cycle/rev1-attempt1"
assert_eq "main's commit is in the branch" "$(git rev-parse HEAD^^2)" "$DEV_SHA"
assert_eq "main's file is checked out" "$(cat dev.txt)" "a fix landed on main"
assert_sealed "$(git rev-parse HEAD)"
assert_unsealed "$(git rev-parse HEAD^)"
assert_unsealed "$DEV_SHA"
echo ""

echo "=== Case 21: zloop merges origin/main after a heap-death turn, not into the turn's seal ==="
origin_repo sync-death
git checkout -q -b cycle/rev1-attempt1
event join
run env -u ZOCIETY_BLIND_KEY PATH="$TMP/faketurn:$PATH" FAKE_TURN=heap-death FAKE_TURN_DEV=1 \
  FAKE_DEV_CLONE="$DEV" bin/zloop --quiet --max 1
assert_rc 1
assert_no_err 'before the first turn'
assert_err '^\[zloop\] Merged origin/main into cycle/rev1-attempt1 after the heap-death \(1 commit\(s\) from main\)$'
DEV_SHA=$(git --git-dir="$ORIGIN" rev-parse refs/heads/main)
assert_eq "HEAD is the merge" "$(git log -1 --format=%s)" "Merge origin/main into cycle/rev1-attempt1"
assert_eq "first parent is the heap-death" "$(git log -1 --format=%s HEAD^1 | cut -c1-12)" "[heap-death]"
assert_eq "second parent is main" "$(git rev-parse HEAD^2)" "$DEV_SHA"
assert_sealed "$(git rev-parse HEAD^1)"
assert_unsealed "$(git rev-parse HEAD)"
assert_unsealed "$DEV_SHA"
# A heap-death that reached main from another lineage, merged in later, is
# not this run's: the counts walk first parents.
RUN_START=$(git rev-parse HEAD^1^)
(cd "$DEV" && git commit -q --allow-empty -m "[heap-death] other: another lineage's cycle" && git push -q origin main)
git fetch -q origin main
git merge -q --no-edit -m "Merge origin/main into cycle/rev1-attempt1" refs/remotes/origin/main
mkdir -p .zociety
printf 'start: %s\nmode: budget\n' "$RUN_START" > .zociety/zloop.state
run env -u ZSTOP_BUDGET bin/zstop-budget
assert_out "CONTINUE: budget heap-deaths=1/3 action=contribute"
run bin/zstop-feedback
assert_out "CONTINUE: feedback done=false in $(git rev-parse --short=7 HEAD^1^1)"
rm -f .zociety/zloop.state
echo ""

echo "=== Case 22: ZLOOP_SYNC_MAIN=0 leaves the branch alone; a conflict is aborted ==="
origin_repo sync-off
git checkout -q -b cycle/rev1-attempt1
event join
dev_commit dev.txt "not wanted"
BEFORE=$(git rev-parse HEAD)
run env -u ZOCIETY_BLIND_KEY ZLOOP_SYNC_MAIN=0 bin/zloop --quiet --max 1
assert_rc 1
assert_no_err 'Merged origin/main'
assert_eq "HEAD unchanged" "$(git rev-parse HEAD)" "$BEFORE"
echo "cycle side" >> PROMPT.md
git commit -q -am "cycle edits PROMPT.md"
dev_commit PROMPT.md "main side"
BEFORE=$(git rev-parse HEAD)
run env -u ZOCIETY_BLIND_KEY bin/zloop --quiet --max 1
assert_rc 1
assert_err '^\[zloop\] WARNING: origin/main does not merge cleanly into cycle/rev1-attempt1 before the first turn; the branch stays as it is \(merge main by hand\)$'
assert_eq "HEAD unchanged" "$(git rev-parse HEAD)" "$BEFORE"
assert_eq "no merge in progress" "$(test -e .git/MERGE_HEAD && echo yes || echo no)" no
assert_eq "tree clean" "$(git status --porcelain | wc -l | tr -d ' ')" 0
echo ""

#############################################
# Cases: bin/zobjects
#############################################

echo "=== Case 23: zobjects gives hard-linked objects their own copy and drops a stale lock ==="
fresh_repo objects
git add -A
git commit -q -m "fixture bin"
git clone -q "$REPO" "$TMP/linked-clone" 2>/dev/null
linked=$(find .git/objects -type f -links +1 | wc -l | tr -d ' ')
assert_eq "the local clone hard-linked objects" "$([[ $linked -gt 0 ]] && echo yes || echo "no ($linked)")" yes
run bin/zobjects --check
assert_rc 1
assert_out_has "^zobjects: $linked object file\(s\) share a hard link with a copy outside this repo$"
run bin/zobjects
assert_rc 0
assert_out_has "^zobjects: gave $linked hard-linked object file\(s\) their own copy"
assert_eq "no file under objects/ has a second link" "$(find .git/objects -type f -links +1 | wc -l | tr -d ' ')" 0
assert_eq "fsck" "$(git fsck --no-dangling 2>&1 | grep -c . || true)" 0
assert_eq "the clone still reads" "$(git -C "$TMP/linked-clone" log -1 --format=%s)" "fixture bin"
touch -t 202601010000 .git/objects/maintenance.lock
run bin/zobjects
assert_rc 0
assert_out_has '^zobjects: removed .*maintenance\.lock, left by an auto-gc that died over an hour ago$'
touch .git/objects/maintenance.lock
run bin/zobjects --check
assert_rc 0
assert_eq "a fresh lock stays" "$(test -e .git/objects/maintenance.lock && echo yes)" yes
rm -f .git/objects/maintenance.lock
echo ""

#############################################
# Summary
#############################################

echo "=== Results: $PASSED passed, $FAILED failed ==="
if [[ $FAILED -gt 0 ]]; then
  exit 1
fi
echo "All cycle identity cases passed."
