#!/usr/bin/env bash
# zloop - Zociety's autonomous loop with dynamic completion checking
#
# Usage:
#   bin/zloop [options] [max-iterations]
#
# Options:
#   -n, --max N        Max iterations (default: 60; positional N also accepted)
#   -t, --timeout N    Timeout per iteration in seconds (default: 300)
#   -s, --stop LIST    Stop modes, comma-separated (default: action)
#                      Modes: action, budget, converge, feedback, file
#                      e.g. --stop action,file  or  --stop budget,converge,file
#   -q, --quiet        Buffered output: nothing until claude's result arrives
#   -v, --verbose      Raw stream-json events, partial messages included
#   -d, --debug        Enable debug output
#   -h, --help         Show this help
#
# Environment (flags override these):
#   ZLOOP_TIMEOUT=300       Timeout per iteration in seconds
#   ZLOOP_STOP=action       Stop modes, comma-separated (see --stop)
#   ZLOOP_DEBUG=1           Enable debug output
#   ZLOOP_QUIET=1           Same as --quiet
#   ZLOOP_VERBOSE=1         Same as --verbose
#   ZLOOP_BACKOFF_MAX=300   Cap on the sleep after consecutive claude failures
#   ZLOOP_KILL_GRACE=10     Seconds to wait for the agent to exit on Ctrl-C
#                           before it is killed outright
#   ZLOOP_BRANCH=0          Skip the cycle-branch preflight and run on whatever
#                           branch is checked out (main needs ALLOW_MAIN=1)
#   ZSTOP_*                 Per-mode knobs; see bin/zstop-<mode> --help
#
# Identity at birth: unless ZLOOP_BRANCH=0, a run started on a branch that is
# not cycle/* derives its first cycle's name (bin/zcycle-id current: last tag,
# attempt+1, or rev+1 if PROMPT.md changed) and checks out
# cycle/rev{N}-attempt{M} before the first iteration. Cut no branch by hand;
# the run names itself. bin/zheap-death births each later cycle's branch
# (attempt+1) at death, so this covers only the first cycle of a run. To bump
# rev, check out cycle/rev{N+1}-attempt1 yourself before starting.
#
# Output discipline:
#   stdout  claude's result only (safe to redirect to a file)
#   stderr  loop chrome: headers, state, timing, warnings; by default also
#           the live render from bin/zrender (HUD line per iteration, one
#           line per tool call, heartbeat, cost footer, run totals)
#
# Stopping: Ctrl-C (SIGINT), SIGTERM or SIGHUP ends the run at once: the
# agent gets SIGTERM, then SIGKILL after ZLOOP_KILL_GRACE seconds, the state
# file is removed and zloop exits 128+signal (130 for Ctrl-C). For a graceful
# stop between iterations use the file stop mode (--stop file, .claude/STOP).
#
# Runs Claude Code iterations until bin/zloop-complete returns 0. The resolved
# stop-mode list is passed to it as the argument; it runs bin/zstop-<mode> for
# each name (exit 0 stop, 1 continue, 2 abort the loop). --max and the timeout
# are unconditional safety caps, not modes; the predicates get to see the
# result of the final permitted iteration before --max ends the run.
# Each iteration reads PROMPT.md and follows instructions.
# State persists in git between iterations; .claude/zloop.state carries
# iteration/max/start/mode for zheap-death and the predicates.

set -euo pipefail

PROMPT="Read PROMPT.md and follow its instructions."
MAX_ITERATIONS=60
TIMEOUT_SECS="${ZLOOP_TIMEOUT:-300}"
STOP_MODES="${ZLOOP_STOP:-action}"
DEBUG="${ZLOOP_DEBUG:-0}"
# Render level handed to bin/zagent --render: compact (default), text
# (--quiet) or raw (--verbose).
RENDER="compact"
[[ "${ZLOOP_VERBOSE:-0}" == "1" ]] && RENDER="raw"
[[ "${ZLOOP_QUIET:-0}" == "1" ]] && RENDER="text"
BACKOFF_MAX="${ZLOOP_BACKOFF_MAX:-300}"
KILL_GRACE="${ZLOOP_KILL_GRACE:-10}"
BACKOFF_BASE=1

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

log() { echo "$*" >&2; }

debug() {
  if [[ "$DEBUG" == "1" ]]; then
    log "[debug] $*"
  fi
}

die() {
  log "zloop: $*"
  log "Try 'bin/zloop --help'."
  exit 2
}

require_int() {
  [[ "$2" =~ ^[0-9]+$ ]] || die "$1 expects a non-negative integer, got '$2'"
}

positional_seen=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -v|--verbose)
      RENDER="raw"
      ;;
    -q|--quiet)
      RENDER="text"
      ;;
    -d|--debug)
      DEBUG=1
      ;;
    -n|--max|--max-iterations)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      require_int "$1" "$2"
      MAX_ITERATIONS="$2"
      shift
      ;;
    -t|--timeout)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      require_int "$1" "$2"
      TIMEOUT_SECS="$2"
      shift
      ;;
    -s|--stop)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      STOP_MODES="$2"
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option '$1'"
      ;;
    *)
      [[ $positional_seen -eq 0 ]] || die "unexpected argument '$1'"
      require_int "max-iterations" "$1"
      MAX_ITERATIONS="$1"
      positional_seen=1
      ;;
  esac
  shift
done
[[ $# -eq 0 ]] || die "unexpected argument '$1'"

require_int "ZLOOP_TIMEOUT" "$TIMEOUT_SECS"
require_int "ZLOOP_BACKOFF_MAX" "$BACKOFF_MAX"
require_int "ZLOOP_KILL_GRACE" "$KILL_GRACE"
[[ "$STOP_MODES" =~ ^[a-z][a-z0-9_-]*(,[a-z][a-z0-9_-]*)*$ ]] \
  || die "--stop/ZLOOP_STOP expects a comma-separated list of mode names, got '$STOP_MODES'"
for _mode in ${STOP_MODES//,/ }; do
  [[ -x "bin/zstop-$_mode" ]] || die "unknown stop mode '$_mode' (no executable bin/zstop-$_mode)"
done

# Identity at birth (see header): name the first cycle and check out its
# branch when not already on a cycle branch. Satisfies the no-main-commits
# hook by the naming step. A successor that already exists is an operator
# decision (resume it, or delete it), not something to guess at.
if [[ "${ZLOOP_BRANCH:-1}" != "0" ]]; then
  current_branch=$(git branch --show-current)
  if [[ ! "$current_branch" =~ ^cycle/ ]]; then
    cycle_branch=$(bin/zcycle-id --branch current) || die "bin/zcycle-id failed"
    if git show-ref --verify --quiet "refs/heads/$cycle_branch"; then
      die "$cycle_branch already exists; check it out to resume it, delete it, or set ZLOOP_BRANCH=0"
    fi
    git checkout -b "$cycle_branch" --quiet
    log "[zloop] Branch: $cycle_branch (from ${current_branch:-detached HEAD})"
  fi
fi

# Captured once so predicates can scope their queries to this run
# (e.g. heap-deaths in start..HEAD). Rewritten into zloop.state every
# iteration because zheap-death deletes the file when it archives.
START_SHA=$(git rev-parse HEAD)

# Per-iteration metrics from bin/zrender's result footer (compact mode only),
# summed into the run totals on every exit path.
METRICS_FILE=$(mktemp "${TMPDIR:-/tmp}/zloop-metrics.XXXXXX")
if [[ "$RENDER" == "compact" ]]; then
  export ZRENDER_METRICS="$METRICS_FILE"
fi

# Remove the loop-state file on any exit (signal, abort, normal finish)
# instead of leaving a stale state file behind.
trap 'rm -f .zociety/zloop.state .claude/zloop.state "$METRICS_FILE"' EXIT

# print_totals: "[zloop] Totals: 3 iterations · duration 12m03s · turns 51 · $3.20"
# from the metrics file; silent when no result event was rendered.
print_totals() {
  [[ -s "$METRICS_FILE" ]] || return 0
  LC_NUMERIC=C awk '
    { n++; ms += $1; turns += $2; cost += $3 }
    END {
      s = int(ms / 1000)
      if (s >= 60) d = sprintf("%dm%02ds", int(s / 60), s % 60); else d = s "s"
      printf "[zloop] Totals: %d iteration%s · duration %s · turns %d · $%.2f\n", \
        n, (n == 1 ? "" : "s"), d, turns, cost
    }' "$METRICS_FILE" >&2
}

# Interrupt handling (issue #11). The agent runs as a background job and the
# loop `wait`s on it: bash runs a trap the moment `wait` returns, whereas a
# foreground child would defer the trap until that child exited. That mattered
# because `timeout` puts the agent in its own process group, so a terminal
# Ctrl-C reached only this script; bash then sat in the foreground wait until
# claude finished on its own and started the next iteration. On INT/TERM/HUP
# the agent gets SIGTERM (timeout forwards it to the whole group), then
# SIGKILL after KILL_GRACE seconds, and zloop exits 128+signal.
AGENT_PID=""

on_signal() {
  local sig="$1" num="$2" waited=0 pid
  trap '' INT TERM HUP
  log ""
  log "[zloop] Caught SIG$sig; stopping agent"
  pid="${AGENT_PID:-$(jobs -p | head -n1)}"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
    while kill -0 "$pid" 2>/dev/null && [[ $waited -lt $KILL_GRACE ]]; do
      sleep 1
      waited=$((waited + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      log "[zloop] Agent still running after ${KILL_GRACE}s; sending SIGKILL"
      # timeout made the agent a group leader; kill the group when there is
      # one (grandchildren included), else just the pid.
      kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  fi
  log "=== Loop Interrupted (SIG$sig) ==="
  print_totals
  exit $((128 + num))
}
trap 'on_signal INT 2' INT
trap 'on_signal TERM 15' TERM
trap 'on_signal HUP 1' HUP

# `timeout` (GNU or BusyBox) caps an iteration; without it (stock macOS) the
# iteration runs unbounded, as before.
TIMEOUT_CMD=()
if command -v timeout &>/dev/null; then
  TIMEOUT_CMD=(timeout "$TIMEOUT_SECS")
fi

# interruptible_sleep N: a foreground `sleep` would delay a trapped SIGTERM
# (or a SIGHUP) until it returned; a background one lets `wait` return now.
interruptible_sleep() {
  sleep "$1" &
  wait $! || true
}

ITERATION=0
FAILURES=0

log "=== Zociety Loop ($(date '+%H:%M:%S')) ==="
log "Max iterations: $MAX_ITERATIONS"
log "Timeout per iteration: ${TIMEOUT_SECS}s"
log "Stop modes: $STOP_MODES"
log "Start: $START_SHA"
case "$RENDER" in
  raw)  log "Verbose: raw stream-json events" ;;
  text) log "Quiet: buffered agent output" ;;
esac
[[ "$DEBUG" == "1" ]] && log "Debug mode: enabled"
log ""

while true; do
  ITERATION=$((ITERATION + 1))

  # Write state for zheap-death and the stop predicates to read. All keys go
  # every iteration: the file is rewritten here and deleted by zheap-death.
  mkdir -p .zociety .claude
  cat > .zociety/zloop.state << EOF
iteration: $ITERATION
max: $MAX_ITERATIONS
start: $START_SHA
mode: $STOP_MODES
EOF
  cp .zociety/zloop.state .claude/zloop.state 2>/dev/null || true

  # Check completion BEFORE each iteration. The dispatcher's exit code is
  # three-valued: 0 stop, 2 abort (bad mode name or predicate error), anything
  # else continue. A plain `if` would swallow the abort as "continue".
  debug "Checking if loop should complete (modes: $STOP_MODES)..."
  stop_status=0
  bin/zloop-complete "$STOP_MODES" >&2 || stop_status=$?
  case "$stop_status" in
    0)
      log ""
      log "=== Loop Complete ==="
      log "Iterations: $((ITERATION - 1))"
      print_totals
      bin/zstate | jq '{action, phase, genesis}' >&2
      exit 0
      ;;
    2)
      log ""
      log "=== Loop Aborted ==="
      log "zloop-complete exited 2 (modes: $STOP_MODES); see message above"
      print_totals
      exit 2
      ;;
  esac

  # Safety cap: iteration limit. Unconditional (no mode can disable it), but
  # checked after the predicates so a run whose last permitted iteration
  # finished the work exits 0 "Loop Complete", not 1 "Max Iterations Reached".
  if [[ $ITERATION -gt $MAX_ITERATIONS ]]; then
    log ""
    log "=== Max Iterations Reached ==="
    log "Stopped after $MAX_ITERATIONS iterations"
    print_totals
    bin/zstate | jq '{action, phase, genesis}' >&2
    exit 1
  fi

  log ""
  log "=== Iteration $ITERATION/$MAX_ITERATIONS ($(date '+%H:%M:%S')) ==="
  if [[ "$RENDER" == "compact" ]]; then
    # HUD line: iter 2/5 · cycle 36 · contribute · members 1 rules 0 stuff 1 · stop=action
    bin/zstate | jq -r --arg it "$ITERATION/$MAX_ITERATIONS" --arg stop "$STOP_MODES" \
      '"iter \($it) · cycle \(.cycle) · \(.action) · members \(.genesis.members) rules \(.genesis.rules) stuff \(.genesis.stuff) · stop=\($stop)"' >&2
  else
    bin/zstate | jq -c '{action, phase}' >&2
  fi
  log ""
  iter_start=$SECONDS

  # Build agent runner arguments
  AGENT_ARGS=(--render "$RENDER")
  if [[ -n "${ZOCIETY_AGENT_CLIENT:-}" ]]; then
    AGENT_ARGS+=("--client" "$ZOCIETY_AGENT_CLIENT")
  fi
  AGENT_ARGS+=("$PROMPT")

  debug "Running: bin/zagent ${AGENT_ARGS[*]}"

  # Run one agent iteration. bin/zagent's stdout stays on stdout (the work
  # product); its stderr stays on stderr. A non-zero exit never ends the loop.
  # </dev/null closes stdin so the agent never waits for interactive input.
  # Background + wait rather than a foreground child: see on_signal above.
  exit_code=0
  [[ ${#TIMEOUT_CMD[@]} -gt 0 ]] && debug "Using timeout wrapper (${TIMEOUT_SECS}s)"
  ${TIMEOUT_CMD[@]+"${TIMEOUT_CMD[@]}"} bin/zagent "${AGENT_ARGS[@]}" </dev/null &
  AGENT_PID=$!
  wait "$AGENT_PID" || exit_code=$?
  AGENT_PID=""

  log "[zloop] Iteration $ITERATION finished in $((SECONDS - iter_start))s (exit $exit_code)"

  # Fixed 1s pause on success. On consecutive non-zero exits (rate limits,
  # transient API errors) back off exponentially instead of hammering every
  # second: 2s, 4s, 8s ... capped at BACKOFF_MAX. A timeout (124) means the agent
  # was working, not refused, so it does not count toward backoff.
  if [[ $exit_code -eq 0 ]]; then
    FAILURES=0
    delay=$BACKOFF_BASE
  elif [[ $exit_code -eq 124 ]]; then
    log "[zloop] Iteration timed out after ${TIMEOUT_SECS}s"
    delay=$BACKOFF_BASE
  else
    FAILURES=$((FAILURES + 1))
    if [[ $FAILURES -lt 20 ]]; then
      delay=$((BACKOFF_BASE << FAILURES))
    else
      delay=$BACKOFF_MAX
    fi
    [[ $delay -gt $BACKOFF_MAX ]] && delay=$BACKOFF_MAX
    log "[zloop] zagent exited $exit_code ($FAILURES consecutive); backing off ${delay}s"
  fi

  debug "Iteration $ITERATION complete, sleeping ${delay}s..."
  interruptible_sleep "$delay"
done
