#!/bin/bash
# save-learning: Persist insights to orphan branch
# Usage: bin/save-learning "rev21" "Key insight from this cycle"
#
# Appends the insight to LEARNINGS.md on the orphan branch `learnings`
# WITHOUT checking it out: the new file is hashed as a blob, wrapped in a
# one-entry tree, committed with `git commit-tree` on top of the current
# branch tip and the ref is advanced with `git update-ref` (compare-and-swap
# against the tip we read). The working tree, index and current branch are
# never touched, so this is safe on the host through bin/shims/git (where a
# checkout of `learnings` would remove bin/ and strand the caller) and
# inside the container alike. Plumbing runs no hooks, so the branch's
# missing .pre-commit-config.yaml is irrelevant.
#
# Container constraints shape the plumbing: stdin does not reach the
# container and only a fixed env list is forwarded (bin/zociety), so no
# `hash-object --stdin`, `mktree`, `update-index --index-info` or
# GIT_INDEX_FILE. Everything goes through files under .zociety/ (gitignored,
# inside the worktree the container mounts) and the tree object is written
# raw (`hash-object -t tree`, which validates it).
#
# Exit status is non-zero, and the insight is echoed to stderr, whenever the
# learning was NOT committed. The caller must not assume success.

set -e

REV="${1:-unknown}"
INSIGHT="${2:-no insight provided}"
BRANCH="learnings"
REF="refs/heads/$BRANCH"
FILE="LEARNINGS.md"

fail() {
  echo "save-learning: $*" >&2
  echo "save-learning: learning for $REV was NOT saved. Insight:" >&2
  printf '%s\n' "$INSIGHT" >&2
  exit 1
}

# Relative paths below must resolve both on the host and in the container
# (which mounts the worktree at /repo), so work from the worktree root.
TOP=$(git rev-parse --show-toplevel) || fail "not inside a git worktree"
cd "$TOP" || fail "cannot cd to $TOP"

[[ "$(git rev-parse --show-object-format)" == sha1 ]] \
  || fail "only sha1 repositories are supported (raw tree layout)"

TMPDIR_REL=".zociety"
BLOB_FILE="$TMPDIR_REL/learnings.$$.md"
TREE_FILE="$TMPDIR_REL/learnings.$$.tree"
mkdir -p "$TMPDIR_REL" || fail "cannot create $TMPDIR_REL"
trap 'rm -f "$BLOB_FILE" "$TREE_FILE"' EXIT

# Current tip and content. An empty PARENT means the branch does not exist
# yet: seed the file with its header and commit with no parent.
PARENT=$(git rev-parse -q --verify "$REF" || true)
# A fresh clone has origin/learnings but no local branch: build on the
# remote tip so a later push does not diverge. The compare-and-swap below
# still passes the local tip ("" = must not exist), which creates the ref.
CAS_OLD="$PARENT"
if [[ -z "$PARENT" ]]; then
  PARENT=$(git rev-parse -q --verify "refs/remotes/origin/$BRANCH" || true)
fi
if [[ -n "$PARENT" ]]; then
  git show "$PARENT:$FILE" > "$BLOB_FILE" \
    || fail "git show $PARENT:$FILE failed"
else
  {
    echo "# Zociety Learnings"
    echo ""
    echo "Insights preserved across cycles. Each cycle adds, nothing deleted."
    echo ""
  } > "$BLOB_FILE" || fail "cannot write $BLOB_FILE"
fi

# Append the new learning
{
  echo "---"
  echo ""
  echo "## $REV"
  echo ""
  printf '%s\n' "$INSIGHT"
  echo ""
} >> "$BLOB_FILE" || fail "cannot write $BLOB_FILE"

BLOB=$(git hash-object -w "$BLOB_FILE") || fail "git hash-object (blob) failed"
BLOB=${BLOB//$'\r'/}  # a pty on the container hop (podman exec -t) leaves a CR
[[ "$BLOB" =~ ^[0-9a-f]{40}$ ]] || fail "unexpected blob id '$BLOB'"

# Raw tree object: "<mode> <name>\0<20 raw sha bytes>" for the single entry.
HEX_ESCAPED=$(printf '%s' "$BLOB" | sed 's/../\\x&/g')
{
  printf '100644 %s\000' "$FILE"
  printf '%b' "$HEX_ESCAPED"
} > "$TREE_FILE" || fail "cannot write $TREE_FILE"
TREE=$(git hash-object -t tree -w "$TREE_FILE") || fail "git hash-object (tree) failed"
TREE=${TREE//$'\r'/}
[[ "$TREE" =~ ^[0-9a-f]{40}$ ]] || fail "unexpected tree id '$TREE'"

if [[ -n "$PARENT" ]]; then
  COMMIT=$(git commit-tree "$TREE" -p "$PARENT" -m "[learning] $REV insight") \
    || fail "git commit-tree failed"
else
  COMMIT=$(git commit-tree "$TREE" -m "Initialize learnings branch; [learning] $REV insight") \
    || fail "git commit-tree (initialize $BRANCH) failed"
fi
COMMIT=${COMMIT//$'\r'/}
[[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || fail "unexpected commit id '$COMMIT'"

# Compare-and-swap: refuses if someone moved the branch since we read it,
# and (empty CAS_OLD) if the branch appeared meanwhile.
git update-ref -m "save-learning: $REV" "$REF" "$COMMIT" "$CAS_OLD" \
  || fail "git update-ref $REF failed"

echo "Saved learning to $BRANCH branch"
