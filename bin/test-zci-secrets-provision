#!/usr/bin/env -S python3 -I
"""Synthetic proof of host dispatch and the container provisioner's output.

By default the launcher and HTTPS transport are test doubles. --container
requires the real container/tmpfs guard. --podman exercises the actual host
wrapper and zociety launcher with an isolated, network-disabled container.
No production credentials are read.
Canaries are generated in the child and never returned to the invoking agent.
"""

import base64
import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import secrets
import shutil
import signal
import subprocess
import sys
import tempfile
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
PASSED = 0


def check(condition):
    global PASSED
    if not condition:
        raise AssertionError("boundary-proof-failed")
    PASSED += 1


def load(name, filename):
    path = ROOT / "bin" / filename
    # The isolated Podman fixture interposes instrumentation at the command
    # entry point; this adjacent copy is the unchanged production source.
    if filename == "zci-secrets-provision-container" and path.with_name(filename + "-source").exists():
        path = path.with_name(filename + "-source")
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def child(real_container):
    provision = load("provision", "zci-secrets-provision-container")
    transfer = load("transfer", "zci-secrets")
    # Child receives only reviewed command words and a sanitized environment.
    check(sys.argv[3:] == ["exec", "/usr/bin/python3", "-I", "bin/zci-secrets-provision-container"])
    check(not any(key in os.environ for key in
                  ("ZOCIETY_BLIND_KEY", "GH_TOKEN", "GLAB_DEBUG", "PYTHONPATH", "TMPDIR")))
    if real_container:
        provision.require_container()
        check(True)
    # Test both guard failures without reading any credentials.
    with patch.object(Path, "is_file", return_value=False):
        try:
            provision.require_container()
            check(False)
        except RuntimeError:
            check(True)
    with patch.object(Path, "is_file", return_value=True), \
         patch.object(Path, "read_text", return_value="1 0 0:0 / /tmp rw - ext4 disk rw\n"):
        try:
            provision.require_container()
            check(False)
        except RuntimeError:
            check(True)

    transcripts = []
    with tempfile.TemporaryDirectory(prefix="zci-container-proof-", dir="/tmp") as temporary:
        root = Path(temporary)
        source, staging = root / "mount", root / "tmpfs"
        source.mkdir()
        staging.mkdir()
        provision.SOURCE, provision.STAGING = source, staging
        provision.REPORT = root / "receipt.json"
        guard = contextlib.nullcontext() if real_container else patch.object(provision, "require_container")
        for scenario in ("success", "success", "success", "missing", "empty", "prefix", "symlink", "api-error", "interrupt"):
            values = {}
            for item in transfer.SECRETS:
                value = secrets.token_urlsafe(40)
                prefixes = {"gitlab_token": "glpat-", "claude_oauth_token": "sk-ant-oat-", "github_token": "ghp_"}
                value = prefixes.get(item.filename, "") + value
                if item.encoding == "base64":
                    value = "-----BEGIN PGP " + "PRIVATE KEY BLOCK-----\n" + value + "\n-----END PGP PRIVATE KEY BLOCK-----\n"
                values[item.key] = value
                target = source / item.filename
                target.unlink(missing_ok=True)
                target.write_text(value)
                target.chmod(0o644)  # read-only mounts may have broad source modes
            blind = source / "blind_key"
            if scenario == "missing":
                blind.unlink()
            elif scenario == "empty":
                blind.write_text("")
            elif scenario == "prefix":
                (source / "gitlab_token").write_text(secrets.token_urlsafe(40))
            elif scenario == "symlink":
                blind.unlink()
                blind.symlink_to(source / "github_token")
            requests = []
            storage = {}

            class Remote:
                def __init__(self, token):
                    check(token == values[transfer.SECRETS[0].key])

                def request(self, method, key, body=None):
                    requests.append((method, key, body))
                    check(not os.environ)
                    staged = list(staging.iterdir())
                    check(len(staged) == 1 and staged[0].stat().st_mode & 0o777 == 0o700)
                    check(all(p.stat().st_mode & 0o777 == 0o600 for p in staged[0].iterdir()))
                    if scenario == "api-error":
                        raise ValueError(values[key])
                    if scenario == "interrupt":
                        os.kill(os.getpid(), signal.SIGTERM)
                    if method == "GET":
                        return storage.get(key)
                    storage[key] = dict(body, hidden=True)
                    return storage[key]

            backend = vars(transfer).copy()
            backend["entrypoint"] = lambda argv: transfer.entrypoint(argv, Remote)
            out, err = io.StringIO(), io.StringIO()
            provision.REPORT.write_text("stale-success")
            with guard, patch.object(provision.runpy, "run_path", return_value=backend), \
                 patch.object(sys, "argv", ["provision"]), \
                 patch.dict(os.environ, {"ZOCIETY_BLIND_KEY": "unused-environment-fallback"}), \
                 patch.object(subprocess, "Popen", side_effect=AssertionError("no-child-process")), \
                 contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
                rc = provision.entrypoint()
            receipt = provision.REPORT.read_text() if provision.REPORT.exists() else ""
            exposed = out.getvalue() + err.getvalue() + receipt
            for value in values.values():
                for variant in (value, json.dumps(value)[1:-1], value.encode().hex(),
                                base64.b64encode(value.encode()).decode()):
                    check(variant not in exposed)
            check(not list(staging.iterdir()))
            if scenario == "success":
                check(rc == 0 and not err.getvalue())
                check(receipt == out.getvalue())
                report = json.loads(receipt)
                check(set(report) == {"project_id", "scope", "debug_disclosure", "variables"})
                check(report["debug_disclosure"] is False)
                check(len(storage) == 5)
                for item in transfer.SECRETS:
                    expected = values[item.key]
                    if item.encoding == "base64":
                        expected = "base64:" + base64.b64encode(expected.encode()).decode()
                    check(storage[item.key]["value"] == expected)
                transcripts.append(exposed)
            else:
                check(rc == (130 if scenario == "interrupt" else 2))
                check(not receipt and not out.getvalue())
                if scenario in ("missing", "empty", "prefix", "symlink"):
                    check(not requests)
        check(len(set(transcripts)) == 1)
    print(json.dumps({"passed": PASSED, "synthetic_only": True, "real_container_guard": real_container}))


def podman_proof():
    podman = shutil.which("podman")
    check(podman is not None)
    name = "zci-proof-" + secrets.token_hex(6)
    with tempfile.TemporaryDirectory(prefix="zci-host-boundary-") as temporary:
        root = Path(temporary).resolve()
        (root / "bin").mkdir()
        for filename in ("zci-secrets-provision", "zci-secrets", "test-zci-secrets-provision"):
            shutil.copy2(ROOT / "bin" / filename, root / "bin" / filename)
        shutil.copy2(ROOT / "bin/zci-secrets-provision-container",
                     root / "bin/zci-secrets-provision-container-source")
        launcher = (ROOT / "bin/zociety").read_text()
        check(launcher.count('CONTAINER_NAME="zociety-sandbox"') == 1)
        (root / "bin/zociety").write_text(launcher.replace(
            'CONTAINER_NAME="zociety-sandbox"', 'CONTAINER_NAME="' + name + '"'))
        (root / "bin/zociety").chmod(0o700)
        # Instrument only the container process, after crossing the actual
        # wrapper -> zociety -> podman exec boundary. Credentials and the fake
        # server live in that process; no synthetic value is passed from host.
        (root / "bin/zci-secrets-provision-container").write_text(
            "import runpy,sys\n"
            "sys.argv=['proof','--child','real','exec','/usr/bin/python3','-I','bin/zci-secrets-provision-container']\n"
            "runpy.run_path('/repo/bin/test-zci-secrets-provision',run_name='__main__')\n")
        start = subprocess.run([
            podman, "run", "--detach", "--rm", "--name", name, "--network=none", "--read-only",
            "--tmpfs", "/tmp:mode=1777", "--volume", str(root) + ":/repo:ro",
            "--entrypoint", "/usr/bin/sleep", "localhost/zociety:latest", "120",
        ], capture_output=True, text=True)
        check(start.returncode == 0)
        try:
            env = dict(os.environ, ZOCIETY_BLIND_KEY="synthetic-host-value", GH_TOKEN="synthetic-host-value",
                       GLAB_DEBUG="true", TMPDIR=str(root), PYTHONPATH="invalid")
            env.pop("ZOCIETY_ROOT", None)
            result = subprocess.run([str(root / "bin/zci-secrets-provision")],
                                    cwd=root, env=env, capture_output=True, text=True, timeout=90)
            check(result.returncode == 0)
            # Only fixed launcher chrome may accompany the proof receipt.
            check("synthetic-host-value" not in result.stdout + result.stderr)
            check(result.stderr == "\x1b[0;36m[zociety]\x1b[0m Exec: /usr/bin/python3 -I bin/zci-secrets-provision-container\n")
            report = json.loads(result.stdout)
            check(set(report) == {"passed", "synthetic_only", "real_container_guard"})
            check(report["synthetic_only"] and report["real_container_guard"])
            check(not list(root.glob("zociety-secrets-*")))
            report["passed"] += PASSED
            report["actual_host_container_boundary"] = True
            print(json.dumps(report))
        finally:
            removed = subprocess.run([podman, "rm", "--force", name], capture_output=True)
            check(removed.returncode == 0)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--child":
        child(sys.argv[2] == "real")
        return
    if sys.argv[1:] == ["--podman"]:
        podman_proof()
        return
    real = sys.argv[1:] == ["--container"]
    check(not sys.argv[1:] or real)
    with tempfile.TemporaryDirectory(prefix="zci-host-proof-") as temporary:
        root = Path(temporary)
        (root / "bin").mkdir()
        wrapper = root / "bin/zci-secrets-provision"
        shutil.copyfile(ROOT / "bin/zci-secrets-provision", wrapper)
        wrapper.chmod(0o700)
        launcher = root / "bin/zociety"
        # This double records the exact argv/environment at the host boundary,
        # then instruments the real container implementation with a fake API.
        launcher.write_text("#!" + sys.executable + " -I\nimport os,sys\n"
                            "os.execv(" + repr(sys.executable) + ", " + repr([
                                sys.executable, "-I", str(Path(__file__).resolve()),
                                "--child", "real" if real else "mock",
                            ]) + " + sys.argv[1:])\n")
        launcher.chmod(0o700)
        env = dict(os.environ, ZOCIETY_BLIND_KEY="synthetic-host-value", GH_TOKEN="synthetic-host-value",
                   GLAB_DEBUG="true", PYTHONPATH="invalid", TMPDIR=str(root))
        result = subprocess.run([str(wrapper)], env=env, capture_output=True, text=True)
        check(result.returncode == 0 and not result.stderr)
        report = json.loads(result.stdout)
        check(set(report) == {"passed", "synthetic_only", "real_container_guard"})
        check(report["synthetic_only"] is True and report["real_container_guard"] == real)
        rejected = subprocess.run([str(wrapper), "synthetic-invalid-secret-argument"],
                                  env=env, capture_output=True, text=True)
        check(rejected.returncode == 2 and "synthetic-invalid-secret-argument" not in rejected.stderr)
        check(not list(root.glob("zociety-secrets-*")))
        report["passed"] += PASSED
        print(json.dumps(report))


if __name__ == "__main__":
    try:
        main()
    except BaseException:
        # Even assertion and fixture failures must not disclose captured data.
        print('{"failed":1,"synthetic_only":true}', file=sys.stderr)
        sys.exit(1)
