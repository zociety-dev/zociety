#!/bin/bash
# Exercise the reviewed operator wrapper with synthetic values and fake tools.

set -euo pipefail

ROOT=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P)
SOURCE="$ROOT/bin/zci-secrets-provision"
TMP=$(mktemp -d "${TMPDIR:-/tmp}/zci-provision-test.XXXXXX")
TMP=$(cd "$TMP" && pwd -P)
trap 'rm -rf "$TMP"' EXIT
PASSED=0

check() {
  local label=$1
  shift
  if ! "$@"; then
    printf 'not ok - %s\n' "$label" >&2
    exit 1
  fi
  PASSED=$((PASSED + 1))
}

check_eq() {
  [[ "$1" == "$2" ]]
}

check_not_contains() {
  [[ "$1" != *"$2"* ]]
}

quiet_run() {
  "$@" >/dev/null 2>&1
}

# The main guard makes the implementation safe to source for focused tests.
# shellcheck source=bin/zci-secrets-provision
source "$SOURCE"

original_path=$PATH
PATH=$TMP
select_tools
PATH=$original_path
check "python is selected from a fixed absolute path" \
  check_not_contains "$PYTHON" "$TMP"
check "gpg is selected from a fixed absolute path" \
  check_not_contains "$GPG" "$TMP"
check "gpgconf is selected from a fixed absolute path" \
  check_not_contains "$GPGCONF" "$TMP"

REAL_PYTHON=$PYTHON
check "selected python imports the transfer command" \
  quiet_run "$REAL_PYTHON" -I "$ZCI_SECRETS" --help

BAD_PYTHON="$TMP/python-bad"
printf '#!/bin/sh\nexit 1\n' > "$BAD_PYTHON"
chmod 700 "$BAD_PYTHON"
PYTHON=$BAD_PYTHON
GPG=/bin/true
GPGCONF=/bin/true
set +e
preflight_output=$(preflight 2>&1)
preflight_status=$?
set -e
check "interpreter failures stop in preflight" check_eq "$preflight_status" 2
check "preflight failures use a fixed message" \
  check_eq "$preflight_output" 'zci-secrets-provision: python-3.9-required'

secret_stage="$TMP/stage"
mkdir -m 700 "$secret_stage"

set +e
empty_output=$(stage_secret 'Synthetic prompt: ' gitlab_token gitlab <<< '' 2>&1)
empty_status=$?
invalid_value=not-a-gitlab-token
invalid_output=$(stage_secret 'Synthetic prompt: ' gitlab_token gitlab <<< "$invalid_value" 2>&1)
invalid_status=$?
set -e
check "empty input is rejected" check_eq "$empty_status" 2
check "empty input reports only a fixed failure" \
  check_eq "$empty_output" $'Synthetic prompt: \nzci-secrets-provision: empty-input'
check "invalid public prefixes are rejected" check_eq "$invalid_status" 2
check "invalid input is not reflected" check_not_contains "$invalid_output" "$invalid_value"
check "rejected input is not staged" test ! -e "$secret_stage/gitlab_token"

synthetic_marker=synthetic-transfer-token
gitlab_value="glpat-$synthetic_marker"
claude_value="sk-ant-oat-$synthetic_marker"
blind_value=synthetic-blind-passphrase
github_value="github_pat_${synthetic_marker//-/_}"

gitlab_output=$(stage_secret 'Synthetic prompt: ' gitlab_token gitlab <<< "$gitlab_value" 2>&1)
claude_output=$(stage_secret 'Synthetic prompt: ' claude_oauth_token claude <<< "$claude_value" 2>&1)
blind_output=$(stage_secret 'Synthetic prompt: ' blind_key blind <<< "$blind_value" 2>&1)
github_output=$(stage_secret 'Synthetic prompt: ' github_token github <<< "$github_value" 2>&1)
check "GitLab prefix is accepted" check_eq "$(<"$secret_stage/gitlab_token")" "$gitlab_value"
check "Claude prefix is accepted" check_eq "$(<"$secret_stage/claude_oauth_token")" "$claude_value"
check "blind passphrase is staged as a file" check_eq "$(<"$secret_stage/blind_key")" "$blind_value"
check "GitHub prefix is accepted" check_eq "$(<"$secret_stage/github_token")" "$github_value"
for transcript in "$gitlab_output" "$claude_output" "$blind_output" "$github_output"; do
  check "accepted input is not reflected" check_not_contains "$transcript" synthetic
done
for staged in gitlab_token claude_oauth_token blind_key github_token; do
  mode=$("$REAL_PYTHON" -I -c 'import os,stat,sys; print(oct(stat.S_IMODE(os.stat(sys.argv[1]).st_mode)))' \
    "$secret_stage/$staged")
  check "staged files are mode 600" check_eq "$mode" 0o600
done

FAKE_GPG="$TMP/gpg"
printf '%s\n' \
  '#!/bin/sh' \
  'printf "%s\n" "-----BEGIN PGP PRIVATE"" KEY BLOCK-----" "-----END PGP PRIVATE"" KEY BLOCK-----"' \
  > "$FAKE_GPG"
chmod 700 "$FAKE_GPG"
GPG=$FAKE_GPG
export_signing_key
check "signing key export is staged" test -s "$secret_stage/gpg_signing_key.asc"

TRANSFER_LOG="$TMP/transfer-args"
FAKE_PYTHON="$TMP/python-log"
printf '#!/bin/sh\nprintf "%%s\\n" "$@" > %q\n' "$TRANSFER_LOG" > "$FAKE_PYTHON"
chmod 700 "$FAKE_PYTHON"
PYTHON=$FAKE_PYTHON
REPORT="$TMP/status.json"
run_transfer
transfer_args=$(tr '\n' ' ' < "$TRANSFER_LOG")
expected_args="-I $ZCI_SECRETS --set --source-dir $secret_stage --report $REPORT "
check "one set call performs the supported verification" \
  check_eq "$transfer_args" "$expected_args"

PYTHON=$REAL_PYTHON
export TMPDIR="$TMP"
create_secret_stage
created_stage=$secret_stage
check "stage uses the platform temporary directory" \
  check_eq "${created_stage%/*}" "$TMP"
stage_mode=$("$REAL_PYTHON" -I -c 'import os,stat,sys; print(oct(stat.S_IMODE(os.stat(sys.argv[1]).st_mode)))' \
  "$created_stage")
check "temporary stage is private" check_eq "$stage_mode" 0o700
printf synthetic > "$created_stage/synthetic"

AGENT_LOG="$TMP/gpgconf-args"
FAKE_GPGCONF="$TMP/gpgconf"
printf '#!/bin/sh\nprintf "%%s\\n" "$@" > %q\n' "$AGENT_LOG" > "$FAKE_GPGCONF"
chmod 700 "$FAKE_GPGCONF"
(
  export TMPDIR="$TMP"
  PYTHON=$REAL_PYTHON
  GPGCONF=$FAKE_GPGCONF
  secret_stage=$created_stage
  cleanup
)
check "cleanup removes the temporary stage" test ! -e "$created_stage"
check "cleanup reloads gpg-agent" \
  check_eq "$(tr '\n' ' ' < "$AGENT_LOG")" '--reload gpg-agent '

printf '{"passed":%d,"failed":0,"synthetic_only":true}\n' "$PASSED"
