#!/bin/bash
# test-zevent-system: Comprehensive test of the event sourcing system
# This script tests all the z* commands to verify the event sourcing implementation
#
# NOT a throwaway-fixture test: it commits real [join]/[stuff]/[vote]/[pass]
# events onto the current branch of the repo it runs in (`git add -A` sweeps
# staged work into them). Run it only in a throwaway copy of the repo.
#
# Each step runs under its own ZOCIETY_TURN_ID, as one loop iteration would:
# genesis credits one join, pass and stuff per turn, and bin/zpass tallies
# one vote per turn, so a single id for the whole script would never reach
# genesis.

set -e

# turn <n> <cmd...>: run one command as runner turn n
turn() {
  local n="$1"
  shift
  ZOCIETY_TURN_ID="test-zevent-turn-$n" "$@"
}

echo "╔════════════════════════════════════════╗"
echo "║  Zociety Event Sourcing System Test   ║"
echo "╚════════════════════════════════════════╝"
echo ""

echo "=== Test 1: Initial State ==="
echo "Running: bin/zstate"
bin/zstate
echo ""

echo "=== Test 2: First Join Event ==="
echo "Running: bin/zjoin - builder 'first agent joining'"
mkdir -p stuff
turn 1 bin/zjoin - builder "first agent joining"
echo ""

echo "=== Test 3: Check State After Join ==="
echo "Running: bin/zstate"
bin/zstate
echo ""

echo "=== Test 4: Create Stuff ==="
echo "Running: create stuff/index.md and bin/zstuff"
echo "# Welcome" > stuff/index.md
git add stuff/index.md
turn 2 bin/zstuff alice index.md "direct"
echo ""

echo "=== Test 5: Second Join ==="
echo "Running: bin/zjoin - voter 'second agent'"
turn 3 bin/zjoin - voter "second agent"
echo ""

echo "=== Test 6: Vote Event (proposes rule 1) ==="
echo "Running: bin/zvote bob 1 yes 'supports the goal'"
turn 4 bin/zvote bob 1 yes "supports the goal"
echo ""

echo "=== Test 6b: A pass needs a second turn's vote ==="
echo "Running: bin/zpass bob 1 ... (expected to refuse: one turn has voted)"
if turn 4 bin/zpass bob 1 "Build on what exists"; then
  echo "✗ zpass passed rule 1 on a single turn's vote"
  exit 1
fi
echo "✓ zpass refused rule 1 with one voting turn"
echo ""

echo "=== Test 7: Third Join ==="
echo "Running: bin/zjoin - observer 'third agent'"
turn 5 bin/zjoin - observer "third agent"
echo ""

echo "=== Test 8: More Stuff ==="
echo "Running: create more stuff files"
echo "# Concepts" > stuff/concepts.md
git add stuff/concepts.md
turn 6 bin/zstuff carol concepts.md "index.md -> concepts.md"

echo "# Summary" > stuff/summary.md
git add stuff/summary.md
turn 7 bin/zstuff alice summary.md "concepts.md -> summary.md"
echo ""

echo "=== Test 9: Pass a Rule (second turn seconds it, then passes it) ==="
echo "Running: bin/zvote alice 1 yes, then bin/zpass alice 1"
turn 8 bin/zvote alice 1 yes "seconded"
turn 8 bin/zpass alice 1 "Build on what exists"
echo ""

echo "=== Test 10: Second Rule Pass ==="
echo "Running: two turns vote yes on rule 2, the second passes it"
turn 9 bin/zvote bob 2 yes "proposal: document patterns"
turn 10 bin/zvote carol 2 yes "seconded"
turn 10 bin/zpass carol 2 "Document patterns"
echo ""

echo "=== Test 11: Check Final State ==="
echo "Running: bin/zstate"
STATE=$(bin/zstate)
echo "$STATE"
echo ""

COMPLETE=$(echo "$STATE" | jq -r '.genesis.complete')
ACTION=$(echo "$STATE" | jq -r '.action')

echo "=== Test Results ==="
echo "Genesis Complete: $COMPLETE"
echo "Recommended Action: $ACTION"
echo ""

if [[ "$COMPLETE" == "true" ]]; then
  echo "✓ Genesis thresholds met!"
  echo "  Members: $(echo "$STATE" | jq -r '.genesis.members')/3"
  echo "  Rules: $(echo "$STATE" | jq -r '.genesis.rules')/2"
  echo "  Stuff: $(echo "$STATE" | jq -r '.genesis.stuff')/3"
else
  echo "✗ Genesis not complete"
  exit 1
fi

echo ""
echo "=== Test 12: Query Event History ==="
echo "All events in current cycle:"
git log --format=%b | grep '^{"z":1' | jq -s 'map({seq, event, agent, genesis: .state})'
echo ""

echo "=== Test 13: Query Specific Event Types ==="
echo "All join events:"
git log --format=%b | grep '^{"z":1' | jq -s 'map(select(.event == "join")) | map({agent, role: .data.role})'
echo ""

echo "All stuff events:"
git log --format=%b | grep '^{"z":1' | jq -s 'map(select(.event == "stuff")) | map({agent, file: .data.file, traversal: .data.traversal})'
echo ""

echo "Vote tally bin/zstate derives (one vote per turn):"
echo "$STATE" | jq '.votes'
echo ""

echo "╔════════════════════════════════════════╗"
echo "║  All Tests Passed Successfully!       ║"
echo "╚════════════════════════════════════════╝"
echo ""
echo "The event sourcing system is working correctly."
echo "State is properly derived from git commit history."
echo ""
echo "Next steps to test:"
echo "  - Run: bin/zheap-death --cite index.md --learning 'What this cycle found' alice 'What emerges next?' 3"
echo "  - Then: bin/zstate (should show direction phase)"
echo "  - Or: bin/zpromise alice (if batch=0)"
