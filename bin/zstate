#!/bin/bash
# zstate: Get current zociety state from git history
#
# Returns JSON with:
#   - cycle: current cycle number
#   - seq: sequence number in cycle
#   - phase: initial|direction|building|finishing
#   - genesis: {members, rules, stuff, complete}
#   - batch: remaining attempts (null if not set)
#   - direction: question for cycle (null if not set)
#   - action: what agent should do next (stable vocabulary:
#             join|contribute|complete|heap-death|promise|stop)
#   - needs: remaining genesis requirements, {members, rules, stuff}, counts
#            REMAINING (not current). All zero once genesis is complete.
#   - next: deficit-qualified form of action. Equals action except when
#           action is "contribute", where it becomes contribute:member,
#           contribute:rule or contribute:stuff. Priority when several legs
#           are short: members, then rules, then stuff (members gate voting,
#           rules are the scarcest leg, stuff is always available).
#   - last_event: type of last event
#   - last_agent: who did last event
#
# Genesis thresholds: 3 members, 2 passed rules, 3 stuff items.

set -e

# Genesis thresholds (see AGENTS.md "Genesis")
NEED_MEMBERS=3
NEED_RULES=2
NEED_STUFF=3

# One pass over the last 1000 commits, newest first: one git process and one
# jq, never a process per commit. (The per-commit loop this replaced cost
# ~30s on a 1300-commit repo, and every z* command runs zstate several times
# through bin/zlog, so a single bin/zjoin took over a minute of a 300s turn.)
#
# Each commit becomes a record: the hash on its first line, then the full
# message. Only the JSON envelope counts: from the first line starting with
# "{" to the end of that object (one line when compact, the bare "}" line when
# pretty-printed). Anything after it, e.g. a stray Agent: trailer, is ignored
# so it can never hide the event. Emits one compact {z:1 ...} object per event
# commit with the commit hash added as _hash (legacy events carry no turn id,
# so the hash stands in as one).
scan_events() {
  git log --format='%x1e%H%n%B' -n 1000 2>/dev/null \
    | jq -R -s -c '
      split("\u001e")[1:]
      | map(
          split("\n") as $l
          | $l[0] as $hash
          | $l[1:] as $msg
          | ($msg | to_entries | map(select(.value | startswith("{"))) | first | .key) as $start
          | select($start != null)
          | $msg[$start:] as $rest
          | (if ($rest[0] | test("^\\{.*\\}$")) then [$rest[0]]
             else ($rest | to_entries | map(select(.value == "}")) | first | .key) as $end
                  | if $end == null then [] else $rest[:$end + 1] end
             end) as $env
          | ($env | join("\n") | fromjson?)
          | select(type == "object" and .z == 1)
          | . + {_hash: $hash}
        )
      | .[]'
}

# Everything derived from the scan, in one jq:
#   last       the most recent event (the state machine's input)
#   direction  this cycle's [direction] question, for events that do not
#              carry one themselves
#   credits    genesis counts, crediting one join, pass and stuff per
#              runner-issued turn id (runtime.session; the commit hash for
#              legacy events), so one agent invocation cannot manufacture a
#              whole society by emitting several qualifying events
#   votes      per rule, the latest vote of each distinct turn: {"1": {yes, no}}.
#              bin/zpass passes a rule on this tally, never on numbers the
#              caller supplies, so three votes cast by one invocation under
#              three member names count once
SCAN=$(scan_events | jq -s -c '
  .[0] as $last
  | if $last == null then {last: null}
    else
      map(select(.cycle == $last.cycle)) as $cyc
      | {
          last: ($last | del(._hash)),
          direction: ($cyc | map(select(.event == "direction") | .data.question) | first),
          credits: ($cyc
            | map(select(.event == "join" or .event == "pass" or .event == "stuff")
                  | {event, session: (.runtime.session // ._hash)})
            | reduce .[] as $e
                ({members: 0, rules: 0, stuff: 0, session_credits: {}};
                 .session_credits[$e.session] = (.session_credits[$e.session] // {})
                 | if .session_credits[$e.session][$e.event] then .
                   else .session_credits[$e.session][$e.event] = true
                     | if $e.event == "join" then .members += 1
                       elif $e.event == "pass" then .rules += 1
                       else .stuff += 1
                       end
                   end)),
          votes: ($cyc
            | map(select(.event == "vote" and (.data.rule | type) == "number"))
            | reverse
            | reduce .[] as $v ({};
                .[($v.data.rule | tostring)][($v.runtime.session // $v._hash)] = $v.data.vote)
            | map_values(
                (to_entries | map(.value)) as $vs
                | {yes: ($vs | map(select(. == 1)) | length),
                   no: ($vs | map(select(. == -1)) | length)}))
        }
    end')

LAST_EVENT=$(printf '%s' "$SCAN" | jq -c '.last // empty')

if [[ -z "$LAST_EVENT" ]]; then
  # No events yet - initial state
  bin/zlog zstate "No events found - returning initial state" '{"action": "join"}' 2>/dev/null || true
  jq -n \
    --argjson need_members "$NEED_MEMBERS" \
    --argjson need_rules "$NEED_RULES" \
    --argjson need_stuff "$NEED_STUFF" \
    '{
      cycle: 1,
      seq: 0,
      phase: "initial",
      genesis: {members: 0, rules: 0, stuff: 0, complete: false},
      batch: null,
      direction: null,
      action: "join",
      needs: {members: $need_members, rules: $need_rules, stuff: $need_stuff},
      next: "join",
      last_event: null,
      last_agent: null
    }'
  exit 0
fi

CREDITS=$(printf '%s' "$SCAN" | jq -c '.credits')
VOTES=$(printf '%s' "$SCAN" | jq -c '.votes // {}')
CYCLE_DIRECTION=$(printf '%s' "$SCAN" | jq -c '.direction // null')

# Log the found event
LAST_EVENT_TYPE=$(echo "$LAST_EVENT" | jq -r '.event')
LAST_EVENT_AGENT=$(echo "$LAST_EVENT" | jq -r '.agent')
bin/zlog zstate "Found last event: $LAST_EVENT_TYPE by $LAST_EVENT_AGENT" \
  "$(echo "$LAST_EVENT" | jq -c '{event: .event, agent: .agent, batch: .data.batch_remaining}')" 2>/dev/null || true

# Parse last event and compute phase and action
OUTPUT=$(echo "$LAST_EVENT" | jq -r \
  --argjson credits "$CREDITS" \
  --argjson votes "$VOTES" \
  --argjson cycle_direction "$CYCLE_DIRECTION" \
  --argjson need_members "$NEED_MEMBERS" \
  --argjson need_rules "$NEED_RULES" \
  --argjson need_stuff "$NEED_STUFF" '
  # Determine phase based on last event and state
  .state.members = $credits.members |
  .state.rules = $credits.rules |
  .state.stuff = $credits.stuff |
  .state.complete = (.state.members >= $need_members and .state.rules >= $need_rules and .state.stuff >= $need_stuff) |
  .phase = (
    if .event == "promise" or (.event == "observation" and .data.terminal) then "stopped"
    elif .event == "heap-death" then
      if (.data.batch_remaining // 0) == 0 then "exiting"
      else "direction"
      end
    elif .event == "complete" then "archiving"
    elif .event == "direction" then "building"
    elif .state.complete then "finishing"
    else "building"
    end
  ) |

  # Determine recommended action based on event and state
  # Key insight: after [complete], must run heap-death before promise
  # After [promise], loop should stop - no further action needed
  # Direction guides contribution, not file editing
  .action = (
    if .event == "promise" or (.event == "observation" and .data.terminal) then "stop"
    elif .event == "complete" then "heap-death"
    elif .event == "heap-death" then
      if (.data.batch_remaining // 0) == 0 then "promise"
      else "contribute"
      end
    elif .state.complete then "complete"
    else "contribute"
    end
  ) |

  # What is still missing for genesis, as REMAINING counts (never negative).
  # Overshooting one leg (e.g. 4 members) reports 0, not a negative number.
  .needs = (
    if .state.complete then {members: 0, rules: 0, stuff: 0}
    else {
      members: ([$need_members - (.state.members // 0), 0] | max),
      rules:   ([$need_rules   - (.state.rules   // 0), 0] | max),
      stuff:   ([$need_stuff   - (.state.stuff   // 0), 0] | max)
    }
    end
  ) |

  # Deficit-qualified action. .action keeps its stable vocabulary for the
  # stop predicates; .next is the field an agent reads to pick a leg.
  # Deterministic priority: members, then rules, then stuff.
  .next = (
    if .action != "contribute" then .action
    elif .needs.members > 0 then "contribute:member"
    elif .needs.rules > 0 then "contribute:rule"
    elif .needs.stuff > 0 then "contribute:stuff"
    else "contribute"
    end
  ) |

  # Build output structure
  {
    cycle: .cycle,
    seq: .seq,
    phase: .phase,
    genesis: .state,
    batch: (.data.batch_remaining // null),
    direction: (.data.question // $cycle_direction),
    action: .action,
    needs: .needs,
    next: .next,
    last_event: .event,
    last_agent: .agent,
    session_credits: $credits.session_credits,
    votes: $votes
  }
')

# Log the computed state with explanation
ACTION=$(echo "$OUTPUT" | jq -r '.action')
PHASE=$(echo "$OUTPUT" | jq -r '.phase')
NEXT=$(echo "$OUTPUT" | jq -r '.next')
bin/zlog zstate "Computed: phase=$PHASE, action=$ACTION, next=$NEXT" \
  "$(echo "$OUTPUT" | jq -c '{phase: .phase, action: .action, next: .next, needs: .needs, batch: .batch, complete: .genesis.complete}')" 2>/dev/null || true

# Output the state
echo "$OUTPUT"
