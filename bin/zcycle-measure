#!/bin/bash
# zcycle-measure: Derive auditable experimental measures for the current cycle
# Usage: bin/zcycle-measure [cycle]
#        bin/zcycle-measure -h | --help
#
# Scores are 0..1 and are deliberately mechanical indicators, not claims of
# semantic quality. They make comparisons reproducible from committed history.
# They read structure, never content: novelty is the share of this cycle's
# stuff/ names no earlier cycle used, so a cycle that makes three new files
# on the question of the last five scores 1 like one that changes the
# subject. Cycles 51 to 53 score the same on every measure; whether the
# learnings progress or circle is read from the learnings themselves
# (bin/read-learnings, or the heap-death events).

set -euo pipefail

for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
  fi
done
if [[ $# -gt 1 ]]; then
  echo "zcycle-measure: one cycle at most, got $# arguments (--help for usage)" >&2
  exit 2
fi
if [[ "${1:-}" == -* ]]; then
  echo "zcycle-measure: unknown option '$1' (--help for usage)" >&2
  exit 2
fi
if [[ -n "${1:-}" ]] && ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
  echo "zcycle-measure: cycle must be a number from 1, got '$1'" >&2
  exit 2
fi

CYCLE="${1:-$(bin/zstate | jq -r '.cycle // empty')}"
if ! [[ "$CYCLE" =~ ^[1-9][0-9]*$ ]]; then
  echo "zcycle-measure: bin/zstate names no cycle here" >&2
  exit 2
fi
# One walk of the history for both this cycle's events and the stuff/ names
# every earlier cycle used.
read_history=$(git log --format=%B | awk '/^\{/ && !s {s=1} s {print} s && (/^\}$/ || /^\{.*\}$/) {s=0}' \
  | jq -sc --argjson cycle "$CYCLE" '{
      events: [.[] | select(.z == 1 and .cycle == $cycle)],
      prior: ([.[] | select(.z == 1 and .cycle < $cycle and .event == "stuff") | .data.file] | unique)
    }')
events=$(jq -c .events <<<"$read_history")
prior_artifacts=$(jq -c .prior <<<"$read_history")
if [[ "$events" == "[]" ]]; then
  echo "zcycle-measure: no events for cycle $CYCLE in this history" >&2
  exit 2
fi
artifacts=$(printf '%s' "$events" | jq '[.[] | select(.event == "stuff") | .data.file] | unique')

jq -n --argjson events "$events" --argjson artifacts "$artifacts" --argjson prior "$prior_artifacts" '
  def ratio($n; $d): if $d == 0 then 0 else ($n / $d) end;
  ($events | map(select(.event == "join") | .runtime.session) | map(select(. != null)) | unique) as $sessions |
  ($events | map(select(.event == "pass")) | length) as $passes |
  ($events | map(select(.event == "stuff")) | length) as $stuff |
  ($events | map(select(.event == "direction") | .data.inheritance // empty) | length) as $lineage |
  ($artifacts | map(select(. as $a | $prior | index($a) | not)) | length) as $new |
  {
    novelty: ratio($new; ($artifacts | length)),
    inheritance: (if $lineage > 0 then 1 else 0 end),
    diversity: ratio(($sessions | length); 3),
    constraint_adherence: (if ($events | map(select(.event == "intervention")) | length) == 0 then 1 else 0 end),
    surprise: ratio(($events | map(select(.event == "observation")) | length); ($events | length)),
    stability: ratio($passes; ($passes + $stuff)),
    trace_quality: ratio(($events | map(select(.data != null and .runtime != null)) | length); ($events | length))
  }'
