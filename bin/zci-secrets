#!/usr/bin/env -S python3 -I
"""Provision zociety's protected GitLab file variables without disclosing values.

Adapted from ops/sites/gitlab-migration/scripts/check-ci-vars.py's private
input and metadata-only reporting pattern. Uses HTTPS directly so no child
process receives secrets in argv, environment, stdout, or stderr.
"""

import argparse
import base64
from dataclasses import dataclass
import json
import os
from pathlib import Path
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

PROJECT = 88980153
SCOPE = "autonomous"
API = f"https://gitlab.com/api/v4/projects/{PROJECT}/variables"


@dataclass(frozen=True)
class Secret:
    key: str
    filename: str | None
    encoding: str = "plain"


SECRETS = (
    Secret("ZOCIETY_GITLAB_TOKEN_FILE", "gitlab_token"),
    Secret("ZOCIETY_CLAUDE_OAUTH_TOKEN_FILE", "claude_oauth_token"),
    Secret("ZOCIETY_GPG_SIGNING_KEY_FILE", "gpg_signing_key.asc", "base64"),
    Secret("ZOCIETY_BLIND_KEY_FILE", None),
    Secret("ZOCIETY_GITHUB_TOKEN_FILE", "github_token"),
)
KEYS = tuple(item.key for item in SECRETS)
STATES = {"missing", "present", "created", "updated", "invalid-settings", "error"}


class SafeFailure(Exception):
    """Carries a fixed code, never an external message or secret."""


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class GitLab:
    def __init__(self, token, opener=None):
        self.token = token
        # Neither proxy environment variables nor redirects may change the
        # destination receiving the service-account credential.
        self.opener = opener or urllib.request.build_opener(
            urllib.request.ProxyHandler({}), NoRedirect()
        )

    def request(self, method, key, body=None):
        if key not in KEYS or method not in {"GET", "POST", "PUT"}:
            raise SafeFailure("invalid-request")
        url = API
        if method != "POST":
            url += "/" + key + "?filter%5Benvironment_scope%5D=" + SCOPE
        data = None if body is None else json.dumps(body).encode()
        request = urllib.request.Request(
            url, data=data, method=method,
            headers={"PRIVATE-TOKEN": self.token, "Content-Type": "application/json"},
        )
        try:
            with self.opener.open(request, timeout=30) as response:
                result = json.load(response)
        except urllib.error.HTTPError as exc:
            # Do not read, format, redact, or print a server response body.
            # It may echo a value, encode it, or put it in an error message.
            if method == "GET" and exc.code == 404:
                return None
            raise SafeFailure("api-rejected") from None
        except Exception:
            # Includes malformed JSON, transport errors and exception reprs
            # containing credentials. No traceback crosses the output boundary.
            raise SafeFailure("api-unavailable") from None
        if not isinstance(result, dict):
            raise SafeFailure("invalid-response")
        return result


def valid_settings(value):
    return isinstance(value, dict) and all((
        value.get("variable_type") == "file",
        value.get("environment_scope") == SCOPE,
        value.get("protected") is True,
        value.get("masked") is True,
        value.get("hidden") is True,
        value.get("raw") is True,
    ))


def read_secret(item, directory, blind_file):
    try:
        if item.filename:
            value = (directory / item.filename).read_text()
        elif blind_file:
            value = blind_file.read_text().rstrip("\r\n")
        else:
            value = os.environ.get("ZOCIETY_BLIND_KEY", "")
    except Exception:
        raise SafeFailure("source-unavailable") from None
    if not value:
        raise SafeFailure("source-empty")
    if item.encoding == "base64":
        if not value.startswith("-----BEGIN PGP " + "PRIVATE KEY BLOCK-----"):
            raise SafeFailure("invalid-signing-key")
        value = "base64:" + base64.b64encode(value.encode()).decode()
    else:
        value = value.rstrip("\r\n")
    # All stored values must support masking and hiding, including the
    # multiline GPG key. Never fall back to unmasked storage.
    if len(value) < 8 or len(value) > 10000 or any(c.isspace() for c in value):
        raise SafeFailure("source-not-maskable")
    return value


def publish_report(rows, debug, report):
    # This schema is the only normal output sink. Do not add remote messages,
    # source contents, values, value hashes, previews, or exception text here.
    safe_rows = []
    for row in rows:
        if row["key"] not in KEYS or row["state"] not in STATES:
            raise SafeFailure("invalid-report")
        safe_rows.append({"key": row["key"], "state": row["state"]})
    result = {"project_id": PROJECT, "scope": SCOPE,
              "debug_disclosure": bool(debug), "variables": safe_rows}
    encoded = json.dumps(result, sort_keys=True) + "\n"
    if report:
        report.parent.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix=".secret-status-", dir=report.parent)
        try:
            with os.fdopen(fd, "w") as output:
                output.write(encoded)
            os.replace(temporary, report)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    sys.stdout.write(encoded)


class Parser(argparse.ArgumentParser):
    def error(self, message):
        # argparse's default echoes invalid argv; a mistaken value argument
        # must not turn a usage error into a disclosure.
        raise SafeFailure("invalid-arguments")


def main(argv=None, client_factory=GitLab):
    parser = Parser(description=__doc__)
    parser.add_argument("--set", action="store_true", help="create missing variables")
    parser.add_argument("--force", action="store_true", help="update existing hidden variables")
    parser.add_argument("--source-dir", type=Path, default=Path(__file__).resolve().parent.parent / "container/secrets")
    parser.add_argument("--blind-key-file", type=Path)
    parser.add_argument("--only", choices=KEYS, action="append")
    parser.add_argument("--report", type=Path, help="write metadata-only JSON")
    parser.add_argument("--debug-show-values", action="store_true", help="operator QA: disclose values; requires a terminal and confirmation flag")
    parser.add_argument("--confirm-secret-disclosure", action="store_true")
    args = parser.parse_args(argv)
    if args.force and not args.set:
        raise SafeFailure("invalid-arguments")
    debug = args.debug_show_values
    if debug != args.confirm_secret_disclosure or (debug and not (sys.stdin.isatty() and sys.stdout.isatty())):
        raise SafeFailure("debug-requires-terminal-and-confirmation")
    if args.report:
        # A failed or partial run must not leave a previous success receipt.
        args.report.unlink(missing_ok=True)
    selected = [item for item in SECRETS if not args.only or item.key in args.only]
    auth = read_secret(SECRETS[0], args.source_dir, args.blind_key_file)
    client = client_factory(auth)
    existing = {item.key: client.request("GET", item.key) for item in selected}
    pending = [item for item in selected if args.set and (not existing[item.key] or args.force)]
    # Preflight every source before the first write. Existing visible values
    # cannot be made hidden by PUT: require operator recreation instead.
    if any(existing[item.key] and existing[item.key].get("hidden") is not True for item in pending):
        raise SafeFailure("existing-variable-requires-hidden-recreation")
    values = {item.key: read_secret(item, args.source_dir, args.blind_key_file) for item in pending}
    if debug:
        sys.stderr.write("DEBUG: credential values will be disclosed intentionally\n")
        for item in selected:
            value = values.get(item.key) if args.set else (existing[item.key] or {}).get("value")
            sys.stdout.write("DEBUG_SECRET " + item.key + " " + json.dumps(value) + "\n")
    rows, failed = [], False
    for item in selected:
        current = existing[item.key]
        state = "missing" if current is None else "present" if valid_settings(current) else "invalid-settings"
        if item in pending:
            body = {"key": item.key, "value": values[item.key], "variable_type": "file",
                    "environment_scope": SCOPE, "protected": True, "masked": True, "raw": True}
            method = "PUT" if current else "POST"
            if method == "POST":
                body["masked_and_hidden"] = True
            current = client.request(method, item.key, body)
            verified = client.request("GET", item.key)
            if not valid_settings(current) or not valid_settings(verified):
                raise SafeFailure("verification-failed")
            state = "created" if method == "POST" else "updated"
        failed |= state not in {"present", "created", "updated"}
        rows.append({"key": item.key, "state": state})
    publish_report(rows, debug, args.report)
    return int(failed)


def entrypoint(argv=None, client_factory=GitLab):
    try:
        return main(argv, client_factory)
    except KeyboardInterrupt:
        sys.stderr.write("zci-secrets: interrupted; no values disclosed\n")
        return 130
    except SafeFailure as exc:
        # SafeFailure codes originate only in this source. Do not forward
        # arbitrary exception messages, even if they claim to be this type.
        allowed = {"invalid-request", "api-rejected", "api-unavailable", "invalid-response",
                   "source-unavailable", "source-empty", "invalid-signing-key", "source-not-maskable",
                   "invalid-report", "invalid-arguments", "debug-requires-terminal-and-confirmation",
                   "existing-variable-requires-hidden-recreation", "verification-failed"}
        code = exc.args[0] if len(exc.args) == 1 and isinstance(exc.args[0], str) and exc.args[0] in allowed else "operation-failed"
        sys.stderr.write("zci-secrets: " + code + "; response details suppressed\n")
        return 2
    except Exception:
        sys.stderr.write("zci-secrets: operation-failed; response details suppressed\n")
        return 2


if __name__ == "__main__":
    sys.exit(entrypoint())
