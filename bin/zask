#!/bin/bash
# zask: Put a question or statement to the zociety, beside its own direction
#
# Usage:
#   bin/zask [--cycles N] "<question or statement>"
#   bin/zask --list
#   bin/zask --show <ask-id>
#   bin/zask --close <ask-id> "<reason>"
#   bin/zask --drain
#   bin/zask -h | --help
#
# The zociety sets its own direction: each heap-death names the question the
# next cycle works on. An ask is the operator's way in without taking that
# over. It is an [ask] event (agent "operator") carrying the text. bin/zstate
# queues open asks oldest first and names the head as .ask; while one is open,
# a cycle that has not answered it yet gets one more genesis leg, an answer:
# a stuff/ file recorded with `bin/zstuff --answers <ask-id>` (bin/zstate .next
# is contribute:answer once members and rules are in). The cycle's direction,
# rules and 3 stuff items are unchanged; the answer is in addition to them. A
# cycle answers at most one ask, so a queue is taken one cycle at a time. An
# ask recorded after a cycle's [complete] waits for the next cycle.
#
# Options:
#   --cycles N   Work the ask through N cycles (default 1). Each cycle answers
#                it once and is shown the earlier answers, to build on,
#                correct or dispute; the ask closes after the Nth answer.
#   --list       Every ask, its status and where each answer is.
#   --show ID    The ask and the full text of every answer so far.
#   --close ID   Withdraw an open ask; the reason is recorded.
#   --drain      Record the asks queued while a run goes (bin/zloop runs
#                this between turns).
#
# Asks come from outside the society: a loop turn (ZOCIETY_TURN_ID set) is
# refused. A commit made while a turn runs would be sealed as that turn's,
# so while a run goes in this worktree (bin/zloop status) an ask or a close
# is queued in .zociety/asks.inbox, with its id, and the run records it
# before its next turn; between runs, or from the run itself (bin/zloop
# --ask), it is recorded at once. The tree must be clean when it is
# recorded, because bin/zevent stages everything; a queued ask waits for a
# clean tree. Answers are archived with their cycle; --show reads them from
# the [stuff] commits that recorded them, so they survive bin/zheap-death
# clearing stuff/. Asks older than bin/zstate's 1000-commit window are not
# seen.

set -e

# shellcheck source=bin/zrun.sh
. bin/zrun.sh

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
  echo "zask: $*" >&2
  exit 1
}

# ask_by_id <id>: the ask's record from bin/zstate --asks, or empty
ask_by_id() {
  bin/zstate --asks | jq -c --arg id "$1" '.[] | select(.id == $id)'
}

# record_guard: an ask is the operator's, and bin/zevent stages everything
record_guard() {
  [[ -z "${ZOCIETY_TURN_ID:-}" ]] \
    || die "asks come from the operator, not a loop turn (ZOCIETY_TURN_ID is set)"
  [[ -z "$(git status --porcelain 2>/dev/null)" ]] \
    || die "the working tree has changes; commit or remove them first (bin/zevent stages everything into the event)"
}

# run_going: the run going in this worktree, unless it is our caller
# (bin/zloop records its own --ask and the queue directly). A fresh record
# from the other side of the container counts: its pid cannot be checked
# from here, and a queued ask waits for the next run at worst.
run_going() {
  local pid
  if pid=$(zrun_live_pid); then
    [[ "$pid" != "$PPID" ]] || return 1
    echo "pid $pid"
    return 0
  fi
  zrun_foreign
}

# Ids run over the whole history, not bin/zstate's window, so one is never
# reused: the highest ask-N any [ask] subject or queued ask names (in the
# inbox or in a drain under way), plus one.
next_id() {
  local last q
  last=$({ git log --format=%s --grep='^\[ask\] ' 2>/dev/null
           for q in "$ZRUN_INBOX" "$ZRUN_INBOX.draining"; do
             [[ ! -s "$q" ]] || jq -r '.id // empty' "$q" 2>/dev/null
           done
         } | grep -o 'ask-[0-9]*' | cut -d- -f2 | sort -n | tail -n1)
  echo "ask-$(( ${last:-0} + 1 ))"
}

# queue <json>: append an ask or a close for the run to record
queue() {
  mkdir -p "$(dirname "$ZRUN_INBOX")"
  printf '%s\n' "$1" >> "$ZRUN_INBOX"
}

record_ask() {
  local id="$1" text="$2" cycles="$3" data state
  data=$(jq -nc --arg id "$id" --arg text "$text" --argjson cycles "$cycles" \
    '{id: $id, text: $text, cycles: $cycles}')
  # Explicit: drain calls this where set -e does not apply.
  bin/zevent ask operator "$id: $text" "$data" >/dev/null || return 1
  state=$(bin/zstate)
  echo "zask: recorded $id ($(printf '%s' "$state" | jq -r '.asks_open') open)"
  if [[ "$(printf '%s' "$state" | jq -r '.ask.id // empty')" == "$id" && "$(printf '%s' "$state" | jq -r '.needs.answers')" == "1" ]]; then
    echo "zask: cycle $(printf '%s' "$state" | jq -r '.cycle') owes it an answer; bin/zask --show $id reads it once given"
  else
    echo "zask: queued behind the asks ahead of it, or for the next cycle if this one is complete"
  fi
}

close_ask() {
  local data
  data=$(jq -nc --arg id "$1" --arg reason "$2" '{id: $id, close: true, reason: $reason}')
  bin/zevent ask operator "close $1: $2" "$data" >/dev/null || return 1
  echo "zask: closed $1"
}

# drain_one <json>: record one queued line. 0 when it is done with (recorded
# now or by a drain that was cut off, or dropped because it no longer
# applies), 1 when it could not be recorded and must stay queued. Explicit
# returns throughout: drain calls this where set -e does not apply.
drain_one() {
  local line="$1" id text cycles reason asks open subject
  id=$(printf '%s' "$line" | jq -r '.close // empty' 2>/dev/null) || id=""
  if [[ -n "$id" ]]; then
    reason=$(printf '%s' "$line" | jq -r '.reason')
    asks=$(bin/zstate --asks) || return 1
    open=$(printf '%s' "$asks" | jq -r --arg id "$id" '.[] | select(.id == $id) | .open') || return 1
    if [[ "$open" != "true" ]]; then
      echo "zask: dropped the queued close of $id: it is no longer open" >&2
      return 0
    fi
    close_ask "$id" "$reason" || return 1
    return 0
  fi
  text=$(printf '%s' "$line" | jq -r '.text // empty' 2>/dev/null) || text=""
  if [[ -z "$text" ]]; then
    echo "zask: dropped an unreadable queued line: $line" >&2
    return 0
  fi
  cycles=$(printf '%s' "$line" | jq -r '.cycles // 1')
  id=$(printf '%s' "$line" | jq -r '.id // empty')
  # The id given at queue time, unless something took it since; the same id
  # and text already recorded is this ask, from a drain that was cut off.
  if [[ -n "$id" ]]; then
    subject=$(git log -n1 --format=%s --grep="^\[ask\] operator: $id: " 2>/dev/null) || return 1
    if [[ "$subject" == "[ask] operator: $id: ${text%%$'\n'*}" ]]; then
      echo "zask: $id was already recorded" >&2
      return 0
    fi
    [[ -z "$subject" ]] || id=""
  fi
  [[ -n "$id" ]] || id=$(next_id)
  record_ask "$id" "$text" "$cycles"
}

# drain: record the queue in order. The inbox is taken aside with mv, so an
# ask queued meanwhile starts a new one, and appended to what a cut-off
# drain left in .draining. On a failure the line that failed and those after
# it stay in .draining, ahead of anything queued since.
drain() {
  local work="$ZRUN_INBOX.draining" line lines=() i
  [[ -s "$ZRUN_INBOX" || -s "$work" ]] || return 0
  record_guard
  if [[ -e "$ZRUN_INBOX" ]]; then
    mv "$ZRUN_INBOX" "$ZRUN_INBOX.taken"
    cat "$ZRUN_INBOX.taken" >> "$work"
    rm -f "$ZRUN_INBOX.taken"
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    lines+=("$line")
  done < "$work"
  for ((i = 0; i < ${#lines[@]}; i++)); do
    [[ -n "${lines[i]}" ]] || continue
    if ! drain_one "${lines[i]}"; then
      printf '%s\n' "${lines[@]:i}" > "$work.rest"
      mv "$work.rest" "$work"
      return 1
    fi
  done
  rm -f "$work"
}

CYCLES=1
case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --list)
    bin/zstate --asks | jq -r '
      if length == 0 then "No asks yet. bin/zask \"<question>\" records one."
      else .[] | (if .open then "open" elif .closed then "closed" else "answered" end) as $s
        | "\(.id)  \($s)  answered in \(.answered) of \(.cycles) cycle(s), asked in cycle \(.asked_cycle)\n  \(.text)"
          + (.answers | map("\n  cycle \(.cycle): \(.file) (\(.commit[0:7]))") | join(""))
      end'
    exit 0
    ;;
  --show)
    [[ -n "${2:-}" ]] || die "--show requires an ask id (bin/zask --list)"
    ASK=$(ask_by_id "$2")
    [[ -n "$ASK" ]] || die "no ask '$2' (bin/zask --list)"
    printf '%s' "$ASK" | jq -r '"# \(.id): \(.text)\n\n\(if .open then "open" elif .closed then "closed" else "answered" end), answered in \(.answered) of \(.cycles) cycle(s), asked in cycle \(.asked_cycle)"'
    while IFS=$'\t' read -r cycle file commit; do
      printf '\n## cycle %s: %s (%s)\n\n' "$cycle" "$file" "${commit:0:7}"
      git --no-pager show "$commit:$file" 2>/dev/null || echo "(not readable at $commit)"
    done < <(printf '%s' "$ASK" | jq -r '.answers[] | [.cycle, .file, .commit] | @tsv')
    exit 0
    ;;
  --close)
    [[ -n "${2:-}" && -n "${3:-}" ]] || die "--close requires an ask id and a reason"
    [[ -z "${ZOCIETY_TURN_ID:-}" ]] \
      || die "asks come from the operator, not a loop turn (ZOCIETY_TURN_ID is set)"
    ASK=$(ask_by_id "$2")
    [[ -n "$ASK" ]] || die "no ask '$2' (bin/zask --list)"
    [[ "$(printf '%s' "$ASK" | jq -r '.open')" == "true" ]] || die "ask '$2' is not open"
    if pid=$(run_going); then
      queue "$(jq -nc --arg id "$2" --arg reason "$3" '{close: $id, reason: $reason}')"
      echo "zask: a run is going here ($pid); the close of $2 is queued for its next turn"
      exit 0
    fi
    record_guard
    close_ask "$2" "$3"
    exit 0
    ;;
  --drain)
    drain
    exit 0
    ;;
  --cycles)
    [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || die "--cycles expects a positive integer, got '${2:-}'"
    CYCLES="$2"
    shift 2
    ;;
  -*)
    die "unknown option '$1'"
    ;;
esac

TEXT="${1:-}"
[[ $# -le 1 ]] || die "quote the question as one argument"
[[ -n "${TEXT//[[:space:]]/}" ]] || { usage >&2; exit 1; }
[[ -z "${ZOCIETY_TURN_ID:-}" ]] \
  || die "asks come from the operator, not a loop turn (ZOCIETY_TURN_ID is set)"
ID=$(next_id)
if pid=$(run_going); then
  queue "$(jq -nc --arg id "$ID" --arg text "$TEXT" --argjson cycles "$CYCLES" \
    '{id: $id, text: $text, cycles: $cycles}')"
  echo "zask: a run is going here ($pid); $ID is queued and recorded before its next turn"
  echo "zask: bin/zloop status shows the queue; bin/zask --show $ID reads the answer once given"
  exit 0
fi
record_guard
record_ask "$ID" "$TEXT" "$CYCLES"
