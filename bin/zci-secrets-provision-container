#!/usr/bin/python3 -I
"""Container-only provisioning: mounted inputs, tmpfs staging, fixed output."""

import os
from pathlib import Path
import resource
import runpy
import signal
import stat
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SOURCE = Path("/run/secrets")
STAGING = Path("/tmp")
REPORT = ROOT / ".zociety/ci-secrets-provisioned.json"


def require_container():
    # Do not accept the caller's `container` environment variable as evidence.
    if not any(Path(p).is_file() for p in ("/run/.containerenv", "/.dockerenv")):
        raise RuntimeError
    # Require the launcher's tmpfs; ignore host TMPDIR and persistent home.
    mounts = Path("/proc/self/mountinfo").read_text().splitlines()
    if not any(line.split()[4] == "/tmp" and line.split(" - ", 1)[1].split()[0] == "tmpfs"
               for line in mounts):
        raise RuntimeError


def interrupted(signum, frame):
    raise KeyboardInterrupt


def provision():
    require_container()
    if len(sys.argv) != 1:
        raise RuntimeError
    os.umask(0o077)
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    # zociety exec loads auth for general commands; this command uses files
    # exclusively. No environment fallback, debug switch, or subprocess.
    os.environ.clear()
    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, interrupted)
    REPORT.unlink(missing_ok=True)
    transfer = runpy.run_path(str(ROOT / "bin/zci-secrets"))
    with tempfile.TemporaryDirectory(prefix="zociety-secrets-", dir=STAGING) as directory:
        stage = Path(directory).resolve()
        for item in transfer["SECRETS"]:
            source = SOURCE / item.filename
            # The mounted armored key is opaque data; no GPG import/export.
            fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, "rb") as stream:
                if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                    raise RuntimeError
                value = stream.read(10001)
            if not value or len(value) > 10000:
                raise RuntimeError
            (stage / item.filename).write_bytes(value)
            validated = transfer["read_secret"](item, stage)
            prefixes = {"gitlab_token": ("glpat-",),
                        "claude_oauth_token": ("sk-ant-oat",),
                        "github_token": ("ghp_", "github_pat_")}
            if item.filename in prefixes and not validated.startswith(prefixes[item.filename]):
                raise RuntimeError
        # Validate all inputs before the first API read. Preserve existing vars.
        return transfer["entrypoint"]([
            "--set", "--source-dir", str(stage), "--report", str(REPORT),
        ])


def entrypoint():
    try:
        return provision()
    except KeyboardInterrupt:
        sys.stderr.write("zci-secrets-provision: interrupted\n")
        return 130
    except Exception:
        # Never forward paths, values, API bodies, or exception text.
        sys.stderr.write("zci-secrets-provision: container-preflight-or-staging-failed\n")
        return 2


if __name__ == "__main__":
    sys.exit(entrypoint())
