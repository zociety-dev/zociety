#!/usr/bin/env -S python3 -I
"""Exercise secret transfer with fresh synthetic canaries, never real credentials.

Failure messages are fixed labels. Even a failed no-disclosure assertion must
not print the observed output, exception, request body, or canary itself.
"""

import argparse
import base64
import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import tempfile
import urllib.error
from unittest.mock import patch

SOURCE = Path(__file__).resolve().with_name("zci-secrets")
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("zci_secrets", str(SOURCE))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = module
loader.exec_module(module)
PASSED = []
CURRENT_CHECK = "initialization"


def check(label, condition):
    global CURRENT_CHECK
    CURRENT_CHECK = label
    if not condition:
        raise AssertionError(label)  # Never attach values or captured output.
    PASSED.append(label)


class Terminal(io.StringIO):
    def isatty(self):
        return True


class Response(io.BytesIO):
    pass


class ErrorBody(io.BytesIO):
    reads = 0

    def read(self, *args):
        self.reads += 1
        return super().read(*args)


class Remote:
    def __init__(self, initial=None, fault=None):
        self.storage = dict(initial or {})
        self.fault = fault
        self.requests = []
        self.error_body = None

    def open(self, request, timeout):
        self.requests.append(request)
        method = request.get_method()
        if self.fault:
            self.fault(self, method)
        key = request.full_url.split("/variables/")[-1].split("?")[0]
        if method == "GET":
            if key not in self.storage:
                raise urllib.error.HTTPError(request.full_url, 404, "missing", {}, io.BytesIO())
            return Response(json.dumps(self.storage[key]).encode())
        body = json.loads(request.data)
        value = dict(body, hidden=True)
        self.storage[body["key"]] = value
        return Response(json.dumps(value).encode())


def variants(values):
    result = set()
    for value in values:
        result.update((value, json.dumps(value)[1:-1], value.encode().hex(),
                       base64.b64encode(value.encode()).decode()))
    return result


def fixture(root):
    directory = root / secrets.token_hex(5)
    directory.mkdir(mode=0o700)
    values = {}
    for item in module.SECRETS:
        value = secrets.token_urlsafe(36)
        if item.encoding == "base64":
            value = "-----BEGIN PGP " + "PRIVATE KEY BLOCK-----\n" + value + "\n-----END PGP PRIVATE KEY BLOCK-----\n"
        values[item.key] = value
        if item.filename:
            path = directory / item.filename
            path.write_text(value)
            path.chmod(0o600)
    return directory, values


def run(directory, values, remote, *args, terminal=False):
    stdout = Terminal() if terminal else io.StringIO()
    stderr = io.StringIO()
    stdin = Terminal() if terminal else io.StringIO()
    report = directory / "status.json"
    argv = ["--source-dir", str(directory), "--report", str(report), *args]
    # Secrets are generated inside the harness; none enter the invoking
    # agent's tool arguments, environment, test output or failure messages.
    env = {"ZOCIETY_BLIND_KEY": values[module.SECRETS[3].key],
           "GH_DEBUG": "api", "GLAB_DEBUG": "true", "PYTHONINSPECT": "1"}
    with patch.dict(os.environ, env, clear=True), \
         patch.object(sys, "stdin", stdin), \
         contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr), \
         patch.object(subprocess, "Popen", side_effect=AssertionError("child-process-forbidden")):
        rc = module.entrypoint(argv, lambda token: module.GitLab(token, opener=remote))
    return rc, stdout.getvalue(), stderr.getvalue(), report.read_text() if report.exists() else "", argv


def no_disclosure(label, values, result, remote):
    _, out, err, report, argv = result
    encoded = variants(values.values())
    transcripts = (out, err, report, json.dumps(argv),
                   json.dumps([request.full_url for request in remote.requests]))
    check(label, all(value not in text for value in encoded for text in transcripts))
    if out:
        doc = json.loads(out)
        check(label + " report allowlist", set(doc) == {"project_id", "scope", "debug_disclosure", "variables"}
              and doc["project_id"] == module.PROJECT and doc["scope"] == module.SCOPE
              and doc["debug_disclosure"] is False
              and all(set(row) == {"key", "state"} and row["key"] in module.KEYS
                      and row["state"] in module.STATES for row in doc["variables"]))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--report", type=Path)
    args = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix="zci-secret-proof-") as tmp:
        root = Path(tmp)
        normal_transcripts = []
        for iteration in range(8):
            directory, values = fixture(root)
            remote = Remote()
            result = run(directory, values, remote, "--set")
            check("create succeeds with synthetic canaries", result[0] == 0)
            no_disclosure("create has no raw or encoded disclosure", values, result, remote)
            normal_transcripts.append(result[1:4])
            check("all five values arrive only in the HTTPS payload", len(remote.storage) == 5 and all(
                remote.storage[item.key]["value"] == ("base64:" + base64.b64encode(values[item.key].encode()).decode()
                                                        if item.encoding == "base64" else values[item.key])
                for item in module.SECRETS))
            check("all five variables are hidden protected raw file variables", all(
                module.valid_settings(value) for value in remote.storage.values()))
            check("destination is fixed to this GitLab project", all(
                r.full_url.startswith(module.API) and r.full_url.split("?")[0] in
                {module.API, *(module.API + "/" + key for key in module.KEYS)} for r in remote.requests))
            check("authentication stays in the HTTPS header", all(
                r.get_header("Private-token") == values[module.KEYS[0]] for r in remote.requests))
            result = run(directory, values, remote)
            check("check succeeds without mutation", result[0] == 0)
            no_disclosure("check does not disclose API-returned values", values, result, remote)
            before = len(remote.requests)
            result = run(directory, values, remote, "--set")
            check("set is idempotent without force", result[0] == 0 and all(
                r.get_method() == "GET" for r in remote.requests[before:]))
            result = run(directory, values, remote, "--set", "--force")
            check("force updates existing hidden variables", result[0] == 0)
            no_disclosure("update does not disclose values", values, result, remote)
        check("normal output and reports are identical across eight unrelated secret sets",
              all(transcript == normal_transcripts[0] for transcript in normal_transcripts))

        directory, values = fixture(root)
        leak = "\n".join(variants(values.values()))
        for label, exception in (
            ("HTTP errors", lambda remote: urllib.error.HTTPError(module.API, 422, leak, {}, remote.error_body)),
            ("network errors", lambda remote: urllib.error.URLError(leak)),
            ("unexpected exceptions", lambda remote: RuntimeError(leak)),
            ("forged safe exceptions", lambda remote: module.SafeFailure(leak)),
            ("non-string safe exceptions", lambda remote: module.SafeFailure([leak])),
            ("interrupts", lambda remote: KeyboardInterrupt(leak)),
        ):
            def fault(remote, method, exception=exception):
                remote.error_body = ErrorBody(leak.encode())
                raise exception(remote)
            remote = Remote(fault=fault)
            result = run(directory, values, remote, "--set")
            check(label + " fail closed", result[0] in {2, 130})
            no_disclosure(label + " suppress echoed raw and encoded secrets", values, result, remote)
            check(label + " response body is never read", remote.error_body.reads == 0)
            check(label + " leaves no stale success receipt", result[3] == "")

        class BadJSON(Remote):
            def open(self, request, timeout):
                self.requests.append(request)
                return Response(leak.encode())
        remote = BadJSON()
        result = run(directory, values, remote)
        check("malformed JSON fails closed", result[0] == 2)
        no_disclosure("malformed JSON cannot become a traceback", values, result, remote)

        def write_fault(remote, method):
            if method == "POST":
                raise RuntimeError(leak)
        remote = Remote(fault=write_fault)
        result = run(directory, values, remote, "--set")
        check("write failure fails closed", result[0] == 2)
        no_disclosure("write failure suppresses reflected payloads", values, result, remote)

        for options, terminal in ((["--debug-show-values"], False),
                                  (["--confirm-secret-disclosure"], True),
                                  (["--debug-show-values", "--confirm-secret-disclosure"], False)):
            remote = Remote()
            result = run(directory, values, remote, *options, terminal=terminal)
            check("debug requires both flags and a terminal before reading sources", result[0] == 2 and not remote.requests)
            no_disclosure("unconfirmed debug has no disclosure", values, result, remote)
        remote = Remote()
        result = run(directory, values, remote, "--set", "--debug-show-values", "--confirm-secret-disclosure", terminal=True)
        check("confirmed terminal debug intentionally discloses synthetic values", result[0] == 0
              and values[module.KEYS[0]] in result[1] and "DEBUG:" in result[2])
        check("debug report still contains no values", not any(v in result[3] for v in variants(values.values())))

        # Invalid source data is preflighted before any remote write.
        for invalid in ("", "short", "has whitespace in a secret", "x" * 10001):
            bad = directory / "github_token"
            bad.write_text(invalid)
            remote = Remote()
            result = run(directory, values, remote, "--set")
            check("invalid source prevents every write", result[0] == 2 and all(r.get_method() == "GET" for r in remote.requests))
            no_disclosure("source validation prints no contents", values, result, remote)
        bad.write_text(values[module.KEYS[-1]])
        remote = Remote({module.KEYS[0]: {"hidden": False, "value": leak}})
        result = run(directory, values, remote, "--set", "--force")
        check("visible existing variable is not silently overwritten", result[0] == 2 and all(r.get_method() == "GET" for r in remote.requests))
        no_disclosure("visible existing values stay out of reports", values, result, remote)
        remote = Remote()
        result = run(directory, values, remote, values[module.KEYS[0]])
        check("usage errors do not echo mistaken value arguments", result[0] == 2 and values[module.KEYS[0]] not in result[2])
        check("redirects cannot forward the credential", module.NoRedirect().redirect_request(None, None, 302, leak, {}, "https://example.invalid") is None)

    result = {"passed": len(PASSED), "failed": 0, "synthetic_only": True,
              "invariants": ["metadata-only normal output", "metadata-only reports", "no child processes",
                             "no secret argv or URLs", "fixed HTTPS destination", "untrusted errors suppressed",
                             "terminal and explicit confirmation required for debug"]}
    if args.report:
        args.report.parent.mkdir(parents=True, exist_ok=True)
        args.report.write_text(json.dumps(result, sort_keys=True) + "\n")
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        # A regression must not leak the captured canary through test diagnostics.
        trace = exc.__traceback__
        while trace.tb_next:
            trace = trace.tb_next
        print(json.dumps({"failed": 1, "synthetic_only": True, "last_check": CURRENT_CHECK,
                          "line": trace.tb_lineno, "error": "captured details suppressed"}))
        sys.exit(1)
