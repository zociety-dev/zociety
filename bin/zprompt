#!/usr/bin/env bash
# zprompt - The per-iteration prompt every loop runner hands the agent
#
# Usage:
#   bin/zprompt [--budget N] [--no-context]
#   bin/zprompt -h | --help
#
# Options:
#   --budget N     Seconds of work the iteration has. Omit (or 0) for a run
#                  with no budget: the time paragraph is left out entirely
#                  rather than stating a number nobody enforces.
#   --no-context   Omit the generated "where things stand" block.
#
# Prints the prompt on stdout. Single source of truth so bin/zloop (local) and
# bin/zga-loop (GitHub Actions) cannot drift.
#
# Two things go in besides "read PROMPT.md":
#
#   Context. Every fresh iteration used to spend its first 40-50s and 8-12
#   tool calls re-deriving the same facts: find PROMPT.md, bin/zstate, ls bin,
#   cat AGENTS.md, git log, show the latest [direction] and [heap-death], then
#   two or three `bin/z* --help` calls to learn an invocation. With a 60s
#   budget that was the whole turn (rev64-attempt4: five iterations, zero
#   commits). The block below hands those facts over -- state, branch, latest
#   direction and heap-death, the short genesis leg (bin/zstate .next/.needs,
#   the field PROMPT.md tells the agent to obey), recent log, one usage line
#   per agent command and the genesis thresholds -- so the turn starts at the
#   decision, not the archaeology. PROMPT.md is untouched: it is the cycle's
#   constitution and bin/zcycle-id bumps the rev when it changes.
#
#   Both loops regenerate this per iteration, not once per run: the block is
#   the state after the previous turn's commits, and a run-wide prompt goes
#   stale on the first commit. One call costs ~1.3s against this repo.
#
#   Budget. An agent that is not told its budget cannot scope a turn to it or
#   commit before the time runs out, and every iteration then dies mid-work
#   with nothing to show. See bin/zloop --help (Time).
#
# Runs from the repo root (as both loops do). Every context probe is
# best-effort: a failing git or bin/zstate degrades the block, never the
# prompt.

set -euo pipefail

BUDGET=0
CONTEXT=1

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --budget)
      [[ $# -ge 2 ]] || { echo "zprompt: $1 requires a value" >&2; exit 2; }
      [[ "$2" =~ ^[0-9]+$ ]] \
        || { echo "zprompt: --budget expects a non-negative integer, got '$2'" >&2; exit 2; }
      BUDGET="$2"
      shift
      ;;
    --no-context)
      CONTEXT=0
      ;;
    *)
      echo "zprompt: unknown argument '$1'" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

printf '%s\n' "Read PROMPT.md and follow its instructions."

if [[ "$CONTEXT" -eq 1 ]]; then
  state=$(bin/zstate 2>/dev/null | jq -c . 2>/dev/null) || state=""
  branch=$(git branch --show-current 2>/dev/null) || branch=""
  recent=$(git --no-pager log --oneline -10 2>/dev/null) || recent=""
  direction=$(git --no-pager log -1 --format=%s --grep='^\[direction\]' 2>/dev/null) || direction=""
  heap_death=$(git --no-pager log -1 --format=%s --grep='^\[heap-death\]' 2>/dev/null) || heap_death=""
  # The agent-facing z* commands: everything the loop plumbing, renderers and
  # maintenance scripts are not. One line each, usage and purpose lifted from
  # the script's own header, because a bare list of names still costs the turn
  # two or three `bin/z* --help` calls before it can invoke anything.
  commands=""
  for f in bin/z*; do
    [[ -x "$f" ]] || continue
    base="${f#bin/}"
    case "$base" in
      zloop*|zga-*|zstop-*|zprompt|zrender|zagent|zblind|zcheck|zvalidate|zdump|zlog|zstate|zsite-*|zmd2html|zgit|zgh|zociety|zcycle-id|zworkflow*) continue ;;
    esac
    # Usage: the "# Usage: bin/z..." one-liner, or the first "#   bin/z..."
    # under a "# Usage:" heading. The "-h | --help" form is not news.
    usage=$(sed -n -e 's/^# Usage: *\(bin\/.*\)$/\1/p' \
                   -e 's/^#   \(bin\/z[a-z-]*\)$/\1/p' \
                   -e 's/^#   \(bin\/z[a-z-]* .*\)$/\1/p' "$f" 2>/dev/null \
              | grep -v -e '-h | --help' | head -n1) || usage=""
    [[ -n "$usage" ]] || usage="$f"
    purpose=$(sed -n "s/^# ${base}: *//p" "$f" 2>/dev/null | head -n1) || purpose=""
    if [[ -n "$purpose" ]]; then
      commands="$commands  $usage - $purpose"$'\n'
    else
      commands="$commands  $usage"$'\n'
    fi
  done

  # The leg bin/zstate says is short, lifted out of the JSON above. PROMPT.md
  # tells the agent to obey .next; leaving it buried in a one-line blob was
  # the whole failure this field exists to fix (iterations piling onto
  # bin/zjoin while rules never started).
  nxt=""
  if [[ -n "$state" ]]; then
    nxt=$(printf '%s' "$state" | jq -r '
      if .next == null then empty
      else .next + (if (.needs // empty) then
        " (still needed: \(.needs.members) member(s), \(.needs.rules) passed rule(s), \(.needs.stuff) stuff)"
        else "" end)
      end' 2>/dev/null) || nxt=""
  fi

  printf '\n%s\n' "## Where things stand (generated for this turn; do not re-derive it)"
  [[ -n "$state" ]]      && printf '%s\n' "bin/zstate: $state"
  [[ -n "$nxt" ]]        && printf '%s\n' "Do this: $nxt"
  [[ -n "$branch" ]]     && printf '%s\n' "Branch: $branch"
  [[ -n "$direction" ]]  && printf '%s\n' "Latest direction: $direction"
  [[ -n "$heap_death" ]] && printf '%s\n' "Latest heap-death: $heap_death"
  if [[ -n "$recent" ]]; then
    printf '%s\n' "Recent commits:"
    printf '%s\n' "$recent" | sed 's/^/  /'
  fi
  if [[ -n "$commands" ]]; then
    printf '%s\n' "Commands (each also takes --help; you should not need to run it):"
    printf '%s' "$commands"
  fi
  # The thresholds an iteration otherwise greps AGENTS.md for. Kept in step
  # with bin/zstate's genesis check and the "Genesis Thresholds" section.
  printf '%s\n' "Genesis completes at 3+ members, 2+ passed rules, 3+ stuff items (bin/zstate .genesis)."
  printf '%s\n' "Protocol: AGENTS.md. Read the section you need, not the file."
fi

if [[ "$BUDGET" -gt 0 ]]; then
  printf '\n%s\n' "You have about ${BUDGET} seconds of wall-clock time for this turn. Scope
your work to fit it and commit before it runs out: an uncommitted change does
not survive the turn. Prefer one small finished contribution over a large
unfinished one. If the work does not fit, commit what does and leave a note in
the commit message saying what remains."
fi
