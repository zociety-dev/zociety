#!/bin/bash
# zevent: Create a zociety event commit
# Usage: bin/zevent <type> <agent> <description> [data_json]

set -e

TYPE="$1"
AGENT="$2"
DESC="$3"
DATA="${4}"
if [[ -z "$DATA" ]]; then
  DATA="{}"
fi

if [[ -z "$TYPE" || -z "$AGENT" || -z "$DESC" ]]; then
  echo "Usage: bin/zevent <type> <agent> <description> [data_json]" >&2
  exit 1
fi

# A loop runner supplies one opaque turn identifier per agent invocation.
# Genesis credits are calculated from distinct identifiers, so one invocation
# cannot manufacture a whole society by emitting several qualifying events.
SESSION_ID="${ZOCIETY_TURN_ID:-}"
case "$TYPE" in
  join|pass|stuff)
    if [[ -z "$SESSION_ID" ]]; then
      echo "zevent: $TYPE requires ZOCIETY_TURN_ID from a loop runner" >&2
      exit 1
    fi
    ;;
esac

# Get current state
CURRENT=$(bin/zstate)
CYCLE=$(echo "$CURRENT" | jq -r '.cycle')
SEQ=$(echo "$CURRENT" | jq -r '.seq + 1')

# Get current genesis counts from last event
MEMBERS=$(echo "$CURRENT" | jq -r '.genesis.members')
RULES=$(echo "$CURRENT" | jq -r '.genesis.rules')
STUFF=$(echo "$CURRENT" | jq -r '.genesis.stuff')
SESSION_CREDITS=$(echo "$CURRENT" | jq -c --arg session "$SESSION_ID" '.session_credits[$session] // {}')

# Adjust counts based on event type
case "$TYPE" in
  join)
    [[ "$(echo "$SESSION_CREDITS" | jq -r '.join // false')" == "true" ]] || MEMBERS=$((MEMBERS + 1))
    ;;
  pass)
    [[ "$(echo "$SESSION_CREDITS" | jq -r '.pass // false')" == "true" ]] || RULES=$((RULES + 1))
    ;;
  stuff)
    [[ "$(echo "$SESSION_CREDITS" | jq -r '.stuff // false')" == "true" ]] || STUFF=$((STUFF + 1))
    ;;
esac

# Check completion (as JSON boolean)
if [[ $MEMBERS -ge 3 && $RULES -ge 2 && $STUFF -ge 3 ]]; then
  COMPLETE="true"
else
  COMPLETE="false"
fi

# Detect runtime environment
if [[ -n "$GITHUB_ACTIONS" ]]; then
  RUNTIME="github-actions"
  RUNTIME_ID="${GITHUB_RUN_ID:-unknown}"
elif [[ -n "$CODESPACES" ]]; then
  RUNTIME="codespaces"
  RUNTIME_ID="${CODESPACE_NAME:-unknown}"
else
  RUNTIME="local"
  RUNTIME_ID="$(hostname 2>/dev/null || echo 'unknown')"
fi

# Build event JSON
EVENT=$(jq -n \
  --arg type "$TYPE" \
  --arg agent "$AGENT" \
  --argjson cycle "$CYCLE" \
  --argjson seq "$SEQ" \
  --argjson members "$MEMBERS" \
  --argjson rules "$RULES" \
  --argjson stuff "$STUFF" \
  --argjson data "$DATA" \
  --arg complete "$COMPLETE" \
  --arg runtime "$RUNTIME" \
  --arg runtime_id "$RUNTIME_ID" \
  --arg session "$SESSION_ID" \
  '{
    z: 1,
    event: $type,
    cycle: $cycle,
    seq: $seq,
    agent: $agent,
    ts: (now | todate),
    runtime: {
      env: $runtime,
      id: $runtime_id,
      session: (if $session == "" then null else $session end)
    },
    state: {
      members: $members,
      rules: $rules,
      stuff: $stuff,
      complete: ($complete == "true")
    },
    data: $data
  }'
)

# Create commit message with compact JSON trailer
MSG="[$TYPE] $AGENT: $DESC

$(echo "$EVENT" | jq -c .)"

# Stage and commit (allow empty for events that don't change files).
# Events always run repository hooks; constraints are part of the experiment.
git add -A
git commit --allow-empty -m "$MSG"

echo "$EVENT" | jq .
