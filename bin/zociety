#!/bin/bash
# zociety: Run Claude Code inside the containerized zociety environment
#
# Usage:
#   bin/zociety                    # Interactive Claude session
#   bin/zociety login              # Login to Claude (Max subscription)
#   bin/zociety bash               # Shell inside container
#   bin/zociety -- [claude args]   # Pass args to claude
#   bin/zociety <any command>      # Run arbitrary command in container

set -e

# Prevent running inside a container - this is a host launcher
reject_container() {
  local in_container=false

  # Method 1: runtime files
  [[ -f /.dockerenv ]] && in_container=true
  [[ -f /run/.containerenv ]] && in_container=true

  # Method 2: environment variable (Podman sets container=podman)
  [[ -n "${container:-}" ]] && in_container=true

  # Method 3: cgroup detection
  if grep -qE '(docker|containerd|kubepods|libpod)' /proc/1/cgroup 2>/dev/null; then
    in_container=true
  fi

  if [[ "$in_container" == "true" ]]; then
    echo "ERROR: This launcher must run on the host, not inside a container." >&2
    echo "Use the zociety scripts directly inside the container." >&2
    exit 1
  fi
}

reject_container

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
CONTAINER_DIR="$PROJECT_DIR/container"
IMAGE_NAME="localhost/zociety:latest"
CONTAINER_NAME="zociety-sandbox"
OAUTH_TOKEN_FILE="$CONTAINER_DIR/secrets/claude_oauth_token"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[zociety]${NC} $1" >&2; }
log_warn()  { echo -e "${YELLOW}[zociety]${NC} $1" >&2; }
log_error() { echo -e "${RED}[zociety]${NC} $1" >&2; }
log_cmd()   { echo -e "${CYAN}[zociety]${NC} $1" >&2; }

check_prereqs() {
    if ! command -v podman &> /dev/null; then
        log_error "podman not found. Install it first:"
        log_error "  brew install podman    # macOS"
        log_error "  apt install podman     # Debian/Ubuntu"
        exit 1
    fi
}

build_image() {
    log_info "Building container image..."
    podman build -t "$IMAGE_NAME" "$CONTAINER_DIR"
    log_info "Image built: $IMAGE_NAME"
}

image_exists() {
    podman image exists "$IMAGE_NAME" 2>/dev/null
}

ensure_image() {
    if ! image_exists; then
        log_warn "Image not found. Building..."
        build_image
    fi
}

# Determine if we need interactive mode (-i flag)
# Note: no TTY for non-interactive runs. With -t but no -i, gh/git terminal
# queries (OSC 11, CSI 6n) reach the host terminal and its replies echo into
# the host shell as garbage because nothing in the container reads stdin.
# -i enables signal forwarding (ctrl-C) and is needed for long-running scripts
needs_interactive() {
    local cmd="$1"
    case "$cmd" in
        claude|bash|login|sh)
            return 0  # true - needs interactive stdin
            ;;
        *)
            # Scripts that run claude internally need -i for ctrl-C to work
            # The scripts themselves use </dev/null to prevent stdin issues
            if [[ "$cmd" == bin/zloop* ]]; then
                return 0  # zloop needs -i for signal handling
            fi
            return 1  # false - just needs TTY for output
            ;;
    esac
}

# Mint a long-lived (~1yr) subscription OAuth token on the HOST and save it to
# the secrets dir. Runs the host's Claude Code (not the container) because the
# OAuth browser flow needs a real browser and the container is headless/read-only.
# The saved token is injected as CLAUDE_CODE_OAUTH_TOKEN by run_container().
setup_token() {
    if ! command -v claude &> /dev/null; then
        log_error "host 'claude' not found. Install/upgrade Claude Code on the host first."
        exit 1
    fi

    mkdir -p "$(dirname "$OAUTH_TOKEN_FILE")"

    log_info "Running host 'claude setup-token'."
    log_info "Approve the browser flow, then copy the token it prints (starts with sk-ant-oat)."
    echo

    # Run interactively; do NOT capture stdout. setup-token renders a full-screen
    # TUI, so a command substitution grabs the whole rendered screen (escape codes
    # + welcome text + the token glued to trailing prose), not a clean token. Let
    # the UI draw to the terminal and have the user paste the token back.
    if ! claude setup-token; then
        log_error "claude setup-token failed."
        exit 1
    fi

    echo
    local token
    read -rsp "Paste the token here: " token
    echo
    token="$(printf '%s' "$token" | tr -d '[:space:]')"
    if [[ "$token" != sk-ant-oat* ]]; then
        log_error "That does not look like an OAuth token (expected sk-ant-oat...)."
        exit 1
    fi

    printf '%s\n' "$token" > "$OAUTH_TOKEN_FILE"
    chmod 600 "$OAUTH_TOKEN_FILE"

    log_info "Saved token to $OAUTH_TOKEN_FILE (0600)."
    log_info "It is injected as CLAUDE_CODE_OAUTH_TOKEN on the next 'bin/zociety' run."
    log_warn "If the image predates CLAUDE_CODE_OAUTH_TOKEN support, rebuild it first:"
    log_warn "  bin/zociety --rebuild"
}

# forward_env: fill ENV_ARGS with `--env NAME` for the host variables a
# command in the container may read. `--env NAME` (no value) passes the
# current value through. Used by run_container and by exec: an exec into a
# container that is already up used to forward nothing, so a loop turn's
# ZOCIETY_TURN_ID, the ZLOOP_* and ZSTOP_* knobs and CLAUDECODE were lost
# whenever a session held the container.
#
# ZLOOP_* tuning vars (VERBOSE, TIMEOUT, DEBUG, STOP), ZSTOP_* stop predicate
# knobs (BUDGET, PATIENCE, ...), ZTHREAD_* (MAX: cycles per subject,
# bin/zthread), ZHEAP_DEATH_* (ANY_BRANCH),
# ZOCIETY_AGENT_CLIENT, ANTHROPIC_MODEL, GEMINI_* vars, ZOCIETY_BLIND_KEY
# (bin/zblind seal/reveal passphrase; bin/zagent strips it from the agent's
# env), ZOCIETY_TURN_ID (a loop turn's id, so a z* event command a turn runs
# through bin/zociety is credited to it instead of refused) and CLAUDECODE
# (set by Claude Code in its shells; the prepare-commit-msg hook running in
# the container reads it to add the Agent: trailer). Also NO_COLOR if set.
ENV_ARGS=()
forward_env() {
    ENV_ARGS=()
    # compgen -e: the exported names, one per line. Parsing `env` instead
    # read each further line of a multi-line value as a name of its own, so
    # a value holding "ZLOOP_GHOST=1" on a line forwarded --env ZLOOP_GHOST.
    local _name
    while read -r _name; do
        case "$_name" in
            ZLOOP_*|ZSTOP_*|ZTHREAD_*|ZHEAP_DEATH_*|ZAGENT_*|ANTHROPIC_MODEL|ZOCIETY_AGENT_CLIENT|GEMINI_*|ZOCIETY_BLIND_KEY|ZOCIETY_TURN_ID|CLAUDECODE) ENV_ARGS+=(--env "$_name") ;;
        esac
    done < <(compgen -e)
    [[ -n "${NO_COLOR:-}" ]] && ENV_ARGS+=(--env NO_COLOR)
    return 0
}

# container_workdir: where in the container a command runs. The project is
# mounted at /repo, so a command started in a subdirectory of it, or in a
# checkout under .worktrees/, runs in the same place there. It used to run in
# /repo whatever the caller's directory: a `git add` or `git commit` routed
# from .worktrees/<name> acted on the main checkout, on whatever branch a run
# had it on. Anywhere outside the project it is /repo, as before.
container_workdir() {
    local here root
    here="$(pwd -P)"
    root="$(cd "$PROJECT_DIR" && pwd -P)"
    case "$here" in
        "$root"/*) printf '/repo/%s\n' "${here#"$root"/}" ;;
        *) printf '/repo\n' ;;
    esac
}

run_container() {
    check_prereqs
    ensure_image

    local cmd=("$@")
    if [[ ${#cmd[@]} -eq 0 ]]; then
        cmd=("claude")
    fi

    log_cmd "Running: ${cmd[*]}"

    # Build volume args
    local volume_args=(
        --volume "$PROJECT_DIR:/repo:Z"
        --volume "zociety-claude-home:/home/agent"
    )

    # Add secrets directory if it exists
    if [[ -d "$CONTAINER_DIR/secrets" ]]; then
        volume_args+=(--volume "$CONTAINER_DIR/secrets:/run/secrets:ro")
    fi

    # Add plugins if CLAUDE_PLUGINS_DIR is set
    if [[ -n "${CLAUDE_PLUGINS_DIR:-}" ]] && [[ -d "$CLAUDE_PLUGINS_DIR" ]]; then
        volume_args+=(--volume "$CLAUDE_PLUGINS_DIR:/home/agent/.claude-plugins:ro")
    fi

    # The host env a containerized command may read (forward_env).
    forward_env

    # Subscription OAuth token (mint it via: bin/zociety setup-token) is read from
    # the mounted secrets dir by docker-entrypoint.sh and exported as
    # CLAUDE_CODE_OAUTH_TOKEN, so both this wrapper and compose.yml pick it up.

    # Determine interactive mode
    local interactive_args=()
    if needs_interactive "${cmd[0]}"; then
        interactive_args=(-it)
    else
        interactive_args=()  # no TTY: see note above; set GH_FORCE_TTY=1 for colour
    fi

    # The caller's directory (container_workdir). cd, not --workdir: through
    # the podman machine's file sharing the directory a container starts in
    # comes back owned by root, and git then refuses a worktree there
    # ("detected dubious ownership"; only /repo is a safe.directory). From
    # the project root the command line is what it always was.
    local workdir
    workdir="$(container_workdir)"
    if [[ "$workdir" != /repo ]]; then
        # shellcheck disable=SC2016  # expanded by the container's bash
        cmd=(bash -c 'cd "$1" && shift && exec "$@"' zociety-run "$workdir" "${cmd[@]}")
    fi

    podman run --rm "${interactive_args[@]}" \
        --init \
        --name "$CONTAINER_NAME" \
        --read-only \
        --tmpfs /tmp:size=200M,mode=1777 \
        --tmpfs /run:size=50M,mode=755 \
        "${volume_args[@]}" \
        "${ENV_ARGS[@]}" \
        --memory 1g \
        --cpus 2.0 \
        --user 1000:1000 \
        --security-opt no-new-privileges:true \
        "$IMAGE_NAME" \
        "${cmd[@]}"
}

show_help() {
    cat << 'EOF'
zociety - Containerized Claude Code environment

USAGE:
    bin/zociety [command] [args...]

COMMANDS:
    (none)              Start interactive Claude session
    setup-token         Mint a long-lived subscription OAuth token on the HOST
                        and save it to container/secrets/ (recommended auth)
    login               Login to Claude inside the container (interactive; needs
                        a browser callback - awkward in a container)
    bash                Shell inside the container
    exec [cmd]          Exec into running container (default: bash)
    -- [args]           Pass arguments to claude command
    <any>               Run arbitrary command in container

MANAGEMENT:
    --build             Build/rebuild the container image
    --rebuild           Force rebuild (no cache)
    --status            Show image and volume status
    --clean             Remove image and volumes (destructive)
    --help              Show this help

FIRST TIME SETUP (Claude Max/Pro subscription):
    bin/zociety --build         # (or --rebuild to update the Claude Code client)
    bin/zociety setup-token     # host browser flow -> saves ~1yr OAuth token
    # The token is injected as CLAUDE_CODE_OAUTH_TOKEN on every run.
    # Do not create container/secrets/anthropic_api_key - an API key overrides OAuth.

RUNNING THE AGENT LOOP:
    bin/zociety bin/zloop 60                       # Run loop with max 60 iterations
    bin/zociety bin/zloop --stop budget,file 60    # Pick stop modes (bin/zloop --help)
    ZLOOP_STOP=budget,file ZSTOP_BUDGET=5 bin/zociety bin/zloop 60
    # ZLOOP_*, ZSTOP_*, ZTHREAD_*, ZHEAP_DEATH_*, ZOCIETY_BLIND_KEY and CLAUDECODE host
    # env vars are forwarded into the container, a running one included.

PLUGINS:
    Set CLAUDE_PLUGINS_DIR to mount plugins into container:
    CLAUDE_PLUGINS_DIR=~/.claude/plugins bin/zociety

EXAMPLES:
    bin/zociety                                    # Interactive Claude
    bin/zociety -- --dangerously-skip-permissions  # Claude with args
    bin/zociety bash                               # Debug shell
    bin/zociety exec                               # Bash into running container
    bin/zociety exec bin/zstate                    # Run command in running container
    bin/zociety bin/check-genesis                  # Run zociety script
EOF
}

case "${1:-}" in
    --help|-h)
        show_help
        exit 0
        ;;
    --build)
        check_prereqs
        build_image
        exit 0
        ;;
    --rebuild)
        check_prereqs
        log_info "Rebuilding image (no cache)..."
        podman build --no-cache -t "$IMAGE_NAME" "$CONTAINER_DIR"
        log_info "Image rebuilt: $IMAGE_NAME"
        exit 0
        ;;
    --status)
        echo "Image:"
        podman images "$IMAGE_NAME" 2>/dev/null || echo "  Not built"
        echo ""
        echo "Volume:"
        podman volume inspect zociety-claude-home 2>/dev/null | grep -E '(Name|Mountpoint)' || echo "  Not created"
        echo ""
        echo "CLAUDE_PLUGINS_DIR: ${CLAUDE_PLUGINS_DIR:-not set}"
        exit 0
        ;;
    --clean)
        log_warn "This will remove the zociety image and home volume."
        log_warn "You will need to login again after this."
        read -p "Continue? [y/N] " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            podman rm -f "$CONTAINER_NAME" 2>/dev/null || true
            podman volume rm zociety-claude-home 2>/dev/null || true
            podman rmi "$IMAGE_NAME" 2>/dev/null || true
            log_info "Cleaned up"
        else
            log_info "Aborted"
        fi
        exit 0
        ;;
    exec)
        shift
        cmd=("${@:-bash}")
        check_prereqs
        if ! podman container exists "$CONTAINER_NAME" 2>/dev/null; then
            log_error "Container '$CONTAINER_NAME' is not running."
            log_error "Start it first with: bin/zociety"
            exit 1
        fi
        log_cmd "Exec: ${cmd[*]}"
        # A pty (-t) turns every \n into \r\n, so a caller capturing
        # $(bin/zociety exec git ...) gets ids with a trailing CR. Allocate
        # one only when we actually sit on a terminal.
        exec_tty=(-i)
        [[ -t 0 && -t 1 ]] && exec_tty=(-it)
        # podman exec skips the entrypoint, and the entrypoint is where the
        # files under /run/secrets become GH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN
        # and ANTHROPIC_API_KEY (container/docker-entrypoint.sh; keep the two
        # in step). Without them gh in an exec'd command is logged out
        # ("populate the GH_TOKEN environment variable"), so bin/zgh, and with
        # it bin/zheap-death's landing of a cycle, failed whenever a session
        # already held the container. The host env is forwarded as for a run,
        # and the command runs in the caller's directory (container_workdir;
        # cd for the reason run_container gives).
        forward_env
        # shellcheck disable=SC2016  # expanded by the container's bash
        podman exec "${exec_tty[@]}" "${ENV_ARGS[@]}" "$CONTAINER_NAME" bash -c '
            cd "$1" || exit 1
            shift
            if [[ -f /run/secrets/anthropic_api_key ]]; then
                ANTHROPIC_API_KEY="$(cat /run/secrets/anthropic_api_key)"; export ANTHROPIC_API_KEY
            fi
            if [[ -f /run/secrets/claude_oauth_token ]]; then
                CLAUDE_CODE_OAUTH_TOKEN="$(tr -d "[:space:]" < /run/secrets/claude_oauth_token)"; export CLAUDE_CODE_OAUTH_TOKEN
            fi
            if [[ -f /run/secrets/github_token ]]; then
                GITHUB_TOKEN="$(cat /run/secrets/github_token)"; export GITHUB_TOKEN GH_TOKEN="$GITHUB_TOKEN"
            fi
            exec "$@"' zociety-exec "$(container_workdir)" "${cmd[@]}"
        ;;
    setup-token)
        setup_token
        exit 0
        ;;
    login)
        run_container claude login
        ;;
    --)
        # Pass remaining args to claude
        shift
        run_container claude "$@"
        ;;
    *)
        run_container "$@"
        ;;
esac
