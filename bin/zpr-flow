#!/bin/bash
# zpr-flow: Open and optionally merge a cycle's GitLab merge request.
# Usage: bin/zpr-flow <head_branch> [base_branch] [title]
# ZPR_MERGE=1 requests a merge; ZPR_AUTO=1 (default) waits for pipeline checks.
# ZPR_REPO defaults to zociety/zociety. ZPR_DRAFT=1 opens a draft.
# ZPR_MERGE_TRIES=3 and ZPR_MERGE_WAIT=5 bound merge/poll attempts.
# Merge commits preserve the archive tags, notes and successor ancestry.
# Exit: 0 open/merged, 1 usage, 2 no origin, 3 push failed, 4 not merged.
set -euo pipefail

case "${1:-}" in
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
HEAD_BRANCH="${1:-}"
BASE_BRANCH="${2:-main}"
TITLE="${3:-}"
MERGE="${ZPR_MERGE:-0}"
TRIES="${ZPR_MERGE_TRIES:-3}"
WAIT="${ZPR_MERGE_WAIT:-5}"
[[ -n "$HEAD_BRANCH" && "$HEAD_BRANCH" != "$BASE_BRANCH" ]] || { echo 'zpr-flow: supply distinct head and base branches' >&2; exit 1; }
[[ "$TRIES" =~ ^[1-9][0-9]*$ && "$WAIT" =~ ^[0-9]+$ ]] || { echo 'zpr-flow: invalid retry limits' >&2; exit 1; }
[[ "${ZPR_MERGE_METHOD:-merge}" == merge ]] || { echo 'zpr-flow: cycle history requires merge commits' >&2; exit 1; }
PROJECT=$(jq -rn --arg repo "${ZPR_REPO:-zociety/zociety}" '$repo | @uri')
ENDPOINT="projects/$PROJECT/merge_requests"
git remote get-url origin >/dev/null 2>&1 || { echo 'zpr-flow: no origin remote' >&2; exit 2; }
git push origin "$HEAD_BRANCH" --quiet || { echo "zpr-flow: failed to push $HEAD_BRANCH" >&2; exit 3; }
git fetch origin "$BASE_BRANCH" --quiet
COMMITS=$(git rev-list --count "origin/$BASE_BRANCH..$HEAD_BRANCH")
if [[ "$COMMITS" == 0 ]]; then
    echo 'zpr-flow: no commits to merge'
    exit 0
fi
HEAD_SHA=$(git rev-parse "$HEAD_BRANCH")
REQUESTS=$(glab api "$ENDPOINT" --method GET --raw-field state=opened \
    --raw-field "source_branch=$HEAD_BRANCH" --raw-field "target_branch=$BASE_BRANCH") || exit 4
MR=$(jq -r '.[0].iid // empty' <<<"$REQUESTS")
if [[ -z "$MR" ]]; then
    [[ -n "$TITLE" ]] || TITLE="$HEAD_BRANCH: $(git log -1 --format=%s "$HEAD_BRANCH")"
    [[ "${ZPR_DRAFT:-0}" != 1 ]] || TITLE="Draft: $TITLE"
    count() { git log --format=%s --grep="$1" "origin/$BASE_BRANCH..$HEAD_BRANCH" | wc -l | tr -d ' '; }
    BODY=$(printf '%s\n' "Cycle branch $HEAD_BRANCH -> $BASE_BRANCH, $COMMITS commit(s)." \
        "" "- joins: $(count '^\[join\]')" "- rules adopted: $(count '^\[pass\]')" \
        "- stuff: $(count '^\[stuff\]')" "" 'Opened by bin/zpr-flow; merge commits preserve archive ancestry.')
    REQUEST=$(glab api "$ENDPOINT" --method POST --raw-field "source_branch=$HEAD_BRANCH" \
        --raw-field "target_branch=$BASE_BRANCH" --raw-field "title=$TITLE" \
        --raw-field "description=$BODY" --field remove_source_branch=true --field squash=false) || exit 4
    MR=$(jq -er .iid <<<"$REQUEST")
fi
echo "zpr-flow: MR !$MR ready for $HEAD_BRANCH -> $BASE_BRANCH"
[[ "$MERGE" == 1 ]] || exit 0
AUTO=true
[[ "${ZPR_AUTO:-1}" != 0 ]] || AUTO=false
requested=0
for ((attempt=1; attempt<=TRIES; attempt++)); do
    response=""
    if [[ $requested == 0 ]]; then
        if response=$(glab api "$ENDPOINT/$MR/merge" --method PUT --raw-field "sha=$HEAD_SHA" \
            --field squash=false --field should_remove_source_branch=true --field "auto_merge=$AUTO"); then
            requested=1
        fi
    else
        response=$(glab api "$ENDPOINT/$MR") || response=""
    fi
    if [[ -n "$response" ]] && [[ "$(jq -r '.state // empty' <<<"$response")" == merged ]]; then
        echo "zpr-flow: MR !$MR merged"
        exit 0
    fi
    (( attempt == TRIES )) || sleep "$WAIT"
done
echo "zpr-flow: MR !$MR remains open or awaits its pipeline" >&2
exit 4
