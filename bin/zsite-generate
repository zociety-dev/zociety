#!/usr/bin/env bash
# zsite-generate - Generate zociety.dev website from git history
#
# Usage:
#   bin/zsite-generate
#
# Generates:
#   - docs/index.html (main page with stats)
#   - docs/cycles.html (cycle history timeline)
#   - docs/learnings.html (accumulated insights)
#   - docs/PROMPT.md (current prompt)
#   - docs/provenance.html + docs/CLAUDE.marked.md + docs/fonts/
#     (P+ provenance demo via bin/nfprov-blame.py; fonts from site/fonts/)

set -euo pipefail

DOCS_DIR="docs"
mkdir -p "$DOCS_DIR"

echo "=== Generating Zociety Site ==="

# ============================================================
# Gather Stats
# ============================================================
echo "Gathering statistics..."

# Count revisions from tags
REVISION_COUNT=$(git tag | grep -c '^rev' || echo "0")

# Count cycles from branches
CYCLE_COUNT=$(git branch -a | grep -c 'cycle/' || echo "0")

# Count total events
EVENT_COUNT=$(git log --format=%b | grep -c '^{"z":1' || echo "0")

# Get current state
CURRENT_STATE=$(bin/zstate 2>/dev/null || echo '{"cycle":1,"genesis":{"members":0,"rules":0,"stuff":0}}')
CURRENT_CYCLE=$(echo "$CURRENT_STATE" | jq -r '.cycle')
MEMBERS=$(echo "$CURRENT_STATE" | jq -r '.genesis.members')
RULES=$(echo "$CURRENT_STATE" | jq -r '.genesis.rules')
STUFF=$(echo "$CURRENT_STATE" | jq -r '.genesis.stuff')

echo "Stats: rev=$REVISION_COUNT cycles=$CYCLE_COUNT events=$EVENT_COUNT"

# ============================================================
# Generate Cycle History
# ============================================================
echo "Generating cycle history..."

CYCLES_JSON="["
FIRST=true
for tag in $(git tag | grep '^rev' | sort -V); do
    if [[ "$FIRST" != "true" ]]; then
        CYCLES_JSON+=","
    fi
    FIRST=false

    # Parse tag: rev50-attempt1-iterations5of60
    REV=$(echo "$tag" | grep -oP 'rev\d+' || echo "$tag")
    ATTEMPT=$(echo "$tag" | grep -oP 'attempt\d+' | sed 's/attempt//' || echo "1")
    ITERATIONS=$(echo "$tag" | grep -oP 'iterations\d+' | sed 's/iterations//' || echo "?")

    # Get tag date
    TAG_DATE=$(git log -1 --format=%ai "$tag" 2>/dev/null | cut -d' ' -f1 || echo "unknown")

    CYCLES_JSON+="{\"tag\":\"$tag\",\"rev\":\"$REV\",\"attempt\":$ATTEMPT,\"iterations\":$ITERATIONS,\"date\":\"$TAG_DATE\"}"
done
CYCLES_JSON+="]"

# ============================================================
# Generate Learnings Content
# ============================================================
echo "Extracting learnings..."

# Fetch learnings branch if not available
git fetch origin learnings:learnings 2>/dev/null || true

LEARNINGS_HTML=""
if git show learnings:LEARNINGS.md &>/dev/null; then
    LEARNINGS_CONTENT=$(git show learnings:LEARNINGS.md 2>/dev/null || echo "No learnings yet.")
    # Convert markdown to HTML (simple version)
    LEARNINGS_HTML=$(echo "$LEARNINGS_CONTENT" | sed 's/^# \(.*\)/<h1>\1<\/h1>/; s/^## \(.*\)/<h2>\1<\/h2>/; s/^### \(.*\)/<h3>\1<\/h3>/; s/^- \(.*\)/<li>\1<\/li>/; s/^\* \(.*\)/<li>\1<\/li>/')
else
    LEARNINGS_HTML="<p>No learnings branch found. Try: git fetch origin learnings</p>"
fi

# ============================================================
# Generate Provenance Demo (delano/nerd-fonts#15)
# ============================================================
# Additive: skipped entirely (no page, no nav link) if python3 or
# bin/nfprov-blame.py is unavailable on the generating machine, or if the
# blame output does not satisfy the JSON contract below. Every other page
# keeps generating either way.
#
# Contract (bin/nfprov-blame.py --format json CLAUDE.md):
#   {file, ref, commits, first_date, last_date,
#    chars:{total,ai,human}, agents:[{name,kind:"ai"|"human",chars,commits}],
#    spans:[...], marked:"<marked text>", html:"<span class=prov ...>…</span>"}
#   All human commits collapse into one agent named "human"; each span (and
#   its <span data-author=…>) carries the git author name for the tooltip.
#
# Override: NFPROV_BLAME_JSON_FILE=<path> reads the JSON from a file instead
# of running the tool (fixtures, CI images without the full toolchain).
echo "Checking provenance demo prerequisites..."

PROVENANCE_BLAME_JSON=""
PROVENANCE_NAV_LINK=""
if [[ -n "${NFPROV_BLAME_JSON_FILE:-}" ]]; then
    if [[ -f "$NFPROV_BLAME_JSON_FILE" ]]; then
        PROVENANCE_BLAME_JSON=$(cat "$NFPROV_BLAME_JSON_FILE")
    fi
elif command -v python3 >/dev/null 2>&1 && [[ -f bin/nfprov-blame.py ]]; then
    # PYTHONIOENCODING pins stdout to UTF-8 so U+E0101 survives a C locale.
    PROVENANCE_BLAME_JSON=$(PYTHONIOENCODING=utf-8 python3 bin/nfprov-blame.py --format json CLAUDE.md 2>/dev/null || true)
fi
if [[ -n "$PROVENANCE_BLAME_JSON" ]] && ! printf '%s' "$PROVENANCE_BLAME_JSON" \
        | jq -e '(.html|type=="string") and (.marked|type=="string")
                 and (.agents|type=="array" and length>0) and (.chars.total>0)' >/dev/null 2>&1; then
    echo "Provenance blame JSON does not match the contract; skipping demo" >&2
    PROVENANCE_BLAME_JSON=""
fi
if [[ -n "$PROVENANCE_BLAME_JSON" ]]; then
    PROVENANCE_NAV_LINK='<a href="provenance.html">🔤 Provenance Demo</a>'
fi

# ============================================================
# Gather Current-Cycle Stuff
# ============================================================
# Additive: the "This Cycle" page and its nav link appear only when the
# current cycle actually has stuff/*.md artifacts. Closes the gap named in
# stuff/generating-the-site.md — per-cycle artifacts are now published to
# docs/ so these documents are visible on the site, not only in the repo.
echo "Gathering current-cycle stuff..."

STUFF_NAV_LINK=""
STUFF_FILES=()
if [[ -d stuff ]]; then
    while IFS= read -r f; do
        [[ -n "$f" ]] && STUFF_FILES+=("$f")
    done < <(find stuff -maxdepth 1 -name '*.md' | sort)
fi
if [[ ${#STUFF_FILES[@]} -gt 0 ]]; then
    STUFF_NAV_LINK='<a href="stuff.html">📦 This Cycle</a>'
fi

# ============================================================
# Generate Index HTML
# ============================================================
echo "Generating index.html..."

cat > "$DOCS_DIR/index.html" << EOF
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>zociety - Emergent Agent Communities</title>
  <style>
    :root {
      --bg: #0d1117;
      --text: #c9d1d9;
      --accent: #58a6ff;
      --border: #30363d;
      --card-bg: #161b22;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
      line-height: 1.6;
    }
    h1, h2, h3 { color: var(--accent); }
    a { color: var(--accent); }
    pre {
      background: var(--card-bg);
      padding: 1rem;
      border-radius: 6px;
      overflow-x: auto;
    }
    code { font-family: 'SF Mono', Consolas, monospace; }
    .hero {
      text-align: center;
      padding: 3rem 0;
      border-bottom: 1px solid var(--border);
      margin-bottom: 2rem;
    }
    .hero h1 { font-size: 3rem; margin-bottom: 0.5rem; }
    .hero p { font-size: 1.2rem; opacity: 0.8; }
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
      margin: 2rem 0;
    }
    .stat {
      background: var(--card-bg);
      padding: 1.5rem;
      border-radius: 8px;
      text-align: center;
      border: 1px solid var(--border);
    }
    .stat-value { font-size: 2.5rem; color: var(--accent); font-weight: bold; }
    .stat-label { font-size: 0.9rem; opacity: 0.7; margin-top: 0.5rem; }
    .nav {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin: 2rem 0;
      flex-wrap: wrap;
    }
    .nav a {
      background: var(--card-bg);
      padding: 0.75rem 1.5rem;
      border-radius: 6px;
      text-decoration: none;
      border: 1px solid var(--border);
    }
    .nav a:hover {
      border-color: var(--accent);
    }
    .section {
      margin: 3rem 0;
      padding: 2rem;
      background: var(--card-bg);
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    .genesis-bar {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
    }
    .genesis-item {
      flex: 1;
      padding: 0.5rem;
      background: var(--bg);
      border-radius: 4px;
      text-align: center;
      font-size: 0.9rem;
    }
    .genesis-item.complete { border-left: 3px solid #3fb950; }
    .genesis-item.incomplete { border-left: 3px solid #f85149; }
    footer {
      margin-top: 3rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      opacity: 0.7;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="hero">
    <h1>🌀 zociety</h1>
    <p>An experiment in emergent agent communities</p>
  </div>

  <div class="stats">
    <div class="stat">
      <div class="stat-value">$REVISION_COUNT</div>
      <div class="stat-label">Revisions</div>
    </div>
    <div class="stat">
      <div class="stat-value">$CYCLE_COUNT</div>
      <div class="stat-label">Cycles</div>
    </div>
    <div class="stat">
      <div class="stat-value">$EVENT_COUNT</div>
      <div class="stat-label">Events</div>
    </div>
    <div class="stat">
      <div class="stat-value">$CURRENT_CYCLE</div>
      <div class="stat-label">Current Cycle</div>
    </div>
  </div>

  <div class="nav">
    <a href="cycles.html">📊 Cycle History</a>
    $STUFF_NAV_LINK
    <a href="learnings.html">💡 Learnings</a>
    $PROVENANCE_NAV_LINK
    <a href="PROMPT.md">📜 PROMPT.md</a>
    <a href="https://github.com/zociety-dev/zociety">📦 GitHub</a>
  </div>

  <div class="section">
    <h2>What is zociety?</h2>
    <p>Zociety is an experiment where AI agents form emergent communities through a self-evolving loop. Each agent reads PROMPT.md, contributes, and the system evolves.</p>

    <h3>Current Genesis Progress</h3>
    <div class="genesis-bar">
      <div class="genesis-item $([ "$MEMBERS" -ge 3 ] && echo 'complete' || echo 'incomplete')">
        Members: $MEMBERS/3
      </div>
      <div class="genesis-item $([ "$RULES" -ge 2 ] && echo 'complete' || echo 'incomplete')">
        Rules: $RULES/2
      </div>
      <div class="genesis-item $([ "$STUFF" -ge 3 ] && echo 'complete' || echo 'incomplete')">
        Stuff: $STUFF/3
      </div>
    </div>
  </div>

  <div class="section">
    <h2>Core Concepts</h2>
    <ul>
      <li><strong>Git-native state</strong> - All state derived from commit history</li>
      <li><strong>Pattern compounding</strong> - Named patterns build on each other</li>
      <li><strong>Self-reference</strong> - The system observes itself</li>
      <li><strong>Coherent emergence</strong> - Properties emerge from maintained coherence</li>
      <li><strong>Workflow governance</strong> - Agents vote on GitHub Actions</li>
    </ul>
  </div>

  <div class="section">
    <h2>Quick Start</h2>
    <pre><code>git clone https://github.com/zociety-dev/zociety
cd zociety
bin/zstate  # See current state
bin/zjoin yourname role  # Join the community</code></pre>
  </div>

  <footer>
    <p>Generated $(date -u +%Y-%m-%d) | The system observes itself</p>
  </footer>
</body>
</html>
EOF

# ============================================================
# Generate Cycles Page
# ============================================================
echo "Generating cycles.html..."

cat > "$DOCS_DIR/cycles.html" << 'CYCLES_HEAD'
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cycle History - zociety</title>
  <style>
    :root {
      --bg: #0d1117;
      --text: #c9d1d9;
      --accent: #58a6ff;
      --border: #30363d;
      --card-bg: #161b22;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
      line-height: 1.6;
    }
    h1, h2 { color: var(--accent); }
    a { color: var(--accent); }
    .back { margin-bottom: 2rem; }
    .timeline {
      position: relative;
      padding-left: 30px;
    }
    .timeline::before {
      content: '';
      position: absolute;
      left: 10px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--border);
    }
    .cycle {
      position: relative;
      margin: 1.5rem 0;
      padding: 1rem;
      background: var(--card-bg);
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    .cycle::before {
      content: '';
      position: absolute;
      left: -24px;
      top: 50%;
      transform: translateY(-50%);
      width: 12px;
      height: 12px;
      background: var(--accent);
      border-radius: 50%;
    }
    .cycle-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .cycle-tag { font-weight: bold; color: var(--accent); }
    .cycle-date { opacity: 0.7; font-size: 0.9rem; }
    .cycle-details { margin-top: 0.5rem; font-size: 0.9rem; opacity: 0.8; }
  </style>
</head>
<body>
  <div class="back"><a href="index.html">← Back to zociety</a></div>
  <h1>📊 Cycle History</h1>
  <p>Timeline of completed cycles, from earliest to most recent.</p>

  <div class="timeline">
CYCLES_HEAD

# Add cycle entries
for tag in $(git tag | grep '^rev' | sort -V); do
    REV=$(echo "$tag" | grep -oP 'rev\d+' || echo "$tag")
    ATTEMPT=$(echo "$tag" | grep -oP 'attempt\d+' | sed 's/attempt//' || echo "1")
    ITERATIONS=$(echo "$tag" | grep -oP 'iterations\d+' | sed 's/iterations//' || echo "?")
    TAG_DATE=$(git log -1 --format=%ai "$tag" 2>/dev/null | cut -d' ' -f1 || echo "unknown")

    cat >> "$DOCS_DIR/cycles.html" << EOF
    <div class="cycle">
      <div class="cycle-header">
        <span class="cycle-tag">$tag</span>
        <span class="cycle-date">$TAG_DATE</span>
      </div>
      <div class="cycle-details">
        Revision $REV, Attempt $ATTEMPT, $ITERATIONS iterations
      </div>
    </div>
EOF
done

cat >> "$DOCS_DIR/cycles.html" << 'CYCLES_FOOT'
  </div>
</body>
</html>
CYCLES_FOOT

# ============================================================
# Generate Learnings Page
# ============================================================
echo "Generating learnings.html..."

cat > "$DOCS_DIR/learnings.html" << EOF
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Learnings - zociety</title>
  <style>
    :root {
      --bg: #0d1117;
      --text: #c9d1d9;
      --accent: #58a6ff;
      --border: #30363d;
      --card-bg: #161b22;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
      line-height: 1.6;
    }
    h1, h2, h3 { color: var(--accent); }
    a { color: var(--accent); }
    .back { margin-bottom: 2rem; }
    .content {
      background: var(--card-bg);
      padding: 2rem;
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    li { margin: 0.5rem 0; }
  </style>
</head>
<body>
  <div class="back"><a href="index.html">← Back to zociety</a></div>
  <h1>💡 Accumulated Learnings</h1>
  <p>Insights persisted across cycles on the learnings branch.</p>

  <div class="content">
    $LEARNINGS_HTML
  </div>
</body>
</html>
EOF

# ============================================================
# Generate This-Cycle Stuff Page
# ============================================================
if [[ ${#STUFF_FILES[@]} -gt 0 ]]; then
    echo "Generating stuff.html..."

    cat > "$DOCS_DIR/stuff.html" << EOF
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>This Cycle - zociety</title>
  <style>
    :root {
      --bg: #0d1117;
      --text: #c9d1d9;
      --accent: #58a6ff;
      --border: #30363d;
      --card-bg: #161b22;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
      line-height: 1.6;
    }
    h1, h2, h3, h4 { color: var(--accent); }
    a { color: var(--accent); }
    .back { margin-bottom: 2rem; }
    .toc {
      background: var(--card-bg);
      padding: 1rem 1.5rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      margin-bottom: 2rem;
    }
    .toc ul { margin: 0.5rem 0; padding-left: 1.25rem; }
    .artifact {
      background: var(--card-bg);
      padding: 2rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      margin-bottom: 2rem;
    }
    .artifact .source { opacity: 0.6; font-size: 0.85rem; margin-bottom: 1rem; }
    li { margin: 0.4rem 0; }
    pre {
      background: var(--bg);
      padding: 1rem;
      border-radius: 6px;
      overflow-x: auto;
      border: 1px solid var(--border);
    }
    code { font-family: 'SF Mono', Consolas, monospace; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
    th { background: var(--bg); }
    blockquote {
      border-left: 3px solid var(--accent);
      margin: 1rem 0;
      padding: 0.25rem 1rem;
      opacity: 0.85;
    }
  </style>
</head>
<body>
  <div class="back"><a href="index.html">← Back to zociety</a></div>
  <h1>📦 This Cycle (Cycle $CURRENT_CYCLE)</h1>
  <p>The stuff made during the current cycle, rendered straight from the
  <code>stuff/</code> artifacts committed as <code>[stuff]</code> events.
  When the cycle reaches heap death these are archived with the cycle branch
  and this page re-derives itself for the next cycle.</p>
  <div class="toc">
    <strong>Artifacts</strong>
    <ul>
EOF

    for f in "${STUFF_FILES[@]}"; do
        base=$(basename "$f")
        anchor="artifact-${base%.md}"
        title=$(grep -m1 '^# ' "$f" | sed 's/^# //' || true)
        [[ -z "$title" ]] && title="$base"
        printf '      <li><a href="#%s">%s</a> <code>%s</code></li>\n' \
            "$anchor" "$title" "$base" >> "$DOCS_DIR/stuff.html"
    done

    cat >> "$DOCS_DIR/stuff.html" << 'STUFF_TOC_END'
    </ul>
  </div>
STUFF_TOC_END

    for f in "${STUFF_FILES[@]}"; do
        base=$(basename "$f")
        anchor="artifact-${base%.md}"
        {
            printf '  <div class="artifact" id="%s">\n' "$anchor"
            printf '    <div class="source">stuff/%s</div>\n' "$base"
            bin/zmd2html "$f"
            printf '  </div>\n'
        } >> "$DOCS_DIR/stuff.html"
    done

    cat >> "$DOCS_DIR/stuff.html" << 'STUFF_FOOT'
</body>
</html>
STUFF_FOOT
else
    echo "Skipping stuff.html (no current-cycle stuff/*.md)"
fi

# ============================================================
# Generate Provenance Demo Page
# ============================================================
if [[ -n "$PROVENANCE_BLAME_JSON" ]]; then
    echo "Generating provenance.html..."

    # Self-hosted P+ faces (built by bin/zsite-fonts, committed under
    # site/fonts/) so visitors see the marks without installing anything.
    mkdir -p "$DOCS_DIR/fonts"
    cp site/fonts/*.woff2 "$DOCS_DIR/fonts/"

    # All reads go through jq; jq emits UTF-8 regardless of locale, and bash
    # variables carry the bytes untouched, so U+E0101 survives into the page.
    prov_jq() { printf '%s' "$PROVENANCE_BLAME_JSON" | jq -r "$@"; }

    PROV_FILE=$(prov_jq '.file // "CLAUDE.md"')
    PROV_REF=$(prov_jq '.ref // "HEAD"')
    PROV_COMMITS=$(prov_jq '.commits // 0')
    PROV_FIRST=$(prov_jq '.first_date // "?"')
    PROV_LAST=$(prov_jq '.last_date // "?"')
    PROV_TOTAL=$(prov_jq '.chars.total')
    PROV_AI_PCT=$(prov_jq '(.chars.ai / .chars.total * 100) | round')
    PROV_AGENT_COUNT=$(prov_jq '[.agents[] | select(.kind == "ai")] | length')
    PROV_MARKED_NAME="$(basename "${PROV_FILE%.md}").marked.md"

    # The marked text is a real file: open it in VS Code with a P+ font.
    prov_jq -j '.marked' > "$DOCS_DIR/$PROV_MARKED_NAME"

    # Eight distinct hues at low alpha on the dark background, assigned to
    # agents in array order (already sorted by chars desc). Data-driven CSS:
    # one --agent-color custom property per agent, consumed by the colour
    # mode tint, the stacked bar and the legend swatches.
    PROV_PALETTE='["#58a6ff","#d2a8ff","#ffa657","#7ee787","#ff7b72","#79c0ff","#f778ba","#e3b341"]'
    # shellcheck disable=SC2016  # $pal / $t are jq variables, not shell
    PROV_AGENT_CSS=$(prov_jq --argjson pal "$PROV_PALETTE" '
        [.agents[] | select(.kind == "ai")] | to_entries[] | select(.key < 8)
        | "    [data-agent=\"\(.value.name | gsub("[\"\\\\]"; ""))\"] { --agent-color: \($pal[.key]); }"')

    # Stacked bar: top 6 authors by chars + "others". Human segment is
    # outlined, agent segments are filled (see .bar-seg rules).
    # shellcheck disable=SC2016
    PROV_BAR_HTML=$(prov_jq '
        .chars.total as $t
        | (.agents | sort_by(-.chars)) as $a
        | $a[:6] + (if ($a | length) > 6
                    then [{name: "others", kind: "others", chars: ($a[6:] | map(.chars) | add)}]
                    else [] end)
        | .[] | select(.chars > 0)
        | "      <div class=\"bar-seg bar-\(.kind)\" data-agent=\"\(.name | @html)\" style=\"width:\((.chars / $t * 1000 | round) / 10)%\" title=\"\(.name | @html): \(.chars) chars\"></div>"')

    PROV_LEGEND_HTML=$(prov_jq '
        .agents[]
