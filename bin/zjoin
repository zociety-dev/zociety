#!/bin/bash
# zjoin: Join the zociety
# Usage: bin/zjoin [name] [role] [greeting]
#
# Arguments:
#   name     - Ignored. The harness assigns the member name: member-{N}, N
#              being the current member count (bin/zstate genesis.members)
#              plus one. Kept as a positional so old callers still work; pass
#              "" or "-" to skip it. A non-empty value gets a note on stderr.
#   role     - Agent role (default: agent)
#   greeting - Greeting message (default: joining cycle)
#
# The join event carries {role, greeting} and no model: the model behind a
# turn is sealed by the loop (bin/zblind) and revealed at heap-death, so no
# member can read another's model, or its own, from the event log. See
# docs/challenges/cross-agent-deference.md.

set -e

REQUESTED="${1:-}"
ROLE="${2:-agent}"
GREETING="${3:-joining cycle}"

if [[ "$REQUESTED" == "-h" || "$REQUESTED" == "--help" ]]; then
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

if [[ -n "$REQUESTED" && "$REQUESTED" != "-" ]]; then
  echo "zjoin: name '$REQUESTED' ignored; members are named by the harness (member-{N})" >&2
fi

COUNT=$(bin/zstate | jq -r '.genesis.members // 0')
NAME="member-$((COUNT + 1))"

DATA=$(jq -nc --arg role "$ROLE" --arg greeting "$GREETING" \
  '{role: $role, greeting: $greeting}')

bin/zevent join "$NAME" "$GREETING" "$DATA"
