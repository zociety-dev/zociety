#!/bin/bash
# zjoin: Join the zociety
# Usage: bin/zjoin <n> [role] [greeting] [model]
#
# Arguments:
#   name     - Agent name (required)
#   role     - Agent role (default: agent)
#   greeting - Greeting message (default: joining cycle)
#   model    - AI model identifier. Defaults to $ANTHROPIC_MODEL (the var that
#              pins the running model, see bin/zloop / bin/zociety), or "unknown"
#              when unset -- the loop can't know the CLI's resolved default.

set -e

NAME="$1"
ROLE="${2:-agent}"
GREETING="${3:-joining cycle}"
MODEL="${4:-${ANTHROPIC_MODEL:-unknown}}"

if [[ -z "$NAME" ]]; then
  echo "Usage: bin/zjoin <n> [role] [greeting] [model]" >&2
  echo "  model: AI model identifier; defaults to \$ANTHROPIC_MODEL or 'unknown'" >&2
  exit 1
fi

DATA=$(jq -nc --arg role "$ROLE" --arg greeting "$GREETING" --arg model "$MODEL" \
  '{role: $role, greeting: $greeting, model: $model}')

bin/zevent join "$NAME" "$GREETING" "$DATA"
