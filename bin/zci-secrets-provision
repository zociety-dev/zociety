#!/bin/bash
# Host entry point. Credentials and temporary files belong to the container.
set +x
set -euo pipefail

if [[ $# != 0 ]]; then
    printf 'Usage: bin/zci-secrets-provision (requires a running zociety container)\n' >&2
    exit 2
fi

ROOT=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P)
LAUNCHER="$ROOT/bin/zociety"
# As in zglab, worktrees use the original checkout's container mount.
if [[ -n "${ZOCIETY_ROOT:-}" && "$ROOT" == "$ZOCIETY_ROOT"/* ]]; then
    LAUNCHER="$ZOCIETY_ROOT/bin/zociety"
fi
cd "$ROOT"
# Keep host credentials, shell startup hooks, debug flags, and repo shims out
# of the launcher. HOME is needed only for Podman's existing machine config.
exec /usr/bin/env -i HOME="$HOME" \
    PATH=/opt/local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin \
    "$LAUNCHER" exec /usr/bin/python3 -I bin/zci-secrets-provision-container
