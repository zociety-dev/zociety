#!/bin/bash
# Provision the five approved GitLab CI credentials from a short-lived,
# operator-controlled staging directory. Run only after an external git diff
# has pinned this file and bin/zci-secrets to a reviewed commit.

set -euo pipefail
set +x
umask 077

ROOT=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P)
ZCI_SECRETS="$ROOT/bin/zci-secrets"
SIGNING_IDENTITY=agent@zociety.dev
REPORT="$ROOT/.zociety/ci-secrets-provisioned.json"
secret_stage=
PYTHON=
GPG=
GPGCONF=

fail() {
  printf 'zci-secrets-provision: %s\n' "$1" >&2
  return 2
}

select_tool() {
  local variable=$1
  shift
  local candidate
  for candidate in "$@"; do
    if [[ -x "$candidate" ]]; then
      printf -v "$variable" '%s' "$candidate"
      return 0
    fi
  done
  fail "required-tool-unavailable"
}

select_tools() {
  # Deliberately do not consult PATH: this checkout contains command shims and
  # the operator's interactive PATH is not part of the reviewed boundary.
  select_tool PYTHON \
    /opt/local/bin/python3 /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 /usr/bin/python3 || return
  select_tool GPG \
    /opt/local/bin/gpg /opt/homebrew/bin/gpg \
    /usr/local/bin/gpg /usr/bin/gpg || return
  select_tool GPGCONF \
    /opt/local/bin/gpgconf /opt/homebrew/bin/gpgconf \
    /usr/local/bin/gpgconf /usr/bin/gpgconf || return
}

preflight() {
  [[ -f "$ZCI_SECRETS" ]] || {
    fail "transfer-command-unavailable"
    return
  }
  "$PYTHON" -I -c \
    'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
    >/dev/null 2>&1 \
    || {
      fail "python-3.9-required"
      return
    }
  "$PYTHON" -I "$ZCI_SECRETS" --help >/dev/null 2>&1 \
    || {
      fail "transfer-command-import-failed"
      return
    }
  "$GPG" --list-secret-keys "$SIGNING_IDENTITY" >/dev/null 2>&1 \
    || {
      fail "signing-key-unavailable"
      return
    }
  "$GPGCONF" --version >/dev/null 2>&1 \
    || {
      fail "gpg-agent-control-unavailable"
      return
    }
}

create_secret_stage() {
  secret_stage=$(
    "$PYTHON" -I -c \
      'import tempfile; print(tempfile.mkdtemp(prefix="zociety-secrets-"))'
  ) || {
    fail "temporary-directory-unavailable"
    return
  }
  [[ -n "$secret_stage" && -d "$secret_stage" ]] \
    || {
      fail "temporary-directory-unavailable"
      return
    }
}

remove_secret_stage() {
  [[ -n "${secret_stage:-}" ]] || return 0
  "$PYTHON" -I -c '
import os
import shutil
import sys
import tempfile

path = os.path.realpath(sys.argv[1])
temporary = os.path.realpath(tempfile.gettempdir())
valid = os.path.dirname(path) == temporary and os.path.basename(path).startswith("zociety-secrets-")
if not valid:
    raise SystemExit(2)
shutil.rmtree(path, ignore_errors=True)
' "$secret_stage" >/dev/null 2>&1 || true
  secret_stage=
}

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  remove_secret_stage
  # Reloading flushes gpg-agent's cached passphrases after the export window.
  [[ -n "${GPGCONF:-}" ]] \
    && "$GPGCONF" --reload gpg-agent >/dev/null 2>&1 || true
  return "$status"
}

stage_secret() {
  local prompt=$1
  local filename=$2
  local prefix=$3
  local secret_value

  printf '%s' "$prompt" >&2
  IFS= read -r -s secret_value || {
    printf '\n' >&2
    fail "input-unavailable"
    return
  }
  printf '\n' >&2
  [[ -n "$secret_value" ]] || {
    unset secret_value
    fail "empty-input"
    return
  }
  case "$prefix:$secret_value" in
    gitlab:glpat-*) ;;
    claude:sk-ant-oat*) ;;
    github:ghp_*|github:github_pat_*) ;;
    blind:*) ;;
    *)
      unset secret_value
      fail "unexpected-credential-prefix"
      return
      ;;
  esac
  [[ ${#secret_value} -ge 8 && "$secret_value" != *[[:space:]]* ]] || {
    unset secret_value
    fail "input-not-maskable"
    return
  }
  printf '%s' "$secret_value" > "$secret_stage/$filename"
  /bin/chmod 600 "$secret_stage/$filename"
  unset secret_value
}

export_signing_key() {
  "$GPG" --export-secret-keys --armor "$SIGNING_IDENTITY" \
    > "$secret_stage/gpg_signing_key.asc" \
    || {
      fail "signing-key-export-failed"
      return
    }
  [[ -s "$secret_stage/gpg_signing_key.asc" ]] \
    || {
      fail "signing-key-export-empty"
      return
    }
  /bin/chmod 600 "$secret_stage/gpg_signing_key.asc"
}

run_transfer() {
  "$PYTHON" -I "$ZCI_SECRETS" --set \
    --source-dir "$secret_stage" \
    --report "$REPORT"
}

main() {
  select_tools
  preflight
  create_secret_stage
  trap cleanup EXIT
  trap 'exit 130' HUP INT TERM

  stage_secret 'GitLab service-account token: ' gitlab_token gitlab
  stage_secret 'Claude OAuth token: ' claude_oauth_token claude
  stage_secret 'Blind passphrase: ' blind_key blind
  stage_secret 'GitHub mirror token: ' github_token github
  export_signing_key
  run_transfer
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
