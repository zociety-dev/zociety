#!/usr/bin/env bash
# zagent - Extensible client-agnostic agent runner for Zociety
#
# Usage:
#   bin/zagent [options] "<prompt>"
#
# Options:
#   -c, --client CLIENT    Specify AI CLI client: claude or gemini (default: $ZOCIETY_AGENT_CLIENT or claude)
#   -m, --model MODEL      Specify the LLM model to use (default: $ANTHROPIC_MODEL
#                          for claude, $GEMINI_MODEL for gemini; else the
#                          client's own default)
#   -r, --render MODE      Output rendering: text (default; the client's
#                          buffered result), compact (stream-json rendered
#                          live by bin/zrender: tool lines and a cost footer
#                          on stderr, result text on stdout), or raw
#                          (stream-json passthrough incl. partial messages)
#   -v, --verbose          Same as --render raw
#   -h, --help             Show this help
#
# Environment:
#   ZOCIETY_AGENT_CLIENT   Defaults to "claude" if not specified.
#   ANTHROPIC_MODEL        Default model for claude (passed as --model).
#   GEMINI_MODEL           Default model for gemini (passed as -m).
#
# The model reaches the client as a CLI flag only. The child runs with
# ANTHROPIC_MODEL, GEMINI_MODEL, MODEL (the CI step variable bin/zga-loop
# inherits), ZOCIETY_AGENT_CLIENT and ZOCIETY_BLIND_KEY removed from its
# environment (env -u), so the agent's shell cannot read which model it is,
# which client, or the key that seals the record. The loop records the model
# per turn with bin/zblind; see
# docs/challenges/cross-agent-deference.md.
#
# compact is claude-only: bin/zrender reads claude's event schema. For gemini
# it falls back to text with a note on stderr.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLIENT="${ZOCIETY_AGENT_CLIENT:-claude}"
MODEL=""
RENDER="text"
PROMPT=""

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -c|--client)
      [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; exit 2; }
      CLIENT="$2"
      shift
      ;;
    -m|--model)
      [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; exit 2; }
      MODEL="$2"
      shift
      ;;
    -r|--render)
      [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; exit 2; }
      case "$2" in
        text|compact|raw) RENDER="$2" ;;
        *) echo "Error: --render expects text, compact or raw, got '$2'" >&2; exit 2 ;;
      esac
      shift
      ;;
    -v|--verbose)
      RENDER="raw"
      ;;
    -*)
      echo "Error: Unknown option '$1'" >&2
      exit 2
      ;;
    *)
      if [[ -n "$PROMPT" ]]; then
        echo "Error: Multiple prompts provided ('$PROMPT' and '$1')" >&2
        exit 2
      fi
      PROMPT="$1"
      ;;
  esac
  shift
done

if [[ -z "$PROMPT" ]]; then
  echo "Error: No prompt provided." >&2
  usage
  exit 2
fi

# Model: the flag, else the client's env default. Captured here and handed
# over as a flag; the variables themselves never reach the child (see header).
if [[ -z "$MODEL" ]]; then
  case "$CLIENT" in
    claude) MODEL="${ANTHROPIC_MODEL:-}" ;;
    gemini) MODEL="${GEMINI_MODEL:-}" ;;
  esac
fi
SCRUB=(env -u ANTHROPIC_MODEL -u GEMINI_MODEL -u MODEL -u ZOCIETY_AGENT_CLIENT -u ZOCIETY_BLIND_KEY)

case "$CLIENT" in
  claude)
    CLAUDE_ARGS=(
      --print
      --dangerously-skip-permissions
      --strict-mcp-config
      --no-session-persistence
    )
    if [[ -n "$MODEL" ]]; then
      CLAUDE_ARGS+=(--model "$MODEL")
    fi
    # --print needs --verbose for stream-json output. raw adds the partial
    # (delta) messages; compact leaves them out and pipes through bin/zrender.
    case "$RENDER" in
      raw)     CLAUDE_ARGS+=(--verbose --output-format stream-json --include-partial-messages) ;;
      compact) CLAUDE_ARGS+=(--verbose --output-format stream-json) ;;
    esac
    CLAUDE_ARGS+=("$PROMPT")

    if [[ "$RENDER" == "compact" ]]; then
      # pipefail: the pipeline fails when claude fails. `&& exit 0` keeps
      # errexit out of the way so claude's own status (PIPESTATUS[0]), not the
      # rightmost non-zero one, is what the caller sees.
      "${SCRUB[@]}" claude "${CLAUDE_ARGS[@]}" | "$SCRIPT_DIR/zrender" && exit 0
      exit "${PIPESTATUS[0]}"
    fi
    exec "${SCRUB[@]}" claude "${CLAUDE_ARGS[@]}"
    ;;

  gemini)
    GEMINI_ARGS=(
      -p "$PROMPT"
      -y
      --skip-trust
    )
    if [[ -n "$MODEL" ]]; then
      GEMINI_ARGS+=(-m "$MODEL")
    fi
    case "$RENDER" in
      raw)
        # Gemini's streaming output mode is stream-json
        GEMINI_ARGS+=(-o stream-json)
        ;;
      compact)
        echo "zagent: --render compact is claude-only; running gemini with text output" >&2
        ;;
    esac

    exec "${SCRUB[@]}" gemini "${GEMINI_ARGS[@]}"
    ;;

  *)
    echo "Error: Unknown agent client: $CLIENT" >&2
    exit 2
    ;;
esac
