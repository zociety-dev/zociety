#!/bin/bash
# zheap-death: Archive the current cycle and prepare the next one
#
# Usage:
#   bin/zheap-death [--done] (--cite FILE | --challenge FILE)... --learning TEXT <agent> <question> [batch_size]
#   bin/zheap-death --finish
#   bin/zheap-death -h | --help
#
# Options:
#   --cite FILE, --challenge FILE
#                Required, at least one: a file under stuff/ (a stuff/
#                prefix is dropped) the next cycle explicitly inherits or
#                disputes. Recorded as data.inheritance in the heap-death
#                and direction events; bin/zcycle-measure scores it.
#   --done       Set "done": true in the heap-death event data. The agent is
#                saying the hypothesis is settled; bin/zstop-feedback stops
#                the loop on it. Flags go before positional arguments.
#   --finish     Alone. Finish a heap-death whose [direction] commit was
#                refused (a hook, say) after the archive: the cycle branch's
#                newest [heap-death] or [direction] on its first-parent line
#                is a [heap-death] naming another branch, so this branch is
#                the successor with its direction unwritten, bin/zstate
#                answering "promise" and the per-cycle deletions staged.
#                Rewrites the direction from that event's data (question,
#                batch, inheritance, regime) and clears the per-cycle files;
#                exit 0 and silent when there is nothing to finish. bin/zloop
#                runs it before every turn; a plain heap-death refuses while
#                one is pending.
#   --learning TEXT
#                Required. One finding from this cycle that should change
#                what the next cycle does: a claim its stuff/ supports, not
#                a summary of what was made (at most 500 characters). Stored
#                as data.learning in the heap-death event and appended to
#                the learnings branch; bin/zprompt shows the latest to every
#                turn and the last three to the next heap-death turn. The
#                question carries the cycle's direction forward; the
#                learning carries what it found.
#
# Arguments:
#   agent        Name of the agent recording the heap-death (e.g. sonnet)
#   question     Direction for the next cycle. Becomes the tag message and
#                the [direction] event the next cycle reads.
#   batch_size   Cycles left in this batch, counting this one, recorded as
#                batch_remaining = batch_size - 1 in the heap-death and
#                direction events. A record, not a switch: bin/zstop-budget
#                counts [heap-death] commits, and the direction is written
#                whatever the value (see step 8).
#                Default: when the loop runs in budget mode (mode: in
#                .claude/zloop.state contains "budget", or ZSTOP_BUDGET is
#                set) and start: resolves, ZSTOP_BUDGET (default 3) minus the
#                [heap-death] commits in start..HEAD, floored at 1, so the
#                event agrees with bin/zstop-budget. Otherwise 3.
#
# Environment:
#   ZSTOP_BUDGET=3       Heap-deaths per loop run; drives the batch_size default
#   ZSTOP_*              Every ZSTOP_* variable present is recorded under
#                        data.zstop in the heap-death and direction events
#   ZAGENT_*             Every ZAGENT_* variable present (bin/zagent: TOOLS,
#                        SETTING_SOURCES, EFFORT) the same way, under
#                        data.zagent; none present means bin/zagent's
#                        defaults (its header), so a change of default is a
#                        change of regime to note there
#
# Regime record: mode: from .claude/zloop.state is written as data.stop_mode
# to the heap-death and direction events and appended to the tag message as
# " stop=<list>". Without the state file no stop_mode key or tag suffix.
#
# What it does, in order:
#   1. Names the cycle that just ended via bin/zcycle-id current: the branch
#      name when on cycle/rev{N}-attempt{M} (identity derived at birth by
#      bin/zloop), otherwise the last tag with rev bumped if PROMPT.md
#      changed since it, else attempt bumped. On a cycle branch also names
#      the successor (bin/zcycle-id next) and refuses, before anything is
#      written, if that branch already exists.
#   2. Records a [heap-death] event commit via bin/zevent.
#   3. Appends the learning to the learnings branch (bin/save-learning) under
#      the cycle id, after the commit: a heap-death whose commit fails has
#      written nothing, so its retry writes the block once. A failed save
#      warns and carries on: the event keeps the learning.
#   4. Creates branch cycle/rev{N}-attempt{N} at HEAD (no-op when already on
#      it), tag rev{N}-attempt{N}-iterations{I}ofx (I: the cycle's turns
#      that wrote an event; AGENTS.md, Tags), and a git note on HEAD.
#   5. Pushes HEAD, tag, branch, notes and the learnings branch to origin if
#      a remote exists, and lands the cycle on main: bin/zpr-flow opens the
#      cycle branch's PR and merges it with a merge commit (ZPR_MERGE=0 opens
#      it only). A cycle that did not land leaves its PR open and asks GitHub
#      to rebuild zociety.dev (gh workflow run pages.yml); a merge pushes
#      main, which rebuilds it anyway. bin/zloop then merges main into the
#      successor branch between turns (ZLOOP_SYNC_MAIN).
#   6. git rm's per-cycle files: stuff/, artifacts/, members.txt, rules.txt,
#      REGISTRY.md, LAWS.md, .batch, DIRECTION.md; removes the untracked
#      (gitignored) .claude/zloop.state.
#   7. Death births the successor: when on a cycle branch, checks out
#      cycle/$(bin/zcycle-id next) (attempt+1) so everything after this
#      point, the [direction] event included, lands on the next cycle's
#      branch and the archived branch stays at the tag. On any other branch
#      (main in CI, a feature branch) it stays put, as before.
#   8. Commits a [direction] event for the next cycle, always. The commit
#      also carries step 6's staged deletions, so the successor starts on a
#      clean tree. Before cycle 49 a spent batch (batch_size 1, which every
#      --cycles N run reaches on its last heap-death) wrote no direction:
#      the successor's tip stayed the heap-death, bin/zstate answered
#      action "promise", and the next run took no turn until an operator
#      wrote the direction by hand. A cycle whose batch is spent still has
#      a question; whether another cycle runs is the run's decision
#      (bin/zstop-budget), not the archive's. A refused direction commit
#      leaves that same state; --finish (above) completes it.
#
# Run this when bin/zstate reports action "heap-death".

set -e

# Tag, branch, notes, pushes and the PR must reach the container on the host,
# whatever PATH the calling turn's shell ended up with (bin/zroute.sh).
# shellcheck source=bin/zroute.sh
. bin/zroute.sh

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

# unfinished_heap_death: the sha of a [heap-death] whose successor direction
# this branch still owes (see --finish), or exit 1. The newest [heap-death]
# or [direction] on the first-parent line (main's merges are second parents)
# is a heap-death that names another branch: its own branch is the archive,
# at the tag; this one is the successor born at it, with no [direction] yet.
unfinished_heap_death() {
  local line sha subject hd_branch
  line=$(git log -1 --first-parent --format='%H%x09%s' \
    --grep='^\[heap-death\]' --grep='^\[direction\]' HEAD 2>/dev/null) || return 1
  [[ -n "$line" ]] || return 1
  sha="${line%%$'\t'*}"
  subject="${line#*$'\t'}"
  [[ "$subject" == "[heap-death]"* ]] || return 1
  hd_branch=$(git log -1 --format=%b "$sha" | jq -r '.data.branch // empty' 2>/dev/null)
  [[ -n "$hd_branch" && "$hd_branch" != "$CURRENT_BRANCH" ]] || return 1
  echo "$sha"
}

# clear_cycle_files: step 7, idempotent (a rerun finds some already gone).
clear_cycle_files() {
  local f d
  for f in members.txt rules.txt REGISTRY.md LAWS.md .batch DIRECTION.md; do
    [[ -f "$f" ]] && git rm -f "$f" --quiet
  done
  for d in stuff artifacts; do
    [[ -d "$d" ]] && git rm -rf "$d" --quiet
  done
  # State directories are gitignored, so the state files are never tracked
  # and `git rm` would be a no-op. Plain rm: bin/zloop rewrites it on its
  # next iteration.
  rm -f .zociety/zloop.state .claude/zloop.state
  return 0
}

# commit_direction: step 8, from QUESTION, BATCH_SIZE, REMAINING,
# INHERITANCE, REGIME and CURRENT_CYCLE. The commit carries whatever
# clear_cycle_files staged.
commit_direction() {
  local next_cycle direction_event direction_msg
  next_cycle=$((CURRENT_CYCLE + 1))

  bin/zlog zheap-death "Creating direction event for next cycle" \
    "$(jq -n --argjson next "$next_cycle" --argjson remaining "$REMAINING" \
      '{next_cycle: $next, batch_remaining: $remaining}')" 2>/dev/null || true

  direction_event=$(jq -n \
    --arg type "direction" \
    --arg agent "system" \
    --argjson cycle "$next_cycle" \
    --argjson seq 1 \
    --arg question "$QUESTION" \
    --argjson total "$BATCH_SIZE" \
    --argjson remaining "$REMAINING" \
    --argjson inheritance "$INHERITANCE" \
    --argjson regime "$REGIME" \
    '{
      z: 1,
      event: $type,
      cycle: $cycle,
      seq: $seq,
      agent: $agent,
      ts: (now | todate),
      state: {
        members: 0,
        rules: 0,
        stuff: 0,
        complete: false
      },
      data: ({
        question: $question,
        batch_total: $total,
        batch_remaining: $remaining,
        inheritance: $inheritance
      } + $regime)
    }'
  )

  direction_msg="[direction] system: $QUESTION

$direction_event"

  git commit --allow-empty -m "$direction_msg" --quiet
  echo "Direction event committed for cycle $next_cycle"
}

DONE=false
FINISH=false
LEARNING=""
POSITIONAL=()
CITES=()
CHALLENGES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --done)
      DONE=true
      ;;
    --finish)
      FINISH=true
      ;;
    --learning)
      [[ $# -ge 2 ]] || { echo "zheap-death: --learning requires the finding" >&2; exit 1; }
      LEARNING="$2"
      shift
      ;;
    --cite|--challenge)
      [[ $# -ge 2 ]] || { echo "zheap-death: $1 requires a stuff/ file" >&2; exit 1; }
      # Named relative to stuff/; a stuff/ prefix is accepted and dropped
      # (a live turn passed stuff/allowed-signers.md and spent 15s on the
      # refusal).
      if [[ "$1" == "--cite" ]]; then CITES+=("${2#stuff/}"); else CHALLENGES+=("${2#stuff/}"); fi
      shift
      ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    -*)
      echo "zheap-death: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      POSITIONAL+=("$1")
      ;;
  esac
  shift
done
set -- "${POSITIONAL[@]}"

AGENT="${1:-}"
QUESTION="${2:-}"
BATCH_SIZE="${3:-}"

if [[ "$FINISH" == true ]]; then
  if [[ $# -gt 0 || "$DONE" == true || -n "$LEARNING" || ${#CITES[@]} -gt 0 || ${#CHALLENGES[@]} -gt 0 ]]; then
    echo "zheap-death: --finish takes no other argument; the direction comes from the heap-death event" >&2
    exit 1
  fi
elif [[ -z "$AGENT" || -z "$QUESTION" ]]; then
  usage >&2
  exit 1
fi

# Archive only a named cycle branch. There is deliberately no override: every
# lifecycle write must remain in the reviewable cycle lineage.
CURRENT_BRANCH=$(git branch --show-current)
ON_CYCLE_BRANCH=0
[[ "$CURRENT_BRANCH" =~ ^cycle/rev[0-9]+-attempt[0-9]+$ ]] && ON_CYCLE_BRANCH=1
if [[ "$ON_CYCLE_BRANCH" -eq 0 ]]; then
  echo "zheap-death: refusing to run on '${CURRENT_BRANCH:-detached HEAD}'; run from cycle/rev{N}-attempt{M}" >&2
  exit 1
fi

#############################################
# --finish: a direction the archive still owes
#############################################

if [[ "$FINISH" == true ]]; then
  HD=$(unfinished_heap_death) || exit 0
  HD_BODY=$(git log -1 --format=%b "$HD")
  QUESTION=$(jq -r '.data.question // empty' <<<"$HD_BODY")
  if [[ -z "$QUESTION" ]]; then
    echo "zheap-death --finish: ${HD:0:7} carries no question; write the [direction] by hand" >&2
    exit 1
  fi
  REMAINING=$(jq -r '.data.batch_remaining // 0' <<<"$HD_BODY")
  [[ "$REMAINING" =~ ^[0-9]+$ ]] || REMAINING=0
  BATCH_SIZE=$((REMAINING + 1))
  INHERITANCE=$(jq -c '.data.inheritance // {"cite":[],"challenge":[]}' <<<"$HD_BODY")
  REGIME=$(jq -c '.data | {stop_mode, zstop} | with_entries(select(.value != null))' <<<"$HD_BODY")
  CURRENT_CYCLE=$(jq -r '.cycle // 0' <<<"$HD_BODY")
  echo "Finishing heap-death ${HD:0:7} ($(jq -r '.data.branch' <<<"$HD_BODY")): its [direction] was not written"
  clear_cycle_files
  commit_direction
  exit 0
fi

if HD=$(unfinished_heap_death); then
  echo "zheap-death: the last heap-death (${HD:0:7}) has no [direction] on $CURRENT_BRANCH; run bin/zheap-death --finish first" >&2
  exit 1
fi

#############################################
# 0. Read the loop regime from zloop.state
#############################################
#
# Step 7 removes the state file, so read it here, before anything else.

if [[ -f .zociety/zloop.state ]]; then
  STATE_FILE=.zociety/zloop.state
else
  STATE_FILE=.claude/zloop.state
fi
LOOP_START=""
STOP_MODE=""
if [[ -f "$STATE_FILE" ]]; then
  LOOP_START=$(grep '^start:' "$STATE_FILE" | cut -d: -f2 | tr -d ' ' || true)
  STOP_MODE=$(grep '^mode:' "$STATE_FILE" | cut -d: -f2- | tr -d ' ' || true)
fi

if [[ -n "${ZSTOP_BUDGET:-}" ]] && ! [[ "$ZSTOP_BUDGET" =~ ^[0-9]+$ ]]; then
  echo "zheap-death: ZSTOP_BUDGET must be a non-negative integer, got '$ZSTOP_BUDGET'" >&2
  exit 1
fi

# Default batch_size from the budget so the event data agrees with the loop:
# what is left of ZSTOP_BUDGET after the heap-deaths already in start..HEAD,
# counting this one. Floored at 1. Budget mode means
# the mode list names budget, or ZSTOP_BUDGET is exported (a by-hand run
# outside bin/zloop that still wants the budget arithmetic).
BUDGET_MODE=0
[[ ",$STOP_MODE," == *,budget,* || -n "${ZSTOP_BUDGET:-}" ]] && BUDGET_MODE=1

if [[ -z "$BATCH_SIZE" ]]; then
  if [[ "$BUDGET_MODE" -eq 1 && -n "$LOOP_START" ]] \
    && git rev-parse --verify -q "${LOOP_START}^{commit}" >/dev/null 2>&1; then
    BUDGET="${ZSTOP_BUDGET:-3}"
    # First parents only: the cycle branch's own line. The merges bin/zloop
    # makes from main bring in history no turn of this run wrote.
    SO_FAR=$(git rev-list --count --first-parent --grep='^\[heap-death\]' "${LOOP_START}..HEAD")
    BATCH_SIZE=$((BUDGET - SO_FAR))
    [[ "$BATCH_SIZE" -lt 1 ]] && BATCH_SIZE=1
    echo "batch_size defaulted to $BATCH_SIZE (budget=$BUDGET, $SO_FAR heap-deaths since ${LOOP_START:0:7})" >&2
  else
    BATCH_SIZE=3
  fi
fi

if ! [[ "$BATCH_SIZE" =~ ^[1-9][0-9]*$ ]]; then
  echo "zheap-death: batch_size counts this cycle, so it is at least 1; got '$BATCH_SIZE'" >&2
  exit 1
fi

# A successor must explicitly inherit from, or challenge, something the
# current cycle made. This gate is intentionally before any lifecycle write.
# There is always a successor (step 8), so the batch does not excuse it: the
# gate used to skip at batch_size 1, and cycle 48's heap-death, the last of a
# --cycles 1 run, landed with inheritance null.
if [[ ${#CITES[@]} -eq 0 && ${#CHALLENGES[@]} -eq 0 ]]; then
  echo "zheap-death: successor direction requires --cite FILE or --challenge FILE from this cycle's stuff/" >&2
  exit 1
fi
for artifact in "${CITES[@]}" "${CHALLENGES[@]}"; do
  [[ "$artifact" != /* && -f "stuff/$artifact" ]] || {
    echo "zheap-death: inheritance artifact must be a file under stuff/: '$artifact'" >&2
    exit 1
  }
done
# The learning is what the cycle found, as against the question, which is
# where the next one goes. Before this flag nothing carried it: the learnings
# branch only took PROMPT.md diff lines, and PROMPT.md has not changed since
# rev66, so it last grew in January 2026. Required, and gated before any
# write.
LEARNING="${LEARNING#"${LEARNING%%[![:space:]]*}"}"
LEARNING="${LEARNING%"${LEARNING##*[![:space:]]}"}"
if [[ -z "$LEARNING" ]]; then
  echo "zheap-death: --learning TEXT is required: one finding from this cycle that should change what the next cycle does" >&2
  exit 1
fi
if [[ ${#LEARNING} -gt 500 ]]; then
  echo "zheap-death: --learning is ${#LEARNING} characters; keep it to one finding of at most 500" >&2
  exit 1
fi

INHERITANCE='{"cite":[],"challenge":[]}'
for artifact in "${CITES[@]}"; do
  INHERITANCE=$(jq -c --arg artifact "$artifact" '.cite += [$artifact]' <<<"$INHERITANCE")
done
for artifact in "${CHALLENGES[@]}"; do
  INHERITANCE=$(jq -c --arg artifact "$artifact" '.challenge += [$artifact]' <<<"$INHERITANCE")
done

# Every ZSTOP_* variable present, as {"BUDGET": "3", ...}, and every
# ZAGENT_* one (the turn's tools, settings and effort; bin/zagent) the same
# way, so a cycle's turn regime is in git beside its stop regime.
KNOBS_JSON='{}'
for v in $(compgen -v ZSTOP_ || true); do
  KNOBS_JSON=$(jq -nc --argjson o "$KNOBS_JSON" --arg k "${v#ZSTOP_}" --arg val "${!v}" \
    '$o + {($k): $val}')
done
AGENT_KNOBS_JSON='{}'
for v in $(compgen -v ZAGENT_ || true); do
  AGENT_KNOBS_JSON=$(jq -nc --argjson o "$AGENT_KNOBS_JSON" --arg k "${v#ZAGENT_}" --arg val "${!v}" \
    '$o + {($k): $val}')
done

# Regime fields merged into both event payloads. Empty object when there is
# no zloop.state mode and no ZSTOP_* or ZAGENT_* variables.
REGIME=$(jq -nc --arg mode "$STOP_MODE" --argjson zstop "$KNOBS_JSON" --argjson zagent "$AGENT_KNOBS_JSON" \
  '(if $mode != "" then {stop_mode: $mode} else {} end)
   + (if ($zstop | length) > 0 then {zstop: $zstop} else {} end)
   + (if ($zagent | length) > 0 then {zagent: $zagent} else {} end)')

bin/zlog zheap-death "Starting heap-death" \
  "$(jq -n --arg agent "$AGENT" --arg q "$QUESTION" --argjson batch "$BATCH_SIZE" \
    '{agent: $agent, question: $q, batch_size: $batch}')" 2>/dev/null || true

# Remember our starting branch
ORIGINAL_BRANCH=$(git branch --show-current)

#############################################
# 1. Name the cycle that just ended
#############################################
#
# bin/zcycle-id current: the branch name on a cycle branch, else derived from
# the last tag (rev bump if PROMPT.md changed since it, attempt bump if not).

CYCLE_ID=$(bin/zcycle-id current)
[[ "$CYCLE_ID" =~ ^rev([0-9]+)-attempt([0-9]+)$ ]] \
  || { echo "zheap-death: bin/zcycle-id returned '$CYCLE_ID'" >&2; exit 1; }
REV="${BASH_REMATCH[1]}"
ATTEMPT="${BASH_REMATCH[2]}"

# On a cycle branch death births the successor (step 7b). Name it now and
# refuse while nothing has been written: failing after the event commit, tag
# and pushes would leave a half-archived cycle with staged deletions.
NEXT_BRANCH=""
if [[ "$ON_CYCLE_BRANCH" -eq 1 ]]; then
  NEXT_BRANCH=$(bin/zcycle-id --branch next)
  if git show-ref --verify --quiet "refs/heads/$NEXT_BRANCH"; then
    echo "zheap-death: successor branch $NEXT_BRANCH already exists; check it out or delete it, then rerun" >&2
    exit 1
  fi
fi

# The tag's I: the turns of this cycle that wrote an event (see AGENTS.md,
# Tags). First parents only, as above: the previous tag and the turn ids
# are the cycle branch's own, not a lineage merged in from main. A body
# that is not one JSON line is skipped, never a partial count.
PREV_TAG=$(git describe --tags --abbrev=0 --first-parent --match 'rev*-attempt*' HEAD 2>/dev/null || true)
TURN_IDS=$(git log --first-parent --format=%b ${PREV_TAG:+"$PREV_TAG.."}HEAD \
  | grep '^{"z":1' | jq -R -r 'fromjson? | .runtime.session // empty' | sort -u) || true
ITERATIONS=$(printf '%s\n' "$TURN_IDS" | grep -c . || true)
if [[ -n "${ZOCIETY_TURN_ID:-}" ]] && ! printf '%s\n' "$TURN_IDS" | grep -qxF "$ZOCIETY_TURN_ID"; then
  ITERATIONS=$((ITERATIONS + 1))
fi
MAX_ITER="x"  # a per-cycle count beside a per-run cap would mix units

TAG="rev${REV}-attempt${ATTEMPT}-iterations${ITERATIONS}of${MAX_ITER}"
CYCLE_BRANCH="cycle/rev${REV}-attempt${ATTEMPT}"

echo "╔════════════════════════════════════════╗"
echo "║           HEAP DEATH                   ║"
echo "╠════════════════════════════════════════╣"
echo "║ Tag:      $TAG"
echo "║ Branch:   $CYCLE_BRANCH"
echo "║ Question: ${QUESTION:0:40}..."
echo "╚════════════════════════════════════════╝"
echo ""

#############################################
# 2. Calculate remaining batch
#############################################

REMAINING=$((BATCH_SIZE - 1))

bin/zlog zheap-death "Calculated batch remaining: $REMAINING (from $BATCH_SIZE - 1)" \
  "$(jq -n --argjson batch "$BATCH_SIZE" --argjson remaining "$REMAINING" \
    '{batch_size: $batch, remaining: $remaining}')" 2>/dev/null || true

# Get current cycle from state. The measures are a record beside the event,
# not a condition of it: a cycle bin/zcycle-measure cannot score (it exits 2
# and says why) is archived with an empty measures object and a WARNING.
CURRENT_CYCLE=$(bin/zstate | jq -r '.cycle // 0')
if ! MEASURES=$(bin/zcycle-measure "$CURRENT_CYCLE"); then
  echo "zheap-death: WARNING: cycle $CURRENT_CYCLE not measured (see above); archiving with measures {}" >&2
  MEASURES='{}'
fi

#############################################
# 3. Commit heap-death event
#############################################

DATA=$(jq -nc \
  --arg tag "$TAG" \
  --arg branch "$CYCLE_BRANCH" \
  --arg question "$QUESTION" \
  --arg learning "$LEARNING" \
  --argjson remaining "$REMAINING" \
  --argjson is_done "$DONE" \
  --argjson measures "$MEASURES" \
  --argjson inheritance "$INHERITANCE" \
  --argjson regime "$REGIME" \
  '{
    tag: $tag,
    branch: $branch,
    question: $question,
    learning: $learning,
    batch_remaining: $remaining,
    done: $is_done,
    measures: $measures,
    inheritance: $inheritance
  } + $regime')

echo "Recording heap-death event..."
bin/zevent heap-death "$AGENT" "$QUESTION" "$DATA"

#############################################
# 4. Save the learning to the orphan branch
#############################################
#
# After the event commit, never before: a commit refused by a hook (cycle
# 44's heap-death failed twice in pre-commit) used to leave the block on the
# branch, and each retry wrote it again, so the turns rewound the branch by
# hand with update-ref.

echo "Saving learning to learnings branch..."
# stderr stays visible: save-learning prints the git error and the full
# learning when the commit fails. The [heap-death] event above carries it,
# so a failed save loses the branch copy, not the learning.
if ! bin/save-learning "rev${REV}-attempt${ATTEMPT}" "$LEARNING"; then
  echo "WARNING: learnings branch NOT updated; the learning is still in the [heap-death] event (data.learning)" >&2
fi

# save-learning writes the orphan `learnings` branch with plumbing
# (commit-tree + update-ref) and never switches branches. Everything below
# still runs bin/* from the current branch, and `learnings` has no bin/, so
# keep the cheap invariant: die here rather than later with
# "bin/zstate: No such file" if anything moved HEAD since we started.
NOW_BRANCH=$(git branch --show-current)
if [[ "$NOW_BRANCH" != "$ORIGINAL_BRANCH" ]]; then
  echo "ERROR: branch changed during heap-death: started on '$ORIGINAL_BRANCH', now on '${NOW_BRANCH:-detached HEAD}'" >&2
  exit 1
fi

#############################################
# 5. Create cycle branch and tag
#############################################

# A pointer at HEAD, created without switching: HEAD stays where it is (main,
# or the cycle branch itself) for the pushes and the [direction] commit below.
# An existing branch is left where it points.
if [[ "$CURRENT_BRANCH" == "$CYCLE_BRANCH" ]]; then
  echo "On cycle branch: $CYCLE_BRANCH"
elif git show-ref --verify --quiet "refs/heads/$CYCLE_BRANCH"; then
  echo "Cycle branch exists: $CYCLE_BRANCH (left as is)"
else
  echo "Creating cycle branch: $CYCLE_BRANCH"
  git branch "$CYCLE_BRANCH"
fi

echo "Tagging: $TAG"
git tag "$TAG" -m "$QUESTION${STOP_MODE:+ stop=$STOP_MODE}"

# Add git note with cycle metadata
echo "Adding git notes..."
git notes add -f -m "cycle: rev$REV attempt$ATTEMPT
genesis_complete: true
question: $QUESTION
learning: $LEARNING
batch_remaining: $REMAINING" HEAD 2>/dev/null || true

#############################################
# 6. Push to GitHub
#############################################

if git remote get-url origin &>/dev/null; then
  echo "Pushing to GitHub..."
  git push origin HEAD --quiet 2>/dev/null || echo "  (push failed - continuing)"
  git push origin "$TAG" --quiet 2>/dev/null || echo "  (tag push failed)"
  git push origin "$CYCLE_BRANCH" --quiet 2>/dev/null || echo "  (branch push failed)"
  git push origin refs/notes/commits --quiet 2>/dev/null || echo "  (notes push failed)"
  # Nothing else pushes it, and bin/zsite-generate builds docs/learnings.html
  # from origin's copy, which had fallen behind the local branch.
  git push origin learnings --quiet 2>/dev/null || echo "  (learnings push failed)"
fi

#############################################
# 6b. Land the cycle on main
#############################################
#
# Opens cycle branch -> main and merges it with a merge commit (bin/zpr-flow
# explains why never squash or rebase). The PR used to be opened and left:
# ZPR_MERGE was never set, so main stayed at cycle 41 while cycles 42-47 sat
# in six nested PRs. ZPR_MERGE=0 opens it only. Non-fatal: no origin, gh
# unable to reach GitHub, or a refused merge leave the cycle archived and its
# PR open, and the next cycle's PR carries it too. Landed is read from git,
# not from gh: the archived head is on origin's main. gh runs as zociety-dev
# in the container.

LANDED=0
if git remote get-url origin &>/dev/null; then
  echo "Landing $CYCLE_BRANCH on main..."
  ZPR_MERGE="${ZPR_MERGE:-1}" bin/zpr-flow "$CYCLE_BRANCH" main \
    "Cycle rev${REV}-attempt${ATTEMPT}: ${QUESTION:0:60}" \
    || echo "  (zpr-flow skipped/failed - continuing)"
  if git fetch origin main --quiet 2>/dev/null \
    && [[ "$(git rev-list --count refs/remotes/origin/main..HEAD 2>/dev/null || echo 1)" -eq 0 ]]; then
    LANDED=1
    echo "  $CYCLE_BRANCH is on main"
  else
    echo "  $CYCLE_BRANCH is not on main; its PR stays open"
  fi
fi

#############################################
# 6c. Rebuild zociety.dev
#############################################
#
# The site's archive and learnings come from the tag and the learnings branch
# pushed above, but no push here triggers .github/workflows/pages.yml (a push
# to main, or once a day), so a cycle reached the site up to a day late. A
# cycle that landed pushed main, which runs it; for one that did not, ask for
# a build of main now: the github-pages environment deploys from main only.
# Non-fatal, like the PR; an origin gh does not know (a test's local bare
# repo) fails here and nothing else.

if [[ "$LANDED" -eq 0 ]] && git remote get-url origin &>/dev/null; then
  echo "Requesting a zociety.dev rebuild..."
  gh workflow run pages.yml --ref main 2>/dev/null \
    || echo "  (site rebuild not requested - continuing)"
fi

#############################################
# 7. Clear generated files
#############################################

echo "Clearing generated files..."
clear_cycle_files

#############################################
# 7b. Death births the successor (cycle branches only)
#############################################
#
# On a cycle branch the branch name is the identity record, so the next cycle
# needs its own branch before anything is committed for it: the [direction]
# event below and every event of the next cycle land on attempt+1, and the
# archived branch stays at the tag. Unconditional on batch_remaining: with the
# batch exhausted the next loop run would otherwise start on a branch whose
# cycle already died (tag exists) and zheap-death would name it again. Not on
# a cycle branch (main in CI, a feature branch): stay put, as before.

if [[ "$ON_CYCLE_BRANCH" -eq 1 ]]; then
  # NEXT_BRANCH was named and checked for existence in step 1.
  echo "Birthing successor branch: $NEXT_BRANCH"
  git checkout -b "$NEXT_BRANCH" --quiet
fi

#############################################
# 8. Commit direction event for next cycle
#############################################
#
# Always. A spent batch (REMAINING 0) used to skip this, which left the
# successor's tip at the [heap-death]: bin/zstate answered "promise", the
# action and budget predicates stopped the next run before its first turn,
# and step 6's deletions sat staged. The question is the cycle's direction
# whether or not this run takes another cycle; bin/zstop-budget decides that
# by counting [heap-death] commits, not by this event's absence. A commit
# refused here (a hook) leaves the archive done and the direction owed:
# bin/zheap-death --finish writes it, and bin/zloop runs that before every
# turn.

commit_direction

echo ""
echo "╔════════════════════════════════════════╗"
echo "║ Cycle archived. Ready for next.        ║"
echo "╠════════════════════════════════════════╣"
echo "║ Branches: git branch -a | grep cycle/  ║"
echo "║ Learnings: bin/read-learnings          ║"
echo "║ Notes: git notes show                  ║"
echo "║ State: bin/zstate                      ║"
echo "╚════════════════════════════════════════╝"
echo ""
echo "Tags:"
git tag | tail -5
