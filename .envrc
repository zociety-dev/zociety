# direnv config for zociety (https://direnv.net). Run `direnv allow` once.
#
# Puts bin/ on PATH so the z* tools run bare (zstate, zgit, zloop ...).
# The scripts still resolve each other as bin/zstate relative to the cwd,
# so run them from the repo root; PATH only saves typing the prefix.
#
# Personal overrides go in .env (gitignored), plain KEY=VALUE lines, e.g.
#   ZOCIETY_AGENT_CLIENT=gemini
#   GEMINI_API_KEY=your-api-key-here
#   GEMINI_MODEL=gemini-3.5-flash
#   ANTHROPIC_MODEL=claude-sonnet-5
#   ZLOOP_STOP=budget,file
#   ZSTOP_BUDGET=5
#   ZOCIETY_BLIND_KEY=shared-passphrase   # bin/zblind; same value as the CI secret
# Every ZLOOP_*, ZSTOP_*, ZHEAP_DEATH_*, ZOCIETY_AGENT_CLIENT, ANTHROPIC_MODEL,
# GEMINI_*, ZOCIETY_BLIND_KEY and CLAUDECODE set here is forwarded into the
# container by bin/zociety.

PATH_add bin

# Route bare `git`/`gh` through the container wrappers while inside the repo.
# direnv exports env only (shell aliases would not survive), so the routing
# lives in bin/shims/{git,gh}, which delegate to bin/zgit/bin/zgh. They are
# PWD-scoped via ZOCIETY_ROOT: git WRITES and all gh go to zociety-dev in the
# container; read-only git and anything outside the worktree (e.g. the /tmp
# repos the test scripts build) fall through to the real host binary.
# PATH_add prepends, so bin/shims must come after `PATH_add bin` to win.
export ZOCIETY_ROOT="$PWD"
PATH_add bin/shims

dotenv_if_exists .env
