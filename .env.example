# Zociety Environment Configuration Examples
# Copy this file to .env and adjust values.

# Active agent client: claude or gemini
ZOCIETY_AGENT_CLIENT=claude

# Gemini Client API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Claude Client API Configuration (if overriding subscription OAuth token)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Zloop tuning variables
ZLOOP_STOP=action
ZLOOP_TIMEOUT=300
ZLOOP_DEBUG=0
ZLOOP_VERBOSE=0

# Zstop tuning variables
ZSTOP_BUDGET=3
