#!/bin/bash
# Prevent direct commits to main branch
# No direct commits to main. Experimental continuity must never override this
# constraint; work proceeds through a cycle branch and its reviewable PR.

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

if [[ "$BRANCH" == "main" ]]; then
    echo ""
    echo "⛔ Direct commits to main are not allowed!"
    echo ""
    echo "Please use a feature branch:"
    echo "  git checkout -b feature/my-changes"
    echo "  git commit -m 'your message'"
    echo "  git push origin feature/my-changes"
    echo ""
    echo "Create or resume a cycle/rev*-attempt* branch instead."
    echo ""
    exit 1
fi
