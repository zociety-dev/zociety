#!/bin/bash
# Load only the mounted service-account token, including on podman exec.
# Keeping this in a CLI wrapper avoids exporting GitLab credentials to every
# process started by the entrypoint. The real binary has a separate path.
set -euo pipefail

unset GITLAB_TOKEN GITLAB_ACCESS_TOKEN OAUTH_TOKEN
TOKEN_FILE="${ZOCIETY_GITLAB_TOKEN_FILE:-/run/secrets/gitlab_token}"
if [[ -s "$TOKEN_FILE" ]]; then
    GITLAB_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
    export GITLAB_TOKEN
fi
if [[ -z "${GITLAB_TOKEN:-}" ]]; then
    case "${1:-}" in
        --version|version|--help|-h|help|completion|orbit) ;;
        *) echo "glab: $TOKEN_FILE is missing or empty; service-account authentication required" >&2; exit 1 ;;
    esac
fi
export GITLAB_HOST=gitlab.com
export GITLAB_REPO="${GITLAB_REPO:-zociety/zociety}"
export GLAB_PAGER=cat
exec /opt/glab/bin/glab "$@"
