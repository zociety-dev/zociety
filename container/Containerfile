# Containerfile for zociety - full Claude Code environment
# Claude Code runs inside the container, not on host

ARG NODE_IMAGE=docker.io/library/node:26-trixie-slim

# Stage 1: build git from source. Trixie ships git 2.47 and has no backport;
# relative-path worktrees (used for the townhall branch) need >= 2.48 on every
# git that touches the repo. Build deps stay in this stage only (git >= 2.53
# links a Rust library, hence cargo).
FROM ${NODE_IMAGE} AS git-build
ARG GIT_VERSION=2.55.0
RUN printf 'Acquire::http::Pipeline-Depth "0";\nAcquire::Retries "3";\n' \
    > /etc/apt/apt.conf.d/99zociety-no-pipeline
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cargo \
    curl \
    libcurl4-openssl-dev \
    libexpat1-dev \
    libssl-dev \
    xz-utils \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://mirrors.edge.kernel.org/pub/software/scm/git/git-${GIT_VERSION}.tar.xz" \
    | tar -xJ -C /usr/src \
    && cd "/usr/src/git-${GIT_VERSION}" \
    && make -j"$(nproc)" prefix=/usr/local NO_TCLTK=1 NO_GETTEXT=1 NO_PERL=1 INSTALL_SYMLINKS=1 all \
    && make prefix=/usr/local NO_TCLTK=1 NO_GETTEXT=1 NO_PERL=1 INSTALL_SYMLINKS=1 DESTDIR=/out install \
    && /out/usr/local/bin/git --version

# Stage 2: runtime image
FROM ${NODE_IMAGE}

LABEL org.opencontainers.image.title="zociety"
LABEL org.opencontainers.image.description="Fully containerized Claude Code environment for zociety agent loops"

# apt hardening: deb.debian.org's CDN sometimes answers pipelined requests out
# of order, which apt reports as "Hash Sum mismatch" (a tiny metapackage
# arriving as a multi-MB body). Disable pipelining and retry transient fetches.
RUN printf 'Acquire::http::Pipeline-Depth "0";\nAcquire::Retries "3";\n' \
    > /etc/apt/apt.conf.d/99zociety-no-pipeline

# System dependencies (git comes from the git-build stage below; libexpat1 is
# its only runtime library not already pulled in by curl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    libexpat1 \
    ca-certificates \
    openssh-client \
    gnupg \
    coreutils \
    grep \
    sed \
    gawk \
    curl \
    wget \
    jq \
    python3 \
    python3-pip \
    python3-venv \
    pre-commit \
    shellcheck \
    ruby \
    lua5.4 \
    golang-go \
    sqlite3 \
    libsqlite3-dev \
    valkey \
    neovim \
    && rm -rf /var/lib/apt/lists/*

# Install git built in stage 1 (system config lives at /usr/local/etc/gitconfig)
COPY --from=git-build /out/usr/local /usr/local
RUN git --version

# Install yq
RUN curl -fsSL "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_$(dpkg --print-architecture)" -o /usr/local/bin/yq \
    && chmod +x /usr/local/bin/yq \
    && yq --version

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Install Rust via rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && mv /root/.cargo /opt/cargo \
    && mv /root/.rustup /opt/rustup

ENV CARGO_HOME=/opt/cargo
ENV RUSTUP_HOME=/opt/rustup
ENV PATH="$CARGO_HOME/bin:$PATH"

# Install pnpm globally (provides pnpx)
RUN npm install -g pnpm

# Install uv (provides uvx)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/ \
    && mv /root/.local/bin/uvx /usr/local/bin/

# Install gitleaks (secret detection for pre-commit; see .pre-commit-config.yaml)
ARG GITLEAKS_VERSION=8.30.1
RUN case "$(dpkg --print-architecture)" in \
        amd64) gl_arch=x64 ;; \
        arm64) gl_arch=arm64 ;; \
        *) echo "gitleaks: no release for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${gl_arch}.tar.gz" \
    | tar -xz -C /usr/local/bin gitleaks \
    && chmod +x /usr/local/bin/gitleaks \
    && gitleaks version

# Install Claude Code (native binary installer, not npm).
# Install under /opt, NOT /home/agent: that home is a mounted named volume at
# runtime and would shadow a home-dir install. Symlink the launcher onto PATH.
# Auto-update is disabled (read-only rootfs anyway); update via `bin/zociety --rebuild`.
ENV DISABLE_AUTOUPDATER=1
RUN mkdir -p /opt/claude-home \
    && curl -fsSL https://claude.ai/install.sh | HOME=/opt/claude-home bash \
    && ln -sf /opt/claude-home/.local/bin/claude /usr/local/bin/claude \
    && chmod -R a+rX /opt/claude-home \
    && /usr/local/bin/claude --version

# Node image already has 'node' user with UID 1000
# Rename home directory and set up for our use
RUN usermod -d /home/agent -l agent node \
    && groupmod -n agent node \
    && mv /home/node /home/agent \
    && chown -R agent:agent /home/agent

# Git safety for mounted repo
RUN git config --system --add safe.directory /repo

# Set up directories with correct ownership
RUN mkdir -p /home/agent/.claude \
             /home/agent/.claude-plugins \
             /home/agent/.ssh \
             /run/secrets \
    && chown -R agent:agent /home/agent

# Copy and set up entrypoint
COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/

# Working directory
WORKDIR /repo

# Switch to non-root user
USER agent

# Environment
ENV HOME=/home/agent
ENV NODE_ENV=production

# Healthcheck
HEALTHCHECK --interval=60s --timeout=10s --start-period=10s --retries=3 \
    CMD claude --version || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["claude"]
